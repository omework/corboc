                if kind == 21 {
                    c_type(types[node]); { let code: [u8;7] = [32,42,112,108,97,99,101]; byte_text(&code[..]); }
                    number(copy(node)); { let code: [u8;2] = [59,10]; byte_text(&code[..]); }
                }
            } else if kind == 38 { { let code: [u8;15] = [84,97,115,107,86,97,108,117,101,32,97,119,97,105,116]; byte_text(&code[..]); } number(copy(node)); { let code: [u8;2] = [59,10]; byte_text(&code[..]); } }
            else if kind == 2 {
                { let code: [u8;11] = [115,105,122,101,95,116,32,109,97,114,107]; byte_text(&code[..]); } number(copy(node)); { let code: [u8;24] = [59,82,101,103,105,111,110,66,97,110,100,42,32,114,101,103,105,111,110,95,109,97,114,107]; byte_text(&code[..]); } number(copy(node)); { let code: [u8;2] = [59,10]; byte_text(&code[..]); }
