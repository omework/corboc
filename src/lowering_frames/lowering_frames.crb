use bootstrap::model::{AstNode, StaticNode};
use bootstrap::lowering_types::{c_type, local, number, task_payload};
use bootstrap::target_c::{byte_text, character};

fn inside(nodes: &[AstNode], node: u64, function: u64) bool {
    let mut parent = nodes[node].parent;
    while parent != 0 {
        if parent == function { return true; }
        if nodes[parent].kind == 35 || nodes[parent].kind == 1 { return false; }
        parent = nodes[parent].parent;
    }
    false
}

