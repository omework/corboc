    { let code: [u8;19] = [115,116,97,116,105,99,32,118,111,105,100,32,100,105,115,112,111,115,101]; byte_text(&code[..]); } number(function); { let code: [u8;19] = [40,84,97,115,107,83,116,97,116,101,42,44,98,111,111,108,41,59,10]; byte_text(&code[..]); }
