                }
                character(44);
                let mut candidate: u64 = 1;
                let mut allocations: u64 = 0;
                let new_word: [u8; 3] = [110,101,119];
                while candidate < nodes.len() as u64 {
                    if nodes[candidate].kind == 16 && graph[candidate].scope == block
