                        let pool = graph[graph[candidate].first_child].binding;
                        if vector_pool(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                            graph[pool].first_child) {
                            allocations = allocations + 1;
                        }
                    }
                    candidate = candidate + 1;
                }
                number(allocations);
                character(41); character(59); character(10);
            }
        } else if kind == 8 && nodes[expr].kind == 16 {
            let receiver = graph[expr].first_child;
            let binding = graph[receiver].binding;
            let arg = graph[receiver].next_sibling;
            if !owners[binding].region { return 0; }
            let push_str: [u8; 8] = [112,117,115,104,95,115,116,114];
            let pool = owners[binding].pool;
            let pool_expression = graph[pool].first_child;
            let nominal = vector_scalar_struct(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                graph[graph[pool_expression].first_child].first_child);
            if vector_owned_string(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                graph[graph[pool_expression].first_child].first_child) {
                let moved = graph[arg].binding;
                if !owners[moved].region || nodes[moved].parent != block { return 0; }
