                ];
                byte_text(&fill_end[..]);
                number(copy(statement)); character(59); character(10);
            }
        } else if kind == 5 && nodes[expr].kind == 2 {
            if emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], expr, copy(statement), 0, copy(emit)) != 3 { return 0; }
        } else if kind == 5 && nodes[expr].kind == 15 {
            if !emit_region_call(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], copy(statement), expr, copy(emit)) { return 0; }
        } else if kind == 10 && destination != 0 && nodes[expr].kind == 15 && nodes[destination].kind != 1 {
            let function = bootstrap_callee(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(expr));
            if identity_aggregate(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], function) == 0 {
                if !emit_region_call(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut owners[0..owners.len()], copy(destination), expr, copy(emit)) { return 0; }
            } else {
                let origin = graph[graph[graph[expr].first_child].next_sibling].binding;
                if storage_escapes(&nodes[0..nodes.len()], &graph[0..graph.len()], &owners[0..owners.len()], copy(origin), copy(block)) {
                    if inside_loop(&nodes[0..nodes.len()], copy(block)) { return 0; }
                    rewind = false;
                }
                if !transfer_owner(&mut owners[0..owners.len()], origin, copy(destination)) { return 0; }
            }
            outcome = 3;
        } else if (kind == 10 || kind == 6) && nodes[destination].kind == 1 && nodes[expr].kind == 26 {
            let condition = graph[expr].first_child;
            let yes = graph[condition].next_sibling;
            let no = graph[yes].next_sibling;
            if nodes[yes].kind != 2 || nodes[no].kind != 2 { return 0; }
            if emit { character(105); character(102); character(40); }
            if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, condition, true, copy(emit)) { return 0; }
            if emit { character(41); character(123); character(10); }
            if emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], yes, copy(destination), 0, copy(emit)) != 3 { return 0; }
            if emit {
                let otherwise: [u8; 7] = [125,101,108,115,101,123,10];
                byte_text(&otherwise[..]);
            }
            if emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], no, copy(destination), 0, copy(emit)) != 3 { return 0; }
            if emit { character(125); character(10); }
            outcome = 3;
        } else if (kind == 10 || kind == 6) && nodes[destination].kind == 1 {
            let mut binding = graph[expr].binding;
            if nodes[expr].kind == 16 {
                if !emit_owner(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut owners[0..owners.len()], copy(statement), copy(expr), copy(emit)) { return 0; }
                binding = copy(statement);
            } else if nodes[expr].kind != 7 { return 0; }
            if !emit_region_result(&mut owners[0..owners.len()], copy(destination), binding, copy(emit)) { return 0; }
            outcome = 3;
        } else if kind == 10 && destination != 0 && nodes[expr].kind == 16 {
            if !emit_owner(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], copy(destination), expr, copy(emit)) { return 0; }
            if owners[destination].slot == 0 { return 0; }
            if storage_escapes(&nodes[0..nodes.len()], &graph[0..graph.len()],
                &owners[0..owners.len()], copy(destination), copy(block)) {
                if inside_loop(&nodes[0..nodes.len()], copy(block)) { return 0; }
                rewind = false;
            }
            outcome = 3;
        } else if kind == 10 && destination != 0 && nodes[expr].kind == 7 {
            let original = graph[expr].binding;
            if storage_escapes(&nodes[0..nodes.len()], &graph[0..graph.len()],
                &owners[0..owners.len()], copy(original), copy(block)) {
                if inside_loop(&nodes[0..nodes.len()], copy(block)) { return 0; }
                rewind = false;
            }
            if !transfer_owner(&mut owners[0..owners.len()], original, copy(destination)) { return 0; }
            outcome = 3;
        } else if kind == 5 && (nodes[expr].kind == 9 || nodes[expr].kind == 4) {
            let value = if nodes[expr].kind == 4 {
                if !scalar_annotation(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(expr)) { return 0; }
                graph[expr].next_sibling
            } else { copy(expr) };
            if emit {
                let local: [u8; 11] = [108,111,110,103,32,108,111,110,103,32,120];
                byte_text(&local[..]); number(copy(statement)); character(61);
            }
            if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, value, false, copy(emit)) { return 0; }
            if emit {
                let used: [u8; 7] = [40,118,111,105,100,41,120];
                character(59); character(10); byte_text(&used[..]); number(copy(statement)); character(59); character(10);
            }
        } else if kind == 5 {
            if !emit_owner(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], copy(statement), expr, copy(emit)) { return 0; }
        } else if kind == 22 || ((kind == 8 || kind == 10) && nodes[expr].kind == 27) {
            let loop_node = if kind == 22 { copy(statement) } else { copy(expr) };
            let body = if kind == 22 { graph[expr].next_sibling } else { graph[expr].first_child };
            // The checker has already joined state at the back edge. Emission
            // can reuse bindings across iterations if ownership stays local.
            let mut binding = graph[statement].visible;
            while binding != 0 {
                if owners[binding].constructor != 0 { return 0; }
                binding = graph[binding].visible;
            }
            if emit {
                let word: [u8; 6] = [119,104,105,108,101,40];
                byte_text(&word[..]);
            }
            if kind != 22 {
                if emit { character(49); }
            } else if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, expr, true, copy(emit)) { return 0; }
            if emit { character(41); character(123); character(10); }
            let edge = emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], body, 0, loop_node, copy(emit));
            if edge != 1 && edge != 4 && edge != 5 { return 0; }
            if emit { character(125); character(10); }
        } else if kind == 21 && nodes[expr].kind == 7 {
            let binding = graph[expr].binding;
            let operator = nodes[statement].name_start;
            if nodes[statement].name_end - operator != 1 || source[operator] != 61
                || !mutable_local(&source[0..source.len()], &nodes[0..nodes.len()], copy(binding)) { return 0; }
            if emit { character(120); number(copy(binding)); character(61); }
            if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, graph[expr].next_sibling, false, copy(emit)) { return 0; }
            if emit { character(59); character(10); }
        } else if kind == 57 {
            if !transfer_owner(&mut owners[0..owners.len()], graph[statement].binding, copy(statement)) {
                return 0;
            }
        } else if (kind == 8 || kind == 10) && nodes[expr].kind == 2 {
            outcome = emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], expr, 0, 0, copy(emit));
            if outcome == 0 { return 0; }
        } else if (kind == 23 || kind == 24) && loop_node != 0 && expr == 0
            && graph[statement].destination == loop_node {
            outcome = if kind == 23 { 4 } else { 5 };
        } else if (kind == 8 || kind == 10) && nodes[expr].kind == 26 && loop_node != 0 {
            let condition = graph[expr].first_child;
            let arm = graph[condition].next_sibling;
            let edge = graph[arm].first_child;
            let edge_kind = nodes[edge].kind;
            if (edge_kind != 23 && edge_kind != 24) || graph[edge].destination != loop_node
                || graph[edge].first_child != 0 || graph[edge].next_sibling != 0 || graph[arm].next_sibling != 0 {
                return 0;
            }
            if emit { character(105); character(102); character(40); }
            if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, condition, true, copy(emit)) { return 0; }
            if emit { character(41); character(123); character(10); }
            let mut prior = copy(last);
            while prior != 0 && nodes[prior].parent == block {
                if owners[prior].constructor != 0 { return 0; }
                if prior == graph[block].first_child { break; }
                let mut previous = graph[block].first_child;
                while graph[previous].next_sibling != prior { previous = graph[previous].next_sibling; }
                prior = previous;
            }
            if !emit_block_cleanup(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], copy(block), copy(last), false, true, copy(emit)) { return 0; }
            if emit {
                emit_loop_jump(if edge_kind == 23 { 4 } else { 5 });
                character(125); character(10);
            }
        } else if (kind == 8 || kind == 10) && nodes[expr].kind == 26 {
            let condition = graph[expr].first_child;
            let yes = graph[condition].next_sibling;
            let no = graph[yes].next_sibling;
            if nodes[yes].kind != 2 || !branch_preserves_owners(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(yes))
                || (no != 0 && (nodes[no].kind != 2
                    || !branch_preserves_owners(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(no)))) { return 0; }
            if emit { character(105); character(102); character(40); }
            if !destructor_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &scalar, condition, true, copy(emit)) { return 0; }
            if emit { character(41); character(123); character(10); }
            if emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut owners[0..owners.len()], yes, 0, 0, copy(emit)) != 1 { return 0; }
            if no != 0 {
                if emit {
                    let otherwise: [u8; 6] = [125,101,108,115,101,123];
                    byte_text(&otherwise[..]); character(10);
                }
                if emit_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut owners[0..owners.len()], no, 0, 0, copy(emit)) != 1 { return 0; }
            }
            if emit { character(125); character(10); }
        } else if kind == 6 && expr == 0 {
            outcome = 2;
        } else if region_annotation(&source[0..source.len()], &nodes[0..nodes.len()], copy(statement)) {
            let size = graph[statement].first_child;
            let count = graph[size].next_sibling;
            let literal = graph[count].first_child;
            if count != 0 && !decimal(&source[0..source.len()], nodes[literal].start, nodes[literal].end) { return 0; }
            if emit {
                let enter: [u8; 13] = [114, 101, 103, 105, 111, 110, 95, 101, 110, 116, 101, 114, 40];
                byte_text(&enter[..]);
                emit_size(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], size);
                character(44);
                if count == 0 { character(48); } else {
