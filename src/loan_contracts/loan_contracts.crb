use bootstrap::model::{AstNode, StaticNode, Token, CheckedValue};
use bootstrap::verify::check_type;

pub fn loan_callee(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], call: u64) -> u64 {
    let callee = graph[call].first_child;
    if nodes[callee].kind != 7 || graph[callee].binding != 0 { return 0; }
    let spelling = &source[nodes[callee].name_start..nodes[callee].name_end];
    let mut function = graph[0].first_child;
    while function != 0 {
        let name = &source[nodes[function].name_start..nodes[function].name_end];
        if nodes[function].kind == 1 && spelling.content_eq(&name[0..name.len()]) { return function; }
        function = graph[function].next_sibling;
    }
    0
}

// A direct return or explicit reborrow can be traced back to a parameter.
// An unresolved return keeps the caller on the conservative path.
fn expression_origin(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    value: u64, parameter: u64, contracts: &[CheckedValue]) -> bool {
    let kind = nodes[value].kind;
    let child = graph[value].first_child;
    if kind == 19 {
        return expression_origin(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], child, parameter, &contracts[0..contracts.len()]);
    }
    if kind == 13 && nodes[child].kind == 14 {
        return expression_origin(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], graph[child].first_child, parameter, &contracts[0..contracts.len()]);
    }
    if kind == 7 {
        let binding = graph[value].binding;
        if nodes[binding].kind == 3 { return binding == parameter; }
        if nodes[binding].kind == 5 {
            let mut initializer = graph[binding].first_child;
            if nodes[initializer].kind == 4 { initializer = graph[initializer].next_sibling; }
            return expression_origin(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], initializer, parameter, &contracts[0..contracts.len()]);
        }
    }
    if kind == 15 {
        let function = loan_callee(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], value);
        if function == 0 { return true; }
        let mut formal = graph[function].first_child;
        let mut argument = graph[child].next_sibling;
        while nodes[formal].kind == 3 && argument != 0 {
            if contracts[graph[formal].first_child].state == 1
                && expression_origin(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(argument), copy(parameter), &contracts[0..contracts.len()]) {
                return true;
            }
            formal = graph[formal].next_sibling;
            argument = graph[argument].next_sibling;
        }
        return false;
    }
    true
}

fn tail_returns(nodes: &[AstNode], point: u64, body: u64) -> bool {
    if nodes[point].kind != 10 { return false; }
    let mut block = nodes[point].parent;
    while block != body {
        let branch = nodes[block].parent;
        if nodes[branch].kind != 26 { return false; }
        let tail = nodes[branch].parent;
        if nodes[tail].kind != 10 { return false; }
        block = nodes[tail].parent;
    }
    true
}

// Every reachable return must be accounted for. Scanning syntactic returns
// may retain unreachable origins, which is safe for reservation.
fn returned_origin(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64,
    body: u64, parameter: u64, contracts: &[CheckedValue]) -> bool {
    let mut point: u64 = 1;
    while point < nodes.len() as u64 {
        let explicit = nodes[point].kind == 6 && graph[point].destination == function;
        let tail = tail_returns(&nodes[0..nodes.len()], copy(point), copy(body));
        if explicit || tail {
            let value = graph[point].first_child;
            if nodes[value].kind != 26 {
                if expression_origin(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], value, copy(parameter), &contracts[0..contracts.len()]) { return true; }
            }
        }
        point = point + 1;
    }
    false
}

fn reaches_function(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    visited: &mut [bool], current: u64, target: u64) -> bool {
    if visited[current] { return false; }
    visited[current] = true;
    let mut node: u64 = 1;
    while node < nodes.len() as u64 {
        if nodes[node].kind == 15 && nodes[node].start >= nodes[current].start
            && nodes[node].end <= nodes[current].end {
            let callee = loan_callee(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(node));
            if callee == target { return true; }
            if callee != 0 && reaches_function(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut visited[0..visited.len()], callee, copy(target)) {
                return true;
            }
        }
        node = node + 1;
    }
    false
}

// Type annotation nodes are distinct from binding and argument nodes.
// Their state marks parameters whose origin reaches a result.
pub fn infer_loan_contracts(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    tokens: &[Token], values: &mut [CheckedValue]) {
    let mut changed = true;
    while changed {
        changed = false;
        let mut function = graph[0].first_child;
        while function != 0 {
            if nodes[function].kind == 1 {
                let mut result = graph[function].first_child;
                while nodes[result].kind == 3 { result = graph[result].next_sibling; }
                if nodes[result].kind == 4 {
                    let output = check_type(&source[0..source.len()], &nodes[0..nodes.len()],
                        &graph[0..graph.len()], &tokens[0..tokens.len()], copy(result));
                    if output >= 20 && output < 60 {
                        let mut visited: [bool; 524289] = [false; 524289];
                        let recursive = reaches_function(&source[0..source.len()],
                            &nodes[0..nodes.len()], &graph[0..graph.len()], &mut visited[..],
                            copy(function), copy(function));
                        let body = graph[result].next_sibling;
                        let mut parameter = graph[function].first_child;
                        while parameter != result {
                            let annotation = graph[parameter].first_child;
                            let input = check_type(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &tokens[0..tokens.len()], copy(annotation));
                            if input >= 20 && input < 60 && input % 20 == output % 20
                                && values[annotation].state == 0
                                && (recursive || returned_origin(&source[0..source.len()], &nodes[0..nodes.len()],
                                    &graph[0..graph.len()], copy(function), copy(body), copy(parameter),
                                    &values[0..values.len()])) {
                                values[annotation] = CheckedValue { ty: 0, state: 1, mutable: false,
                                    target: 0, loan_parent: 0, origin_call: 0, writable: false };
                                changed = true;
                            }
                            parameter = graph[parameter].next_sibling;
                        }
                    }
                }
            }
            function = graph[function].next_sibling;
        }
    }
}
