//! Public C names for the existing generated nominal layouts.
use bootstrap::model::{AstNode,StaticNode};
use bootstrap::lowering_types::{c_type,number,signed};
use bootstrap::target_c::{byte_text,character};


/// Escapes underscores so generated separators cannot collide with source names.
pub fn c_identifier(source:&[u8],start:u64,end:u64) {
    let mut at=start;
    while at<end {
        let byte=source[at];character(byte as i32);if byte==95{character(117);}at=at+1;
    }
}

