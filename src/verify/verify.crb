                return (0 - slice, 0);
            }
            if slice != 0 { node = graph[node].next_sibling; continue; }
        }
        if kind == 5 && (nodes[initializer].kind == 13 || nodes[initializer].kind == 17 || nodes[initializer].kind == 18) {
            let annotation = if annotated { copy(child) } else { 0 };
            if nodes[initializer].kind == 13 {
                let entry = reborrow_entry(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(node), copy(initializer), copy(annotation));
                if entry < 0 {
                if entry == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
