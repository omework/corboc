            && nodes[graph[graph[graph[graph[initializer].first_child].next_sibling].first_child].next_sibling].kind == 37 {
            let task = graph[graph[initializer].first_child].next_sibling;
            let mut argument = graph[graph[task].first_child].next_sibling;
            let mut parameter = graph[spawned].first_child;
            while nodes[parameter].kind == 3 {
                if nodes[argument].kind != 37 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                let name = graph[parameter].first_child;
                let expected = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
