                let expected: i64 = if receiver > 0 { copy(receiver) } else { copy(previous) };
                let binding = graph[child].binding;
                let allocation = nodes[child].kind == 7 && values[binding].ty >= 201 && values[binding].ty <= 207;
                let ty = if allocation {
                    let ty = values[binding].ty;
                    let pool = values[binding].target;
                    let destination = graph[node].destination;
                    let parent = graph[destination].scope_parent;
                    if !scope_contains(&graph[0..graph.len()], graph[pool].scope, parent) {
                        return (violation(4, start), 0);
                    }
                    let moved = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                        &mut values[0..values.len()], copy(child), 0, 3);
                    if moved < 0 {
                if moved == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - moved, 0);
            }
                    if values[destination].target != 0 && values[destination].target != pool { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                    values[destination] = CheckedValue { ty: copy(ty), state: 1, mutable: false,
                        target: pool, loan_parent: 0, origin_call: 0, exclusive: false };
                    ty
                } else {
                    verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                        &mut values[0..values.len()], copy(child), copy(expected), 1)
                };
                if ty < 0 {
                if ty == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - ty, 0);
            }
                if !allocation && (ty < 1 || ty > 7) { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                if (expected > 0 && expected != ty) || (previous != 0 && previous != ty) { return (violation(1, start), 0); }
                edges[0] = LoopEdge { breaks: ty, continues: copy(receiver) };
            } else if kind == 23 && receiver != 0 {
                return (violation(1, start), 0);
            } else if child != 0 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
            let destination = graph[node].destination;
            let status = task_exit(&nodes[0..nodes.len()], &graph[0..graph.len()],
                &values[0..values.len()], copy(node), graph[destination].scope);
            if status != 0 { return (status, 0); }
            record_loop_edge(&values[0..values.len()], &graph[0..graph.len()],
                &mut edges[0..edges.len()], destination, kind == 23);
            if kind == 23 { return (0, 2); }
            return (0, 3);
        } else if kind == 57 {
            if values[node].state == 1 && nodes[nodes[block].parent].kind == 15
                && native_entry(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(node), copy(block)) {
                node = graph[node].next_sibling;
                continue;
            }
            let binding = graph[node].binding;
            if binding == 0 || values[binding].state == 0 { return (violation(1, start), 0); }
            if values[binding].state != 1 { return (violation(6, start), 0); }
            let ty = values[binding].ty;
            if ty == 295 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
            if (ty >= 94 && ty < 200) || values[binding].target == binding || values[binding].loan_parent != 0 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
            let target = values[binding].target;
            let exclusive = values[binding].exclusive;
            let loan_parent = values[binding].loan_parent;
            let origin_call = values[binding].origin_call;
            let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
                &graph[0..graph.len()], copy(binding), copy(node), true);
            if conflict > 0 { return (violation(5, start), 0); }
            if conflict < 0 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
            let mutable = values[binding].mutable;
            values[node] = CheckedValue { ty: copy(ty), state: 1, mutable: copy(mutable), target: copy(target), loan_parent: copy(loan_parent), origin_call: copy(origin_call), exclusive: copy(exclusive) };
            values[binding] = CheckedValue { ty: ty, state: 2, mutable: mutable, target: target, loan_parent: loan_parent, origin_call: origin_call, exclusive: exclusive };
        } else {
            return (unsupported_statement(&nodes[0..nodes.len()], node), 0);
        }
        node = graph[node].next_sibling;
    }
    if final_statement != 0 {
        let status = task_exit(&nodes[0..nodes.len()], &graph[0..graph.len()],
            &values[0..values.len()], final_statement, block);
        if status != 0 { return (status, 0); }
    }
    return (0, 0);
}
