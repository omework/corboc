pub fn check_block(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    values: &mut [CheckedValue], edges: &mut [LoopEdge], block: u64, result: i64, root: bool) -> (i64, i64) {
    check_block_with_destination(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], &tokens[0..tokens.len()], &mut values[0..values.len()],
        &mut edges[0..edges.len()], block, result, root, 0)
}

fn unsupported_statement(nodes: &[AstNode], point: u64) -> i64 {
    print(9);
    print(nodes[point].start);
    9
}

pub fn check_block_with_destination(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    values: &mut [CheckedValue], edges: &mut [LoopEdge], block: u64, result: i64, root: bool, destination: u64) -> (i64, i64) {
    let mut node = graph[block].first_child;
    let mut final_statement: u64 = 0;
    while node != 0 {
        final_statement = copy(node);
        let kind = nodes[node].kind;
        let start = nodes[node].start;
        let child = graph[node].first_child;
        let annotated = kind == 5 && nodes[child].kind == 4;
        let initializer = if annotated { graph[child].next_sibling } else { copy(child) };
        if kind==5 && pool_try(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&values[0..values.len()],copy(initializer)) {
            let expected=if annotated{result_annotation(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],copy(child))}else{0};
            if annotated && expected==0{return (violation(1,start),0);}
            let ty=check_pool_try(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],copy(initializer),expected,1);
            if ty<0{return (0-ty,0);}
            copy_task_summary(&mut values[0..values.len()],initializer,copy(node),ty,graph[node].mutable);node=graph[node].next_sibling;continue;
        }
        if kind == 5 && nodes[initializer].kind == 15 {
            let address = bind_asm_address(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), copy(initializer),
                if annotated { copy(child) } else { 0 });
            if address < 0 {
                if address == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - address, 0);
            }
            if address != 0 { node = graph[node].next_sibling; continue; }
        }
        if kind == 5 && !annotated && nodes[initializer].kind == 16 {
            let binding = read_argument_value(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(initializer), copy(node), 0, 1);
            if binding < 0 {
                if binding == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - binding, 0);
            }
            if binding == 744 { node = graph[node].next_sibling; continue; }
        }
        if kind == 5 && !annotated && nodes[initializer].kind == 13 {
            let loan = bind_record_field(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), copy(initializer));
            if loan < 0 {
                if loan == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - loan, 0);
            }
            if loan != 0 { node = graph[node].next_sibling; continue; }
        }
        if kind == 5 && annotated && tuple_annotation(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(child)) {
            let result = tuple_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(initializer), copy(child));
            if result < 0 {
                if result == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - result, 0);
            }
            copy_task_summary(&mut values[0..values.len()], initializer, copy(node), result, graph[node].mutable);
            node = graph[node].next_sibling;
            continue;
        }
        if kind == 47 {
            let status = destructure_tuple(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(node));
            if status != 0 { return (status, 0); }
            node = graph[node].next_sibling;
            continue;
        }
        if kind == 8 && nodes[child].kind == 15 {
            let dropped = drop_temporary_handle(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &tokens[0..tokens.len()], &mut values[0..values.len()], copy(child));
            if dropped < 0 {
                if dropped == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - dropped, 0);
            }
            if dropped != 0 {
                node = graph[node].next_sibling;
                continue;
            }
        }
        if kind == 5 && nodes[initializer].kind == 13 {
            if !annotated {
                let pool_view = bind_record_pool(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(node), copy(initializer));
                if pool_view < 0 {
