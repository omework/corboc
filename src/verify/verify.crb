                let actual = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(argument));
                if expected == 0 || actual != expected { return (violation(8, start), 0); }
                let ty = check_owned_struct(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut values[0..values.len()], copy(argument), copy(argument));
                if ty < 0 {
                if ty == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - ty, 0);
            }
                argument = graph[argument].next_sibling;
                parameter = graph[parameter].next_sibling;
            }
            if argument != 0 || nodes[parameter].kind != 2 || annotated { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
            values[node] = CheckedValue { ty: 91, state: 1, mutable: false,
                target: 0, loan_parent: 0, origin_call: 0, exclusive: false };
            node = graph[node].next_sibling;
            continue;
        }
        if kind == 50 {
            let (status, stopped) = check_block(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &tokens[0..tokens.len()], &mut values[0..values.len()],
                &mut edges[0..edges.len()], copy(child), copy(result), false);
            if status != 0 || stopped != 0 { return (status, stopped); }
            node = graph[node].next_sibling;
            continue;
        }
        if kind==77 {
            let mut operand=child;
            while operand!=0 {
                if nodes[operand].kind==52 {
                    let binding=graph[operand].binding;
                    if binding==0 || values[binding].ty==0 {return (violation(1,nodes[operand].start),0);}
                    if values[binding].state!=1 {return (violation(6,nodes[operand].start),0);}
                } operand=graph[operand].next_sibling;
            }
            node=graph[node].next_sibling;continue;
        }
        if kind == 51 {
            let status = check_asm(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &values[0..values.len()], copy(node));
            if status != 0 { return (status, 0); }
            node = graph[node].next_sibling;
            continue;
        }
        if kind == 25 {
            if !in_async(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(node)) {
                return (violation(8, start), 0);
            }
            node = graph[node].next_sibling;
            continue;
        }
        if kind == 5 && nodes[initializer].kind == 15 {
            returned = check_region_call(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(initializer), copy(node));
            if returned < 0 {
                if returned == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - returned, 0);
            }
            let function = if returned == 0 { loan_callee(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(initializer)) } else { 0 };
            if function != 0 && !annotated {
                let nominal = nominal_allocation_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(function));
                if nominal != 0 {
                    let checked = apply_allocation_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                        &graph[0..graph.len()], &mut values[0..values.len()], copy(initializer), copy(node), nominal);
                    if checked < 0 {
                if checked == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - checked, 0);
            }
                    node = graph[node].next_sibling;
                    continue;
                }
                let relay = array_relay_contract(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(function));
                if relay != 0 {
                    let checked = apply_array_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                        &graph[0..graph.len()], &mut values[0..values.len()], copy(initializer), copy(function), copy(node), relay);
                    if checked < 0 {
                if checked == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - checked, 0);
            }
                    node = graph[node].next_sibling;
                    continue;
                }
                let map = relay_collection(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut values[0..values.len()], copy(initializer), copy(function), copy(node));
                if map < 0 {
                if map == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - map, 0);
            }
                if map != 0 {
                    node = graph[node].next_sibling;
                    continue;
                }
            }
            if function != 0 {
                returned = apply_loan_contract(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &tokens[0..tokens.len()], &mut values[0..values.len()],
                    copy(initializer), copy(node), function);
                if returned < 0 {
                if returned == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - returned, 0);
            }
            }
        }
        if (kind == 5 || kind == 6 || kind == 8 || kind == 10) && returned == 0 {
            let expression = if kind == 5 { copy(initializer) } else { copy(child) };
            let mut launch = copy(expression);
            let joining = task_method(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(expression));
            if joining { launch = graph[expression].first_child; }
            let worker = thread_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(launch));
            if worker != 0 {
                let handle = check_native_worker(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &tokens[0..tokens.len()], &mut values[0..values.len()], copy(worker));
                if handle < 0 {
                if handle == -9 { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                return (0 - handle, 0);
            }
                if joining && in_async(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(expression)) {
                    return (violation(8, start), 0);
                }
                if joining && handle != 3301 {
                    let captures = values[worker].origin_call;
                    let scratch = graph[launch].first_child;
                    complete_task(&mut values[0..values.len()], captures, scratch);
                }
                let ty = if !joining { copy(handle) } else if handle >= 3300 { copy(handle) + 200 } else { copy(handle) + 10 };
                if kind == 5 {
                    if annotated { return (unsupported_statement(&nodes[0..nodes.len()], node), 0); }
                    if joining {
                        let output = values[worker].loan_parent;
                        values[node] = CheckedValue { ty: ty, state: 1, mutable: graph[node].mutable,
                            target: 0, loan_parent: output, origin_call: 0, exclusive: false };
                    } else {
                        copy_task_summary(&mut values[0..values.len()], copy(worker), copy(node), ty, graph[node].mutable);
                    }
                } else if kind == 10 && destination != 0 && !joining {
                    if !task_survives(&graph[0..graph.len()], &values[0..values.len()],
                        copy(worker), graph[destination].scope) { return (violation(4, start), 0); }
                    copy_task_summary(&mut values[0..values.len()], copy(worker), copy(destination),
                        ty, graph[destination].mutable);
                    return (0, 4);
                } else if (kind == 6 || (kind == 10 && root)) && pending_task(copy(result)) && !joining {
                    if result != ty { return (violation(8, start), 0); }
                    if !native_return_valid(&nodes[0..nodes.len()], &values[0..values.len()], copy(worker)) {
