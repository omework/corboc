pub fn regional_function(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64) -> u64 {
    let mut entry = graph[function].first_child;
    let mut pool: u64 = 0;
    while nodes[entry].kind == 3 {
        let region = region_signature(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            graph[entry].first_child, true);
        if region != 0 {
            if pool != 0 { return 0; }
            pool = copy(entry);
        }
        entry = graph[entry].next_sibling;
    }
    if pool == 0 || nodes[entry].kind != 4 { return 0; }
    let result = region_signature(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], entry, false);
    let input = region_signature(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], graph[pool].first_child, true);
    let allocation = if input == 99 { 301 } else if input >= 100 { input + 100 } else { input + 201 };
    if result == 0 || result != allocation { return 0; }
    pool
}

pub fn verify_expr(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
