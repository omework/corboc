            }
            if mode != 3 && !(mode == 1 && (allocation_move || array_move || (ty == 300 && expected == 300)
                || (ty == 310 && expected == 310) || (result_type(copy(ty)) && (expected == 0 || expected == ty)))) { return -9; }
            let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
