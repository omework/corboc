                    if name.content_eq(&main[..]) { return 0 - violation(8, start); }
                    if expected == 0 {
                        let (nominal, waits) = nominal_handle_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], copy(item));
                        if nominal != 0 {
                            return apply_nominal_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), nominal, waits, mode);
                        }
                    }
                    if mode == 1 && (expected == 0 || expected == 310) {
                        let conditional = conditional_wait(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(item));
                        if conditional != 0 {
                            return apply_conditional_wait(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                                &mut values[0..values.len()], copy(node), copy(item), conditional);
                        }
                        let relay = envelope_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], copy(item));
                        if relay != 0 {
                            return apply_envelope_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), relay);
                        }
                    }
                    if mode == 0 && expected == 0 {
                        let nominal = envelope_wait(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], copy(item));
                        if nominal != 0 {
                            return capture_envelope_wait(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), nominal, false);
                        }
                    }
                    if mode == 1 && (expected == 0 || expected == 300) {
                        let mut output = graph[item].first_child;
                        while nodes[output].kind == 3 { output = graph[output].next_sibling; }
                        let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], copy(output));
                        if nodes[output].kind == 4 && nodes[nominal].kind == 28 && graph[output].first_child == 0
                            && !value_record(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(nominal), 0, true) {
                            return instantiate_constructor_result(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), copy(item), output, false);
                        }
                    }
                    let (worker, constructor) = envelope_worker(&source[0..source.len()],
                        &nodes[0..nodes.len()], &graph[0..graph.len()], copy(item));
                    if worker != 0 && mode == 1 {
                        if expected != 0 && expected != 310 { return 0 - violation(1, start); }
                        return apply_envelope_contract(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], &mut values[0..values.len()], copy(node), item,
                            worker, constructor);
                    }
                    let (contract, worker) = native_worker_contract(&source[0..source.len()], &nodes[0..nodes.len()],
                        &graph[0..graph.len()], copy(item));
                    if worker != 0 && mode == 1 {
                        let result = apply_native_contract(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], &mut values[0..values.len()], copy(node), contract, worker);
                        if result > 0 && expected != 0 && result != expected { return 0 - violation(1, start); }
                        return result;
                    }
                    if mode == 1 && expected == 301 {
                        let nominal = nominal_allocation_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], copy(item));
                        if nominal != 0 {
                            return apply_allocation_relay(&source[0..source.len()], &nodes[0..nodes.len()],
                                &graph[0..graph.len()], &mut values[0..values.len()], copy(node), node, nominal);
                        }
                    }
                    return check_signature(&source[0..source.len()], &nodes[0..nodes.len()],
                        &graph[0..graph.len()], &mut values[0..values.len()], item,
                        argument, expected, mode, node);
                }
            }
            item = graph[item].next_sibling;
        }
        let address: [u8; 4] = [97,100,100,114];
        let ok: [u8; 2] = [79,107];
        let err: [u8; 3] = [69,114,114];
        // These unqualified constructors have contextual typing. Their
        // absence from the function table isn't evidence of an unknown call.
        if spelling.content_eq(&address[..]) {
            if argument == 0 || graph[argument].next_sibling != 0 {
                return 0 - violation(1, start);
            }
            if nodes[argument].kind == 9 {
                address_requires_reference();
                return 0 - violation(1, nodes[argument].start);
            }
            return -9;
        }
        if spelling.content_eq(&ok[..])
            || spelling.content_eq(&err[..]) { return -9; }
        return 0 - violation(8, start);
    }
    return -9;
}
