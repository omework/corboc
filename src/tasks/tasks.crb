fn instantiate_slice_constructor(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], call: u64, parameter: u64, output: u64, asynchronous: bool) -> i64 {
    let annotation = graph[parameter].first_child;
    let (slice, element, exclusive) = slice_parameter(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], annotation);
    if slice == 0 { return 0; }
    if asynchronous && (graph[parameter].next_sibling != output
        || !inline_wait(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(call))) { return -9; }
    let callee = graph[call].first_child;
    let argument = graph[callee].next_sibling;
    let tail = graph[graph[output].next_sibling].first_child;
    let shape = graph[tail].first_child;
    if (nodes[tail].kind != 6 && nodes[tail].kind != 10) || graph[tail].next_sibling != 0
        || nodes[shape].kind != 37 { return -9; }
    let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(shape));
    if graph[parameter].next_sibling != output {
        return instantiate_multiple_slice_arguments(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], &mut values[0..values.len()], call, parameter, output, shape, nominal);
    }
    if argument == 0 || graph[argument].next_sibling != 0 { return 0 - violation(8, nodes[call].start); }
    let mut field = graph[shape].first_child;
    let mut dependency: u64 = 0;
    while field != 0 {
        let member = verification_field(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(nominal), copy(field));
        if member == 0 { return -9; }
        let ty = graph[member].first_child;
        let value = graph[field].first_child;
        if nodes[value].kind == 7 && graph[value].binding == parameter {
            if dependency != 0 { return -9; }
            dependency = copy(field);
        } else if graph[ty].first_child != 0 || verify_primitive(&source[0..source.len()],
            nodes[ty].name_start, nodes[ty].name_end) == 0 {
            return -9;
        }
        field = graph[field].next_sibling;
    }
    if dependency == 0 { return -9; }
    let checked = check_slice_argument(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], &mut values[0..values.len()], copy(argument), slice, element, exclusive);
    if checked < 0 { return checked; }
    if asynchronous {
        values[callee] = CheckedValue { ty: 300, state: 1, mutable: false, target: 0,
            loan_parent: copy(argument), origin_call: shape, exclusive: false };
        values[call] = CheckedValue { ty: 3100, state: 1, mutable: false, target: 0,
            loan_parent: callee, origin_call: argument, exclusive: false };
        return 3100;
    }
    values[call] = CheckedValue { ty: 300, state: 1, mutable: false, target: 0,
        loan_parent: argument, origin_call: shape, exclusive: false };
    300
}

