pub fn in_async(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], point: u64) -> bool {
    let mut current = point;
    while current != 0 {
        if nodes[current].kind == 35 { return true; }
        if nodes[current].kind == 1 || graph[current].fact == 7 { return false; }
        let parent = nodes[current].parent;
        if nodes[current].kind == 2 && nodes[parent].kind == 15 {
            if thread_block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], parent) == current {
                return false;
            }
        }
        current = nodes[current].parent;
    }
    false
}

// A range per task state preserves the complete ordinary Result descriptor.
pub fn result_task_code(kind: i64, result: i64) -> i64 {
    8000000000000000000 + kind * 1000000000000000 + (result - 9000000000000000000)
}

fn result_task_kind(ty: i64) -> i64 {
    if ty <= 8001000000000000000 || ty >= 8005000000000000000 { return 0; }
    if !result_type(9000000000000000000 + ty % 1000000000000000) { return 0; }
    return (ty - 8000000000000000000) / 1000000000000000;
}

pub fn task_value(ty: i64) -> bool {
    (ty >= 610 && ty <= 619) || (ty >= 620 && ty <= 629)
        || (ty >= 630 && ty <= 639) || (ty >= 640 && ty <= 649) || (ty >= 3100 && ty < 3700)
        || nested_async_launch(copy(ty)) || nested_async_completion(copy(ty))
        || (ty >= 4101 && ty <= 4117) || result_task_kind(ty) != 0
}

fn nested_async_future(ty: i64) -> bool { ty >= 3640 && ty <= 3649 }
fn nested_async_launch(ty: i64) -> bool { ty >= 3840 && ty <= 3849 }
fn nested_async_completion(ty: i64) -> bool { ty >= 4040 && ty <= 4049 }

// Capture edges use argument nodes, independently of the state of the
// original binding. The Future and its handle carry the same immutable list.
pub fn record_capture(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], argument: u64, expected: i64, previous: u64) -> i64 {
    let start = nodes[argument].start;
    let exclusive = expected >= 40;
    let mut binding: u64 = 0;
    let mut root: u64 = 0;
    if nodes[argument].kind == 13 {
        let place = graph[argument].first_child;
        if nodes[place].kind != 7 { return -9; }
        root = graph[place].binding;
        if root == 0 || values[root].state != 1 { return 0 - violation(4, start); }
        let mutable = borrow_mutable(&source[start..nodes[place].start]);
        if mutable != exclusive || values[root].ty != expected % 20 || values[root].target != 0 {
            return 0 - violation(1, start);
        }
        if exclusive && !values[root].mutable { return 0 - violation(5, start); }
    } else if nodes[argument].kind == 7 {
        binding = graph[argument].binding;
        if binding == 0 || values[binding].state != 1 { return 0 - violation(6, start); }
        if values[binding].target == 0 || values[binding].origin_call != 0
            || values[binding].ty >= 60 { return -9; }
        if loan_element(&values[0..values.len()], copy(binding)) != expected % 20
            || values[binding].exclusive != exclusive { return 0 - violation(1, start); }
        root = values[binding].target;
        if !live_roots(&values[0..values.len()], &graph[0..graph.len()], copy(binding)) {
            return 0 - violation(4, start);
        }
    } else { return -9; }
    let reservation = if binding == 0 { copy(root) } else { copy(binding) };
    let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()], &graph[0..graph.len()],
        reservation, copy(argument), copy(exclusive));
    if conflict > 0 { return 0 - violation(5, start); }
    if conflict < 0 { return -9; }
    let mut prior = copy(previous);
    while prior != 0 {
        if values[prior].target == root && (exclusive || values[prior].exclusive) {
            return 0 - violation(5, start);
        }
        prior = values[prior].origin_call;
    }
    let owner = values[binding].loan_parent;
    values[argument] = CheckedValue { ty: expected, state: 1, mutable: false, target: root,
        loan_parent: if owner == 0 { binding } else { owner }, origin_call: previous, exclusive: exclusive };
    return 1;
}

// A capture of an entry descriptor carries an effect independently of the
// handle's result. Its successor stores the actual incoming referent.
fn capture_entry_effect(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], argument: u64, scalar: i64) -> i64 {
    let incoming = graph[argument].next_sibling;
    if nodes[argument].kind != 7 || incoming == 0 || graph[incoming].next_sibling != 0 { return -9; }
    let binder = graph[argument].binding;
    let ty = values[binder].ty;
    if ty == 1930 + scalar && nodes[binder].kind == 3 && nodes[incoming].kind == 7 {
        let other = graph[incoming].binding;
        if nodes[other].kind != 3 || values[other].ty != 40 + scalar { return -9; }
        if values[binder].state != 1 || values[other].state != 1 {
            return 0 - violation(6, nodes[argument].start);
        }
        values[incoming] = CheckedValue { ty: 40 + scalar, state: 1, mutable: false, target: graph[other].first_child,
            loan_parent: 0, origin_call: 0, exclusive: true };
        values[argument] = CheckedValue { ty: 5001, state: 1, mutable: false, target: graph[binder].first_child,
            loan_parent: binder, origin_call: incoming, exclusive: true };
        return 1;
    }
    if !entry_reference(copy(ty)) || map_item_code(copy(ty)) != 7 { return -9; }
    if ty % 10 != scalar { return 0 - violation(1, nodes[argument].start); }
    if values[binder].state != 1 { return 0 - violation(6, nodes[argument].start); }
    if !values[binder].exclusive { return 0 - violation(5, nodes[argument].start); }
    let access = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
        &graph[0..graph.len()], copy(binder), copy(argument), true);
    if access > 0 { return 0 - violation(5, nodes[argument].start); }
    if access < 0 { return -9; }
    let status = record_capture(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], &mut values[0..values.len()], copy(incoming), 40 + scalar, 0);
    if status < 0 { return status; }
    let root = values[incoming].target;
    let mut statement = nodes[argument].parent;
    while statement != 0 && nodes[nodes[statement].parent].kind != 2 { statement = nodes[statement].parent; }
    let valid = entry_update_context(&nodes[0..nodes.len()], &graph[0..graph.len()],
        &values[0..values.len()], copy(binder), root, copy(argument), statement);
    if valid < 0 { return valid; }
    let map = values[binder].loan_parent;
    values[argument] = CheckedValue { ty: 5000, state: 1, mutable: false, target: map,
        loan_parent: binder, origin_call: incoming, exclusive: true };
    return 1;
}

pub fn complete_task(values: &mut [CheckedValue], captures: u64, scratch: u64) {
    if captures != 0 && values[captures].ty == 5000 {
        let binder = values[captures].loan_parent;
        let root = values[values[captures].origin_call].target;
        update_entry(&mut values[0..values.len()], binder, root, scratch);
    }
}

pub fn pending_task(ty: i64) -> bool {
    (ty >= 620 && ty <= 629) || (ty >= 640 && ty <= 649)
        || (ty >= 3300 && ty < 3500) || nested_async_launch(copy(ty))
        || result_task_kind(copy(ty)) == 2 || result_task_kind(ty) == 4
}

pub fn completion_type(ty: i64) -> bool {
    (ty >= 630 && ty <= 639) || (ty >= 3500 && ty < 3600)
        || nested_async_completion(copy(ty)) || result_task_kind(ty) == 3
}

// A Future wrapping a guaranteed wait must run inline until the verifier
// models multiple independently launched levels of completion.
fn inline_wait(nodes: &[AstNode], graph: &[StaticNode], operand: u64) -> bool {
    let mut node = operand;
    while nodes[nodes[node].parent].kind == 19 { node = nodes[node].parent; }
    let parent = nodes[node].parent;
    return nodes[parent].kind == 38 && graph[parent].first_child == node;
}

fn future_type(ty: i64) -> bool {
    (ty >= 610 && ty <= 619) || (ty >= 3100 && ty < 3200) || nested_async_future(copy(ty))
        || (ty >= 4101 && ty <= 4117) || result_task_kind(ty) == 1
}

pub fn task_output(ty: i64) -> i64 {
    if nested_async_future(copy(ty)) || nested_async_launch(copy(ty)) || nested_async_completion(copy(ty)) {
        return 640 + ty % 10;
    }
    if result_task_kind(copy(ty)) != 0 { return 9000000000000000000 + ty % 1000000000000000; }
    if ty >= 4101 && ty <= 4117 { return ty - 2000; }
    if ty >= 3100 {
        let code = ty % 100;
        if code == 98 { return 298; }
        if code == 99 { return 299; }
        if code == 97 { return 297; }
        if code == 0 { return 300; }
        if code == 1 { return 310; }
        return 800 + code;
    }
    return ty % 10;
}

fn encoded_result(ty: i64) -> i64 {
    if ty >= 297 && ty <= 299 { return ty - 200; }
    if ty > 800 && ty < 880 { return ty - 800; }
    return 0;
}

pub fn copy_task_summary(values: &mut [CheckedValue], from: u64, to: u64, ty: i64, mutable: bool) {
    let captures = values[from].origin_call;
    let result_root = values[from].target;
    let result_entries = values[from].loan_parent;
    values[to] = CheckedValue { ty: ty, state: 1, mutable: mutable, target: result_root,
        loan_parent: result_entries, origin_call: captures, exclusive: false };
}

fn allocation_return_root(nodes: &[AstNode], graph: &[StaticNode], body: u64) -> u64 {
    let mut tail = graph[body].first_child;
    while tail != 0 && graph[tail].next_sibling != 0 {
        if nodes[tail].kind != 8 && nodes[tail].kind != 25 { return 0; }
        tail = graph[tail].next_sibling;
    }
    let result = graph[tail].first_child;
    if nodes[tail].kind != 10 || nodes[result].kind != 7 { return 0; }
    let root = graph[result].binding;
    if nodes[root].kind != 3 { return 0; }
    return root;
}

pub fn growing_value_result(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) -> i64 {
    let vector = vector_reference_type(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(annotation));
    if vector != 0 { return vector; }
    let map = map_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(annotation));
    if map < 0 { return map; }
    if map != 0 && !dependent_map(copy(map)) { return map; }
    let allocation = region_signature(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], annotation, false);
    if allocation >= 297 && allocation <= 299 { return allocation; }
    0
}

pub fn growing_allocation_return(nodes: &[AstNode], graph: &[StaticNode], function: u64) -> u64 {
    let mut result = graph[function].first_child;
    while nodes[result].kind == 3 { result = graph[result].next_sibling; }
    if nodes[result].kind != 4 { return 0; }
    return allocation_return_root(&nodes[0..nodes.len()], &graph[0..graph.len()], graph[result].next_sibling);
}

pub fn plain_vector_return(nodes: &[AstNode], graph: &[StaticNode], body: u64) -> bool {
    let mut statement = graph[body].first_child;
    while nodes[statement].kind == 25 { statement = graph[statement].next_sibling; }
    return nodes[statement].kind == 10 && graph[statement].next_sibling == 0;
}

// A factory that returns the launched handle carries the worker's effect in
// its result. Awaiting the factory itself does not complete that worker.
fn returned_blocking_effect(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64,
    launch: u64) -> i64 {
    let first = graph[function].first_child;
    let second = graph[first].next_sibling;
    if nodes[first].kind != 3 || nodes[second].kind != 3 || nodes[graph[second].next_sibling].kind != 4 {
        return 0;
    }
    let name = graph[launch].first_child;
    if nodes[launch].kind != 15 || nodes[name].kind != 36 { return 0; }
    let blocking: [u8; 23] = [114,117,110,116,105,109,101,58,58,115,112,97,119,110,95,98,108,111,99,107,105,110,103];
    let path = &source[nodes[name].start..nodes[name].end];
    if !path.content_eq(&blocking[..]) { return 0; }
    let future = graph[name].next_sibling;
    if nodes[future].kind != 15 || graph[future].next_sibling != 0 { return 0; }
    let callee = graph[future].first_child;
    let left = graph[callee].next_sibling;
    let right = graph[left].next_sibling;
    if nodes[callee].kind != 7 || nodes[left].kind != 7 || nodes[right].kind != 7
        || graph[left].binding != first || graph[right].binding != second {
        return 0;
    }
    let spelling = &source[nodes[callee].name_start..nodes[callee].name_end];
    let mut worker = graph[0].first_child;
    while worker != 0 {
        if nodes[worker].kind == 35 {
            let name = &source[nodes[worker].name_start..nodes[worker].name_end];
            if spelling.content_eq(&name[0..name.len()]) {
                let counter = entry_counter_argument(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(worker), graph[right].next_sibling);
                if !counter { return 0; }
                return entry_effect_scalar(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], worker, 64);
            }
        }
        worker = graph[worker].next_sibling;
    }
    return 0;
}

// A wrapper that moves its sole parameter into a relay Future and
// directly awaits it has the same value dependency at its output.
pub fn suspended_identity(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64) -> u64 {
    if nodes[function].kind != 35 { return 0; }
    let parameter = graph[function].first_child;
    let output = graph[parameter].next_sibling;
    if nodes[parameter].kind != 3 || nodes[output].kind != 4 || graph[output].first_child != 0 { return 0; }
    let argument_type = graph[parameter].first_child;
    if graph[argument_type].first_child != 0 { return 0; }
    let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], argument_type);
    if nodes[nominal].kind != 28 || nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(output)) != nominal { return 0; }
    let body = graph[output].next_sibling;
    let pending = graph[body].first_child;
    let result = graph[pending].next_sibling;
    if nodes[pending].kind != 5 || graph[pending].type_node != 0 || nodes[result].kind != 10
        || graph[result].next_sibling != 0 { return 0; }
    let call = graph[pending].initializer;
    let name = graph[call].first_child;
    let argument = graph[name].next_sibling;
    if nodes[call].kind != 15 || nodes[name].kind != 7 || graph[name].binding != 0
        || nodes[argument].kind != 7 || graph[argument].binding != parameter
        || graph[argument].next_sibling != 0 { return 0; }
    let mut tail = graph[result].first_child;
    if nodes[tail].kind == 2 {
        let mut statement = graph[tail].first_child;
        while nodes[statement].kind == 25 { statement = graph[statement].next_sibling; }
        if nodes[statement].kind != 10 || graph[statement].next_sibling != 0 { return 0; }
        tail = graph[statement].first_child;
    }
    let operand = graph[tail].first_child;
    if nodes[tail].kind != 38 || nodes[operand].kind != 7 || graph[operand].binding != pending { return 0; }
    let spelling = &source[nodes[name].name_start..nodes[name].name_end];
    let mut target = graph[0].first_child;
    while target != 0 {
        let candidate = &source[nodes[target].name_start..nodes[target].name_end];
        if nodes[target].kind == 35 && spelling.content_eq(&candidate[0..candidate.len()]) {
            if identity_aggregate(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                target) == nominal { return nominal; }
            return 0;
        }
        target = graph[target].next_sibling;
    }
    return 0;
}

fn aggregate_identity_future(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], call: u64, nominal: u64) -> i64 {
    let name = graph[call].first_child;
    let argument = graph[name].next_sibling;
    if argument == 0 || graph[argument].next_sibling != 0 {
        return 0 - violation(8, nodes[call].start);
    }
    let constructor = if nodes[argument].kind == 37 { copy(argument) }
        else if nodes[argument].kind == 7 { values[graph[argument].binding].origin_call } else { 0 };
    if nodes[constructor].kind != 37 { return -9; }
    let declaration = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(constructor));
    if declaration != nominal { return 0 - violation(1, nodes[argument].start); }
    let ty = if nodes[argument].kind == 37 {
        check_owned_struct(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(argument), copy(argument))
    } else {
        verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(argument), 300, 1)
    };
    if ty < 0 { return ty; }
    if ty != 300 { return -9; }
    let pool = values[argument].target;
    // Keep the capture edge separate from the argument's field records.
    values[name] = CheckedValue { ty: 5010, state: 1, mutable: false, target: 0,
        loan_parent: copy(argument), origin_call: 0, exclusive: false };
    values[call] = CheckedValue { ty: 3100, state: 1, mutable: false, target: pool,
        loan_parent: argument, origin_call: name, exclusive: false };
    return 3100;
}

pub fn pooled_identity(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64) -> u64 {
    if nodes[function].kind != 35 { return 0; }
    let parameter = graph[function].first_child;
    let output = graph[parameter].next_sibling;
    if nodes[parameter].kind != 3 || nodes[output].kind != 4 { return 0; }
    let input = graph[parameter].first_child;
    let nominal = pooled_nominal(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], input);
    if nominal == 0 || pooled_nominal(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(output)) != nominal { return 0; }
    let body = graph[output].next_sibling;
    let mut tail = graph[body].first_child;
    while nodes[tail].kind == 25 { tail = graph[tail].next_sibling; }
    let name = graph[tail].first_child;
    if nodes[tail].kind != 10 || graph[tail].next_sibling != 0 || nodes[name].kind != 7
        || graph[name].binding != parameter { return 0; }
    return nominal;
}

fn pooled_nominal(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) -> u64 {
    let element = graph[annotation].first_child;
    if nodes[annotation].name_end - nodes[annotation].name_start != 1
        || source[nodes[annotation].name_start] != 65 || element == 0 || graph[element].next_sibling != 0
        || graph[element].first_child != 0 { return 0; }
    return nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], element);
}

fn pooled_identity_future(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], call: u64, nominal: u64) -> i64 {
    if !inline_wait(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(call)) { return -9; }
    let name = graph[call].first_child;
    let argument = graph[name].next_sibling;
    let from = graph[argument].binding;
    if nodes[argument].kind != 7 || graph[argument].next_sibling != 0 || values[from].ty != 301 { return -9; }
    let constructor = values[from].origin_call;
    if nodes[constructor].kind != 37 || nominal_declaration(&source[0..source.len()],
        &nodes[0..nodes.len()], &graph[0..graph.len()], copy(constructor)) != nominal { return -9; }
    let pool = values[from].target;
    let status = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
        &mut values[0..values.len()], argument, 0, 3);
    if status < 0 { return status; }
    values[call] = CheckedValue { ty: 3601, state: 1, mutable: false, target: pool,
        loan_parent: 0, origin_call: constructor, exclusive: false };
    return 3601;
}

fn instantiate_multiple_slice_arguments(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], call: u64, parameter: u64, output: u64,
    shape: u64, nominal: u64) -> i64 {
    let callee = graph[call].first_child;
    let first = graph[callee].next_sibling;
    let mut formal = copy(parameter);
    let mut argument = copy(first);
    while formal != output {
        if nodes[formal].kind != 3 { return -9; }
        if argument == 0 { return 0 - violation(8, nodes[call].start); }
        let (slice, element, exclusive) = slice_parameter(&source[0..source.len()],
            &nodes[0..nodes.len()], &graph[0..graph.len()], graph[formal].first_child);
        let annotation = graph[formal].first_child;
        let record = record_parameter(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(annotation), false);
        let scalar = verify_primitive(&source[0..source.len()], nodes[annotation].name_start, nodes[annotation].name_end);
        let exclusive = if slice != 0 { exclusive } else if record != 0 {
            let inner = graph[annotation].first_child;
            borrow_mutable(&source[nodes[annotation].start..nodes[inner].start])
        } else { false };
        if slice == 0 && record == 0 && scalar == 0 { return -9; }
        let mut field = graph[shape].first_child;
        let mut occurrences: u64 = 0;
        while field != 0 {
            let member = verification_field(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(nominal), copy(field));
            let value = graph[field].first_child;
            if member == 0 { return -9; }
            let ty = graph[member].first_child;
            let (field_slice, field_element, field_exclusive) = slice_parameter(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(ty));
            if field_slice != 0 || source[nodes[ty].start] == 38 {
                if nodes[value].kind != 7 || nodes[graph[value].binding].kind != 3 { return -9; }
                if graph[value].binding == formal { occurrences = occurrences + 1; }
            } else if graph[ty].first_child != 0 || verify_primitive(&source[0..source.len()],
                nodes[ty].name_start, nodes[ty].name_end) == 0 { return -9; }
            field = graph[field].next_sibling;
        }
        // A borrowed argument may be inspected without being retained in the returned record.
        if scalar == 0 && occurrences > 1 { return -9; }
        let mut earlier = copy(first);
        while earlier != argument {
            if argument_conflicts(&nodes[0..nodes.len()], &graph[0..graph.len()],
                &values[0..values.len()], copy(earlier), copy(argument)) {
                return 0 - violation(5, nodes[argument].start);
            }
            earlier = graph[earlier].next_sibling;
        }
        let checked = if slice != 0 {
            check_slice_argument(&source[0..source.len()], &nodes[0..nodes.len()],
