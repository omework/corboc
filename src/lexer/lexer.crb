//! Shared lexical tokenization for the frontend and nested expression verification.
use bootstrap::model::{Token, hex_digit};
use bootstrap::lowering_types::signed as source_offset;
use bootstrap::diagnostics::diagnostic_emit;

pub fn name_start(byte: u8) bool {
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95
}

pub fn digit(byte: u8) bool {
    byte >= 48 && byte <= 57
}

// Decode one UTF-8 scalar. A zero width signals invalid input.
pub fn utf8_scalar(source: &[u8], start: usize) (usize, u32) {
    let lead = source[start];
    if lead >> 7 == 0 { return (1, lead as u32); }

    let mut width: usize = 0;
    if lead >= 194 && lead <= 223 { width = 2; }
    if lead >= 224 && lead <= 239 { width = 3; }
    if lead >= 240 && lead <= 244 { width = 4; }
    if width == 0 || width > source.len() - start { return (0, 0); }

    let second = source[start + 1];
    if lead == 224 && second < 160 { return (0, 0); }
    if lead == 237 && second >= 160 { return (0, 0); }
    if lead == 240 && second < 144 { return (0, 0); }
    if lead == 244 && second >= 144 { return (0, 0); }
    let mut scalar = (lead & (127 / (1 << width))) as u32;
    let mut offset: usize = 1;
    while offset < width {
        let byte = source[start + offset];
        if byte >> 6 != 2 { return (0, 0); }
        scalar = (scalar << 6) | ((byte & 63) as u32);
        offset = offset + 1;
    }
    (width, scalar)
}

// Read four hexadecimal digits. 65536 signals an invalid UTF-16 unit.
pub fn hex_unit(source: &[u8], start: usize) u32 {
    if source.len() - start < 4 { return 65536; }
    let mut unit: u32 = 0;
    let mut offset: usize = 0;
    while offset < 4 {
        let value = hex_digit(source[start + offset]);
        if value == 16 { return 65536; }
        unit = (unit << 4) | value;
        offset = offset + 1;
    }
    unit
}

// Return the next escape position, or its diagnostic code and byte.
pub fn scan_escape(source: &[u8], start: usize) (usize, i64, usize) {
    let marker = start + 1;
    if marker == source.len() { return (0, 4, marker); }
    let byte = source[marker];
    if byte == 34 || byte == 92 || byte == 47 || byte == 98 || byte == 102
        || byte == 110 || byte == 114 || byte == 116 { return (start + 2, 0, 0); }
    if byte != 117 { return (0, 4, marker); }

    let unit = hex_unit(&source[0..source.len()], marker + 1);
    if unit == 65536 { return (0, 5, marker); }
    if unit >= 56320 && unit <= 57343 { return (0, 6, marker + 4); }
    if unit < 55296 || unit > 56319 { return (start + 6, 0, 0); }
    if source.len() - start < 8 || source[start + 6] != 92 || source[start + 7] != 117 {
        return (0, 7, marker + 4);
    }
    let low = hex_unit(&source[0..source.len()], start + 8);
    if low == 65536 { return (0, 5, marker + 6); }
    if low < 56320 || low > 57343 { return (0, 8, marker + 6); }
    return (start + 12, 0, 0);
}

pub fn name_kind(spelling: &[u8]) i64 {
    let for_word = "for";
    let in_word = "in";
    let for_bytes=for_word.as_bytes();
    if spelling.content_eq(for_bytes) { return 85; }
    let in_bytes=in_word.as_bytes();
    if spelling.content_eq(in_bytes) { return 86; }
    let fn_word: [u8; 2] = [102, 110];
    let let_word: [u8; 3] = [108, 101, 116];
    let mut_word: [u8; 3] = [109, 117, 116];
    let return_word: [u8; 6] = [114, 101, 116, 117, 114, 110];
    let true_word: [u8; 4] = [116, 114, 117, 101];
    let false_word: [u8; 5] = [102, 97, 108, 115, 101];
    if spelling.content_eq(&fn_word[..]) { return 7; }
    if spelling.content_eq(&let_word[..]) { return 15; }
    if spelling.content_eq(&mut_word[..]) { return 16; }
    if spelling.content_eq(&return_word[..]) { return 17; }
    if spelling.content_eq(&true_word[..]) || spelling.content_eq(&false_word[..]) { return 18; }
    let as_word: [u8; 2] = [97, 115];
    if spelling.content_eq(&as_word[..]) { return 41; }
    let word_44: [u8; 2] = [105, 102];
    if spelling.content_eq(&word_44[..]) { return 44; }
    let word_45: [u8; 4] = [101, 108, 115, 101];
    if spelling.content_eq(&word_45[..]) { return 45; }
    let word_46: [u8; 5] = [119, 104, 105, 108, 101];
    if spelling.content_eq(&word_46[..]) { return 46; }
    let word_47: [u8; 5] = [98, 114, 101, 97, 107];
    if spelling.content_eq(&word_47[..]) { return 47; }
    let word_48: [u8; 8] = [99, 111, 110, 116, 105, 110, 117, 101];
    if spelling.content_eq(&word_48[..]) { return 48; }
    let word_49: [u8; 4] = [108, 111, 111, 112];
    if spelling.content_eq(&word_49[..]) { return 49; }
    let word_50: [u8; 5] = [121, 105, 101, 108, 100];
    if spelling.content_eq(&word_50[..]) { return 50; }
    let await_word: [u8; 5] = [97, 119, 97, 105, 116];
    if spelling.content_eq(&await_word[..]) { return 61; }
    let async_word: [u8; 5] = [97, 115, 121, 110, 99];
    if spelling.content_eq(&async_word[..]) { return 60; }
    let enum_word: [u8; 4] = [101, 110, 117, 109];
    if spelling.content_eq(&enum_word[..]) { return 59; }
    let struct_word: [u8; 6] = [115, 116, 114, 117, 99, 116];
    if spelling.content_eq(&struct_word[..]) { return 58; }
    let pub_word: [u8; 3] = [112, 117, 98];
    if spelling.content_eq(&pub_word[..]) { return 57; }
    let use_word: [u8; 3] = [117, 115, 101];
    if spelling.content_eq(&use_word[..]) { return 56; }
    let match_word: [u8; 5] = [109, 97, 116, 99, 104];
    if spelling.content_eq(&match_word[..]) { return 62; }
    let const_word: [u8; 5] = [99, 111, 110, 115, 116];
    if spelling.content_eq(&const_word[..]) { return 81; }
    let impl_word: [u8; 4] = [105, 109, 112, 108];
    if spelling.content_eq(&impl_word[..]) { return 65; }
    let self_word: [u8; 4] = [115, 101, 108, 102];
    if spelling.content_eq(&self_word[..]) { return 66; }
    let unchecked_word: [u8; 9] = [117, 110, 99, 104, 101, 99, 107, 101, 100];
    if spelling.content_eq(&unchecked_word[..]) { return 70; }
    let move_word: [u8; 4] = [109, 111, 118, 101];
    if spelling.content_eq(&move_word[..]) { return 72; }
    let extern_word: [u8; 6] = [101, 120, 116, 101, 114, 110];
    if spelling.content_eq(&extern_word[..]) { return 73; }
    let unsafe_word: [u8; 6] = [117, 110, 115, 97, 102, 101];
    if spelling.content_eq(&unsafe_word[..]) { return 76; }
    1
}

// The expression parser uses these same token numbers to determine precedence.
// Keep right angle brackets separate so nested generic types can end next to '='.
pub fn assignment_width(tokens: &[Token], index: u64) u64 {
    let kind = tokens[index].kind;
    if kind == 13 || (kind >= 51 && kind <= 55) || (kind >= 77 && kind <= 80) { return 1; }
    if kind == 24 && tokens[index + 1].kind == 24 && tokens[index + 2].kind == 13
        && tokens[index].end == tokens[index + 1].start
        && tokens[index + 1].end == tokens[index + 2].start { return 3; }
    0
}

pub fn punctuation(byte: u8, next: u8) (i64, usize) {
    if byte == 46 && next == 46 { return (42, 2); }
    if byte == 58 && next == 58 { return (43, 2); }
    if next == 61 {
        if byte == 43 { return (51, 2); }
        if byte == 45 { return (52, 2); }
        if byte == 42 { return (53, 2); }
        if byte == 47 { return (54, 2); }
        if byte == 37 { return (55, 2); }
        if byte == 38 { return (77, 2); }
        if byte == 124 { return (78, 2); }
        if byte == 94 { return (79, 2); }
    }
    if byte == 61 && next == 62 { return (63, 2); }
    if byte == 45 && next == 62 { return (12, 2); }
    if byte == 124 && next == 124 { return (30, 2); }
    if byte == 38 && next == 38 { return (31, 2); }
    if byte == 61 && next == 61 { return (32, 2); }
    if byte == 33 && next == 61 { return (33, 2); }
    if byte == 60 && next == 61 { return (34, 2); }
    if byte == 60 && next == 60 { return (36, 2); }
    if byte == 40 { return (2, 1); }
    if byte == 41 { return (3, 1); }
    if byte == 123 { return (4, 1); }
    if byte == 125 { return (5, 1); }
    if byte == 47 { return (6, 1); }
    if byte == 58 { return (10, 1); }
    if byte == 44 { return (11, 1); }
    if byte == 61 { return (13, 1); }
    if byte == 59 { return (14, 1); }
    if byte == 43 { return (19, 1); }
    if byte == 45 { return (20, 1); }
    if byte == 42 { return (21, 1); }
    if byte == 37 { return (22, 1); }
    if byte == 60 { return (23, 1); }
    if byte == 62 { return (24, 1); }
    if byte == 38 { return (25, 1); }
    if byte == 94 { return (26, 1); }
    if byte == 124 { return (27, 1); }
    if byte == 33 { return (28, 1); }
    if byte == 126 { return (29, 1); }
    if byte == 46 { return (38, 1); }
    if byte == 91 { return (39, 1); }
    if byte == 93 { return (40, 1); }
    if byte == 64 { return (67, 1); }
    if byte == 35 { return (71, 1); }
    if byte == 63 { return (84, 1); }
    return (0, 1);
}

pub fn annotation_word(word: &[u8]) i64 {
    let key_1: [u8; 9] = [100, 97, 116, 97, 115, 116, 97, 99, 107];
    if word.content_eq(&key_1[..]) { return 1; }
    let key_2: [u8; 12] = [115, 116, 97, 99, 107, 95, 114, 101, 103, 105, 111, 110];
