    if word.content_eq(&key_8[..]) { return 8; }
    let key_9: [u8; 6] = [114, 101, 115, 117, 108, 116];
    if word.content_eq(&key_9[..]) { return 9; }
    let key_10: [u8; 4] = [115, 105, 122, 101];
    if word.content_eq(&key_10[..]) { return 10; }
    let key_11: [u8; 17] = [114, 101, 103, 105, 111, 110, 95, 115, 116, 97, 99, 107, 95, 115, 105, 122, 101];
    if word.content_eq(&key_11[..]) { return 11; }
    let key_12: [u8; 11] = [114, 101, 103, 105, 111, 110, 95, 115, 105, 122, 101];
    if word.content_eq(&key_12[..]) { return 12; }
    let key_13: [u8; 17] = [114, 101, 99, 108, 97, 105, 109, 95, 116, 104, 114, 101, 115, 104, 111, 108, 100];
    if word.content_eq(&key_13[..]) { return 13; }
    let key_14: [u8; 24] = [114, 101, 103, 105, 111, 110, 95, 114, 101, 99, 108, 97, 105, 109, 95, 116, 104, 114, 101, 115, 104, 111, 108, 100];
    if word.content_eq(&key_14[..]) { return 14; }
    let key_15: [u8; 8] = [109, 97, 120, 95, 115, 105, 122, 101];
    if word.content_eq(&key_15[..]) { return 15; }
    let key_16: [u8; 5] = [99, 111, 117, 110, 116];
    if word.content_eq(&key_16[..]) { return 16; }
    let key_17: [u8; 1] = [75];
    if word.content_eq(&key_17[..]) { return 17; }
    let key_18: [u8; 1] = [77];
    if word.content_eq(&key_18[..]) { return 18; }
    let key_19: [u8; 1] = [71];
    if word.content_eq(&key_19[..]) { return 19; }
    let pool_key: [u8; 4] = [80, 111, 111, 108];
    if word.content_eq(&pool_key[..]) { return 20; }
    let new_key: [u8; 3] = [110, 101, 119];
    if word.content_eq(&new_key[..]) { return 21; }
    let try_key: [u8;3]=[116,114,121];
    if word.content_eq(&try_key[..]) { return 33; }
    let annotation_27: [u8; 4] = [116, 114, 117, 101];
    if word.content_eq(&annotation_27[..]) { return 27; }
    let annotation_26: [u8; 1] = [67];
    if word.content_eq(&annotation_26[..]) { return 26; }
    let annotation_25: [u8; 16] = [97, 115, 121, 110, 99, 95, 112, 111, 111, 108, 95, 115, 105, 122, 101, 115];
    if word.content_eq(&annotation_25[..]) { return 25; }
    let annotation_24: [u8; 9] = [100, 105, 114, 101, 99, 116, 105, 118, 101];
