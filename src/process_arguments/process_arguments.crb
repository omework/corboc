use bootstrap::verify::type_violation;
use bootstrap::checked_state::record as record_checked;
use bootstrap::verify::{violation_site};
use bootstrap::places::scalar_place;
use bootstrap::loans::{live_roots,loan_conflict};
use bootstrap::signatures::shared_result_member;
use bootstrap::declarations::{verification_field,nominal_declaration};
use bootstrap::model::{AstNode, StaticNode, CheckedValue, result_type, result_payload};
use bootstrap::scalar::{is_integer, pointer_integer_type};
use bootstrap::verify::{verify_expr, violation};

pub fn argument_text_type() -> i64 { 2000138 }
pub fn argument_list_type() -> i64 { 2000139 }

pub fn shared_text_annotation(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) -> bool {
    if annotation == 0 || source[nodes[annotation].start] != 38 { return false; }
    let referent = graph[annotation].first_child;
    if referent == 0 || graph[referent].first_child != 0 { return false; }
    let spelling: [u8; 3] = [115,116,114];
    let name = &source[nodes[referent].name_start..nodes[referent].name_end];
    if !name.content_eq(&spelling[..]) { return false; }
    let mut at = nodes[annotation].start + 1;
    while at < nodes[referent].start {
        if source[at] > 32 { return false; }
        at += 1;
    }
    true
}

pub fn argument_list_annotation(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) -> bool {
    let list = graph[annotation].first_child;
    let element = graph[list].first_child;
    let text = graph[element].first_child;
    if text == 0 || graph[text].first_child != 0 || graph[element].next_sibling != 0
        || source[nodes[annotation].start] != 38 || source[nodes[list].start] != 91
        || source[nodes[element].start] != 38 { return false; }
    let string: [u8; 3] = [115,116,114];
    let name = &source[nodes[text].name_start..nodes[text].name_end];
    if !name.content_eq(&string[..]) { return false; }
    let mut cursor = nodes[annotation].start + 1;
    while cursor < nodes[list].start {
        if source[cursor] > 32 { return false; }
        cursor = cursor + 1;
    }
    cursor = nodes[element].start + 1;
    while cursor < nodes[text].start {
        if source[cursor] > 32 { return false; }
        cursor = cursor + 1;
    }
    true
}

pub fn is_process_arguments_call(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], node: u64) -> bool {
    let name = graph[node].first_child;
    if nodes[node].kind != 15 || nodes[name].kind != 36 || graph[name].next_sibling != 0 { return false; }
    let spelling: [u8; 21] = [114,117,110,116,105,109,101,58,58,112,114,111,99,101,115,115,95,97,114,103,115];
    let actual = &source[nodes[name].start..nodes[name].end];
    actual.content_eq(&spelling[..])
}

pub fn is_process_arguments_result(ty: i64) -> bool {
    result_type(copy(ty)) && result_payload(copy(ty), true) == argument_list_type()
        && result_payload(ty, false) > 3000000
}

pub fn read_argument_value(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], point: u64, destination: u64, expected: i64, mode: i64) -> i64 {
    let base = graph[point].first_child;
    if nodes[base].kind != 7 { return 0; }
    let binding = graph[base].binding;
    let ty = values[binding].ty;
    if ty != argument_list_type() && ty != argument_text_type() { return 0; }
    if values[binding].state != 1 { return 0 - violation_site(6, nodes[base].start, 399); }
    if mode >= 2 { return -9; }
    let index = graph[base].next_sibling;
    if nodes[point].kind == 18 && ty == argument_list_type() {
        if nodes[index].kind == 46 { return -9; }
        let checked = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(index), 0, 0);
        if checked < 0 { return checked; }
        if !is_integer(checked) || (expected != 0 && expected != argument_text_type()) {
            return 0 - violation_site(1, nodes[index].start, 400);
        }
        return argument_text_type();
    }
    if nodes[point].kind != 16 || index != 0 { return 0; }
    let len: [u8; 3] = [108,101,110];
    let bytes: [u8; 8] = [97,115,95,98,121,116,101,115];
    let byte_len: [u8; 8] = [98,121,116,101,95,108,101,110];
    let member = &source[nodes[point].name_start..nodes[point].name_end];
    if (ty == argument_list_type() && member.content_eq(&len[..]))
        || (ty == argument_text_type() && member.content_eq(&byte_len[..])) {
        let result = pointer_integer_type();
        if expected != 0 && expected != result { return 0 - type_violation(nodes[point].start,expected,result,401); }
        return result;
    }
    if ty == argument_text_type() && member.content_eq(&bytes[..]) && destination != 0 {
        // Process argument storage lives independently of either descriptor.
        values[destination] = CheckedValue{ ty: 744, state: 1, mutable: false,
            target: if values[binding].target==0{copy(destination)}else{values[binding].target}, loan_parent: values[binding].loan_parent, origin_call: 0, writable: false }; record_checked(&values[0..values.len()],destination);
        return 744;
    }
    return 0;
}

/// Checks an immutable UTF-8 descriptor without losing its external storage root.
/// Zero denotes an expression outside this text path; negative values are diagnostics.
pub fn check_text(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],values:&mut [CheckedValue],expression:u64,mode:i64)->i64 {
    let kind=nodes[expression].kind;
    let child=graph[expression].first_child;
    if kind==19{return check_text(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],child,mode);}
    if kind==9 && source[nodes[expression].start]==34 {
        if mode==2{return 0-violation_site(5, nodes[expression].start, 402);}
        values[expression] = CheckedValue{ty:2000138,state:1,mutable:false,target:0,loan_parent:0,origin_call:0,writable:false}; record_checked(&values[0..values.len()],expression);return 2000138;
    }
    if kind==7 {
        let binding=graph[expression].binding;
        if values[binding].ty!=2000138{return 0;}
        if values[binding].state!=1{return 0-violation_site(6, nodes[expression].start, 403);}
        if mode==2{return 0-violation_site(5, nodes[expression].start, 404);}
        let root=values[binding].target;let parent=values[binding].loan_parent;let origin=values[binding].origin_call;let mutable=values[binding].mutable;
        if root!=0 && !live_roots(&values[0..values.len()],&graph[0..graph.len()],copy(binding)){return 0-violation_site(4, nodes[expression].start, 405);}
        values[expression] = CheckedValue{ty:2000138,state:1,mutable:false,target:copy(root),loan_parent:copy(parent),origin_call:copy(origin),writable:false}; record_checked(&values[0..values.len()],expression);
        if mode==1 || mode==3{values[binding] = CheckedValue{ty:2000138,state:2,mutable:mutable,target:root,loan_parent:parent,origin_call:origin,writable:false}; record_checked(&values[0..values.len()],binding);}
        return 2000138;
    }
    if kind==17 {
        let (ty,holder,field)=scalar_place(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],copy(expression));
        if ty<0{return 0;}if ty!=2000138{return 0;}
        let owner=if values[holder].ty==734{values[holder].target}else{copy(holder)};
        let member=shared_result_member(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&values[0..values.len()],copy(owner),copy(field),0);
        let mut root:u64=0;let mut parent:u64=0;
        if member!=0{root=values[member].target;parent=values[member].loan_parent;}
        else if nodes[owner].kind==3 {
            root=graph[field].first_child;
            values[root] = CheckedValue{ty:5018,state:1,mutable:false,target:owner,loan_parent:0,origin_call:copy(field),writable:false}; record_checked(&values[0..values.len()],root);
        }else{return -9;}
        if mode==2{return 0-violation_site(5, nodes[expression].start, 406);}
        values[expression] = CheckedValue{ty:2000138,state:1,mutable:false,target:root,loan_parent:parent,origin_call:field,writable:false}; record_checked(&values[0..values.len()],expression);return 2000138;
    }
    if kind!=13 || graph[expression].mutable{return 0;}
    let base=graph[child].first_child;
    let range=graph[base].next_sibling;
    if nodes[child].kind!=18 || nodes[range].kind!=46{return 0;}
    let mut text=check_text(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],copy(base),0);
    if text<0{return text;}
    let binding=graph[base].binding;
    if text==0 && nodes[base].kind==7 && values[binding].ty==297 {
        if values[binding].state!=1 || values[values[binding].target].state!=1{return 0-violation_site(4, nodes[base].start, 407);}
        let conflict=loan_conflict(&nodes[0..nodes.len()],&values[0..values.len()],&graph[0..graph.len()],copy(binding),copy(expression),false);
        if conflict!=0{return if conflict>0{0-violation_site(5, nodes[expression].start, 408)}else{-9};}
        values[base] = CheckedValue{ty:2000138,state:1,mutable:false,target:binding,loan_parent:0,origin_call:0,writable:false}; record_checked(&values[0..values.len()],base);text=2000138;
    }
    if text==0{return 0;}
    let mut bound=graph[range].first_child;
    while bound!=0 {
        let actual=verify_expr(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],copy(bound),0,0);
        if actual<0{return actual;}if !is_integer(actual){return 0-violation_site(1, nodes[bound].start, 409);}
        bound=graph[bound].next_sibling;
    }
    let root=values[base].target;let parent=values[base].loan_parent;let origin=values[base].origin_call;
    values[expression] = CheckedValue{ty:2000138,state:1,mutable:false,target:root,loan_parent:parent,origin_call:origin,writable:false}; record_checked(&values[0..values.len()],expression);return text;
}

fn text_field(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],layout:u64,expression:u64,depth:u64)->u64 {
    if expression==0 || depth>=128{return 0;}
    let kind=nodes[expression].kind;
    if kind==7{return text_field(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],layout,graph[graph[expression].binding].initializer,depth+1);}
    if kind==13 || kind==18 || kind==19 || kind==14{return text_field(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],layout,graph[expression].first_child,depth+1);}
    if kind==17{return verification_field(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],layout,expression);}0
}

/// Names a shared text field only when every Some return forwards that same field.
/// The returned bytes are then independent of the mutable cursor descriptor.
pub fn returned_text_field(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],function:u64)->u64 {
    let formal=graph[function].first_child;let output=graph[formal].next_sibling;let body=graph[output].next_sibling;
    let layout=nominal_declaration(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],nodes[function].parent);
    if nodes[formal].kind!=3 || nodes[body].kind!=2 || nodes[layout].kind!=28{return 0;}
    let some:[u8;4]=[83,111,109,101];let mut selected:u64=0;let mut at=body+1;
    while at<nodes.len() as u64 && nodes[at].start<nodes[body].end {
        let first=graph[at].first_child;
        if nodes[at].kind==15 && nodes[first].kind==7 && graph[first].binding==0 {
            let name=&source[nodes[first].name_start..nodes[first].name_end];
            if name.content_eq(&some[..]) {
                let field=text_field(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],copy(layout),graph[first].next_sibling,0);
                if field==0 || (selected!=0 && selected!=field){return 0;}selected=field;
            }
        }at=at+1;
    }selected
}

/// Finds the STD implementation behind the native text convenience method.
pub fn split_callee(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],call:u64)->u64 {
    if nodes[call].kind!=16{return 0;}
    let split:[u8;5]=[115,112,108,105,116];let name=&source[nodes[call].name_start..nodes[call].name_end];if !name.content_eq(&split[..]){return 0;}
    let helper:[u8;18]=[95,95,99,111,114,98,111,95,116,101,120,116,95,115,112,108,105,116];
    let mut function=graph[0].first_child;
    while function!=0{let spelling=&source[nodes[function].name_start..nodes[function].name_end];if nodes[function].kind==1 && spelling.content_eq(&helper[..]){return function;}function=graph[function].next_sibling;}0
}

/// Auto-borrows the native receiver; explicit ordinary arguments retain their usual move behavior.
pub fn split_receiver(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],values:&mut [CheckedValue],call:u64)->i64 {
    let receiver=graph[call].first_child;let binding=graph[receiver].binding;
    if nodes[receiver].kind==7 && values[binding].ty==297 {
        if values[binding].state!=1 || values[values[binding].target].state!=1{return 0-violation_site(4, nodes[receiver].start, 410);}
        let conflict=loan_conflict(&nodes[0..nodes.len()],&values[0..values.len()],&graph[0..graph.len()],copy(binding),copy(receiver),false);if conflict!=0{return if conflict>0{0-violation_site(5, nodes[receiver].start, 411)}else{-9};}
        values[receiver] = CheckedValue{ty:2000138,state:1,mutable:false,target:binding,loan_parent:0,origin_call:0,writable:false}; record_checked(&values[0..values.len()],receiver);return 2000138;
    }
    check_text(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],receiver,0)
}

/// Identifies the existing TX8 byte-to-text validation primitive.
pub fn is_utf8_call(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], node: u64) -> bool {
    if nodes[node].kind != 15 { return false; }
    let callee = graph[node].first_child;
    if nodes[callee].kind != 36 { return false; }
    let spelling = &source[nodes[callee].start..nodes[callee].end];
    let name: [u8; 14] = [115,116,114,58,58,102,114,111,109,95,117,116,102,56];
    spelling.content_eq(&name[..])
}
