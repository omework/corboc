use bootstrap::model::AstNode;
use bootstrap::semantic_diagnostics::end as semantic_end;
use bootstrap::semantic_diagnostics::describe as semantic_describe;
// SPDX-License-Identifier: MIT OR Apache-2.0
//! Original-source diagnostic provenance and terminal rendering. Native storage
//! is bounded by the existing 4 MiB / 256-file frontend limits; no heap is used.
//! The serial compiler driver owns this context and resets it for every check.

/// Trusted storage/I/O boundary; pointers are consumed only inside this call.
fn control(op:i64,a:usize,b:usize,c:usize,d:usize,input:&[u8],path:&[u8],offsets:&[u64])->bool {
    let mut result:bool=false;
    @unchecked { @c(includes={"stdio.h","stdint.h","string.h"}) {
/* The controller owns bounded copies, never pointers into expired Corbo scopes.
 * stage_base is only consulted between stage_begin and stage_finish. */
#define DIAG_CAP 4194304u
#define DIAG_APPROX 0x80000000u
#define DIAG_INDEX 0x7fffffffu
static struct {
    bool enabled, stage, reported;
    size_t original_len, current_len, files, parse_at, parse_root, parse_display;
    int parse_code;
    uintptr_t stage_base;
    size_t stage_len;
    int last_kind, last_code;
    size_t last_at;
    unsigned char original[DIAG_CAP+1];
    uint32_t current[DIAG_CAP+1], next[DIAG_CAP+1];
    uint32_t starts[256], ends[256];
    char paths[256][4096];
    char semantic[4096];size_t semantic_at;
    uint32_t related[8];uint64_t related_kind[8];size_t related_count;
    bool type_approximate;
} state;
int operation=(int)${op};
uintptr_t a=(uintptr_t)${a},b=(uintptr_t)${b},c=(uintptr_t)${c},d=(uintptr_t)${d};
if(operation==2){a=(uintptr_t)(${path}).data;b=(${path}).len;c=(uintptr_t)(${input}).data;d=(${input}).len;}
if(operation==3){a=(uintptr_t)(${input}).data;b=(${input}).len;}
if(operation==4){b=(uintptr_t)(${input}).data;c=(${input}).len;}
if(operation==6)c=(${offsets}).len?(uintptr_t)(${offsets}).data:0;
if(operation==12||operation==13){a=(uintptr_t)(${path}).data;b=(${path}).len;}
bool fallback=false;
do {
    if(operation==0){state.enabled=a!=0;${result}=true;break;}
    if(operation==15){${result}=state.enabled;break;}
    // Source provenance is also needed for runtime checks in raw emit modes.
    // Human diagnostic emission remains explicitly enabled and protocol-compatible.
    if(!state.enabled && !(operation>=1&&operation<=6) && operation!=11 && operation!=18 && operation!=31)break;
    ${result}=true;
    if(operation==1){
        state.original_len=state.current_len=state.files=state.parse_at=state.parse_root=0;
        state.stage=state.reported=false;state.stage_base=0;state.parse_code=0;state.parse_display=0;
        state.last_kind=state.last_code=0;state.last_at=SIZE_MAX;state.semantic[0]=0;state.related_count=0;break;
    }
    if(operation==2){
        if(state.files>=256||d>DIAG_CAP-state.original_len){${result}=false;break;}
        size_t index=state.files++,start=state.original_len;
        size_t path_len=b;if(path_len&&((const char*)a)[path_len-1]==0)--path_len;
        if(path_len>4095)path_len=4095;
        memcpy(state.paths[index],(void*)a,path_len);state.paths[index][path_len]=0;
        state.starts[index]=(uint32_t)start;state.ends[index]=(uint32_t)(start+d);
        memcpy(state.original+start,(void*)c,d);
        for(size_t i=0;i<d;++i)state.current[start+i]=(uint32_t)(start+i+1);
        state.original_len+=d;state.current_len=state.original_len;break;
    }
    if(operation==3){
        state.stage=true;state.stage_base=a;state.stage_len=b;
        memset(state.next,0,sizeof(state.next));break;
    }
    if(operation==4){
        if(!state.stage||b<state.stage_base||b-state.stage_base>state.stage_len||c>state.stage_len-(b-state.stage_base)||a>DIAG_CAP||c>DIAG_CAP-a)break;
        memcpy(state.next+a,state.current+(b-state.stage_base),c*sizeof(uint32_t));break;
    }
    if(operation==5){
        if(!state.stage||a>d||d>DIAG_CAP||b>state.current_len)break;
        size_t incoming=c>b?c-b:0,outgoing=d-a;
        for(size_t i=0;i<outgoing;++i){size_t old=b+(incoming==outgoing?i:0);
            state.next[a+i]=old<state.current_len?state.current[old]:0;}
        break;
    }
    if(operation==6){
        if(!state.stage||b>DIAG_CAP){${result}=false;break;}
        if(c){const uint64_t *offsets=(const uint64_t*)c;
            for(size_t old=0;old<d&&old<state.current_len;++old){uint64_t mapped=offsets[old];
                if((mapped||old==0)&&mapped<b&&!state.next[mapped]&&state.current[old])state.next[mapped]=state.current[old]|DIAG_APPROX;
            }
        }
        uint32_t prior=0;
        for(size_t i=0;i<b;++i)if(state.next[i]){prior=state.next[i];break;}
        for(size_t i=0;i<b;++i){if(state.next[i])prior=state.next[i];else if(prior)state.next[i]=prior|DIAG_APPROX;}
        memcpy(state.current,state.next,b*sizeof(uint32_t));state.current_len=b;
        state.stage=false;state.stage_base=0;state.stage_len=0;break;
    }
    if(operation==31){
        unsigned char *output=(unsigned char*)(${input}).data;size_t capacity=(${input}).len;
        if(!capacity)break;
        uint32_t encoded=a<state.current_len?state.current[a]:0;
        size_t at=encoded?((encoded&DIAG_INDEX)-1):SIZE_MAX,file=0;
        while(file<state.files&&at>=state.ends[file])++file;
        int length=0;
        if(file<state.files&&at>=state.starts[file]){
            size_t line=1,column=1;
            for(size_t i=state.starts[file];i<at;++i){unsigned char ch=state.original[i];if(ch=='\n'){++line;column=1;}else if(ch=='\t')column+=4-((column-1)%4);else if((ch&0xc0)!=0x80)++column;}
            length=snprintf((char*)output,capacity,"%s:%zu:%zu%s",state.paths[file],line,column,(encoded&DIAG_APPROX)?" (generated-source anchor)":"");
        }else length=snprintf((char*)output,capacity,"source byte %zu",(size_t)a);
        if(length<0)length=0;if((size_t)length>=capacity)length=(int)capacity-1;
        output[length]=0;break;
    }
    if(operation==30){
        state.semantic_at=a;state.related_count=0;state.type_approximate=false;
        size_t input_length=(${input}).len,pos=0,i=0;const uint8_t *input=(${input}).data;
        while(i<input_length&&pos+1<sizeof state.semantic){
            if(input[i]==31){
                ++i;size_t start=0,end=0;
                while(i<input_length&&input[i]>='0'&&input[i]<='9')start=start*10+(input[i++]-'0');
                if(i<input_length&&input[i]==':')++i;
                while(i<input_length&&input[i]>='0'&&input[i]<='9')end=end*10+(input[i++]-'0');
                if(i<input_length&&input[i]==31)++i;
                uint32_t origin=start<state.current_len?state.current[start]:0;
                size_t old=origin?((origin&DIAG_INDEX)-1):state.original_len;
                if(origin&DIAG_APPROX)state.type_approximate=true;
                if(old<state.original_len){
                    while(old<state.original_len&&pos+1<sizeof state.semantic){uint8_t ch=state.original[old];
                        if(!((ch>='a'&&ch<='z')||(ch>='A'&&ch<='Z')||(ch>='0'&&ch<='9')||ch=='_'))break;
                        state.semantic[pos++]=(char)ch;++old;
                    }
                }else{const char *unknown="unresolved type";while(*unknown&&pos+1<sizeof state.semantic)state.semantic[pos++]=*unknown++;state.type_approximate=true;}
                (void)end;
            }else state.semantic[pos++]=(char)input[i++];
        }
        state.semantic[pos]=0;
        for(size_t n=0;n+1<(${offsets}).len&&state.related_count<8;n+=2){
            uint64_t point=(${offsets}).data[n],kind=(${offsets}).data[n+1];
            if(point==UINT64_MAX)break;
            uint32_t origin=point<state.current_len?state.current[point]:0;if(!origin)continue;
            bool duplicate=false;
            for(size_t j=0;j<state.related_count;++j)if(state.related[j]==origin&&state.related_kind[j]==kind)duplicate=true;
            if(!duplicate){size_t j=state.related_count++;state.related[j]=origin;state.related_kind[j]=kind;}
        }
        break;
    }
    if(operation==8){if(a>state.parse_at){state.parse_at=a;state.parse_code=0;state.parse_display=a;}break;}
    if(operation==19){
        if(a<state.parse_at)break;
        state.parse_at=a;state.parse_display=a;state.parse_code=(int)b;
        break;
    }
    if(operation==9){state.parse_at=state.parse_root=state.parse_display=0;state.parse_code=0;break;}
    if(operation==11){state.stage=false;state.stage_base=0;state.stage_len=0;break;}
    if(operation==16){state.parse_root=a;break;}
    if(operation==18){
        if(!state.stage||a>b||b>DIAG_CAP)break;
        while(a<b){--b;uint32_t saved=state.next[a];state.next[a]=state.next[b];state.next[b]=saved;++a;}break;
    }
    if(operation==12){
        size_t n=b;if(n&&((const char*)a)[n-1]==0)--n;
        const char *message=c==12?"invalid package manifest or dependency declaration":"cannot read this compiler input";
        fprintf(stderr,"%.*s: error[E%04zu]: %s\n",(int)n,(const char*)a,(size_t)c,message);
        state.reported=true;break;
    }
    if(operation==13){
        state.stage=false;state.stage_base=0;state.stage_len=0;
        if(!c||state.reported)break;
        if(state.files){operation=7;a=5;b=c;c=0;fallback=true;}
        else{fprintf(stderr,"%.*s: error[E%04zu]: %s\n",(int)b,(const char*)a,(size_t)c,
                c==12?"invalid package manifest or dependency declaration":c==13?"cannot resolve an import or dependency":c==4?"compiler input or workspace limit exceeded":"compilation failed before a source location was available");
            state.reported=true;break;}
    }
    if(operation==10){
        operation=7;a=2;b=state.parse_code?state.parse_code:7;c=state.parse_code?state.parse_display:state.parse_at;
        uint32_t root_map=state.parse_root<state.current_len?state.current[state.parse_root]:0;
        uint32_t error_map=c<state.current_len?state.current[c]:0;
        if(root_map&&error_map){size_t root_point=(root_map&DIAG_INDEX)-1,error_point=(error_map&DIAG_INDEX)-1;
            size_t root_file=0,error_file=0;
            while(root_file<state.files&&root_point>=state.ends[root_file])++root_file;
            while(error_file<state.files&&error_point>=state.ends[error_file])++error_file;
            if(root_file!=error_file){b=17;c=state.parse_root;}
        }
    }
    if(operation!=7)break;
    int kind=(int)a,code=(int)b;size_t point=c;
    if(state.reported&&kind==4)break;
    if(state.reported&&state.last_kind==kind&&state.last_code==code&&state.last_at==point)break;
    state.reported=true;state.last_kind=kind;state.last_code=code;state.last_at=point;
    uint32_t mapped=point<state.current_len?state.current[point]:0;
    bool approximate=fallback||!mapped||(mapped&DIAG_APPROX)!=0;
    size_t original=mapped?((mapped&DIAG_INDEX)-1):0;
    size_t unit=0;
    while(unit<state.files&&original>=state.ends[unit])++unit;
    if(unit==state.files){unit=0;original=state.files?state.starts[0]:0;approximate=true;}
    const char *message="compiler could not verify this construct";
    if(kind==1){
        const char *rules[]={"","value is undefined, uninitialized, or does not match the required type","cleanup responsibility is not unique","copy, move, or borrow does not match the required value form","cannot prove that the borrowed target or allocation source remains valid","access requires mutation permission or the required synchronization","value is unavailable on this path (for example, after a move or drop)","cleanup or storage reuse violates a live dependency","call, capture, or result does not satisfy its inferred contract"};
        if(code>=1&&code<=8)message=rules[code];
    }else if(kind==2){
        if(code==17)message="declaration is not closed before the end of this source file";
        else if(code==100)message="expected a binding name after let or let mut";
        else if(code==101)message="expected '=' and an initializer for this binding";
        else if(code==102)message="expected '{' to begin a block";
        else if(code==104)message="expected 'in' after the for-loop binding";
        else if(code==105)message="ref() and mut_ref() take no arguments";
        else if(code==106)message="expected a for-loop binding name or a tuple pattern such as (offset, state)";
        else if(code==107)message="expected ',' or ')' after this tuple-pattern binding";
        else if(code==108)message="a tuple pattern requires at least two bindings";
        else if(code==109)message="expected a field name or decimal tuple index after '.'";
        else if(code==111)message="Self is only valid inside an impl block";
        else if(code==112)message="Self already includes the enclosing impl type arguments";
        else if(code==110)message="put mut on an individual tuple binding, as in for (mut first, second)";
        else if(code==113)message="expected a function name after fn";
        else if(code==114)message="expected '(' after the function name";
        else if(code==115)message="expected a parameter name or a receiver such as &self";
        else if(code==116)message="expected ':' and an explicit parameter type";
        else if(code==117)message="expected ',' or ')' after this parameter";
        else if(code==118)message="expected a return type after '->'";
        else if(code==119)message="expected ';' after this function signature";
        else if(code==103)message="expected ';' after this expression, or '}' to return its value";
        else message="invalid syntax near this token";
    }
    else if(kind==3)message=(code==12||(code==3&&original<state.original_len&&(state.original[original]==10||state.original[original]==13)))?"unterminated string literal before end of line":"invalid token or string escape";
    else if(kind==4||code==9)message="this construct is not supported by the compiler yet";
    else if(code==13)message="cannot resolve this import or qualified name";
    else if(code==14)message="duplicate declaration or import name";
    else if(code==15)message="invalid declaration or missing synchronous main entry point";
    else if(code==4)message="frontend source, token or workspace capacity exceeded";
    else if(code==8)message="a language-rule check failed; detailed failure context was not retained";
    const char *semantic_detail=NULL;
    bool semantic=(kind==1||kind==4)&&state.semantic[0]&&state.semantic_at==point;
    if(semantic){message=state.semantic;char *newline=strchr(state.semantic,'\n');if(newline){*newline=0;semantic_detail=newline+1;}}
    const char *category=kind==1?"rule violation":(kind==2||kind==3)?"syntax error":kind==4?"compiler limitation":code==8?"rule violation":(code==3||code==7)?"syntax error":(code==9||code==4)?"compiler limitation":code==12?"configuration error":(code==13||code==14)?"resolution error":"compilation error";
    if(!state.files){fprintf(stderr,"corboc: error[E%04d]: %s: %s\n",code,category,message);break;}
    size_t start=state.starts[unit],end=state.ends[unit],line=1,column=1,line_start=start;
    if(original<start||original>=end){original=start;approximate=true;}
    for(size_t i=start;i<original;++i){unsigned char ch=state.original[i];
        if(ch=='\n'){++line;column=1;line_start=i+1;}
        else if(ch=='\t')column+=4-((column-1)%4);
        else if((ch&0xc0)!=0x80)++column;
    }
    size_t line_end=original;while(line_end<end&&state.original[line_end]!='\n'&&state.original[line_end]!='\r')++line_end;
    if(kind==1)fprintf(stderr,"%s:%zu:%zu: error[N%d]: %s: %s\n",state.paths[unit],line,column,code,category,message);
    else fprintf(stderr,"%s:%zu:%zu: error[E%04d]: %s: %s\n",state.paths[unit],line,column,kind==4?9:code,category,message);
    fprintf(stderr," %5zu | ",line);size_t shown=1;
    for(size_t i=line_start;i<line_end;++i){unsigned char ch=state.original[i];
        if(ch=='\t'){size_t spaces=4-((shown-1)%4);while(spaces--){fputc(' ',stderr);++shown;}}
        else{fputc(ch,stderr);if((ch&0xc0)!=0x80)++shown;}
    }
    fputs("\n       | ",stderr);for(size_t i=1;i<column;++i)fputc(' ',stderr);fputc('^',stderr);
    size_t width=1;while(original+width<line_end&&width<32){unsigned char ch=state.original[original+width];
        if(!((ch>='a'&&ch<='z')||(ch>='A'&&ch<='Z')||(ch>='0'&&ch<='9')||ch=='_'))break;
        fputc('~',stderr);++width;
    }
    fputc('\n',stderr);
    if(kind==2||kind==3){
        if(point>=state.current_len)fputs("       = found: end of input\n",stderr);
        else if(original<end){
            size_t token_end=original+1;
            unsigned char initial=state.original[original];
            if((initial>='a'&&initial<='z')||(initial>='A'&&initial<='Z')||(initial>='0'&&initial<='9')||initial=='_')
                while(token_end<line_end&&token_end-original<64){unsigned char ch=state.original[token_end];if(!((ch>='a'&&ch<='z')||(ch>='A'&&ch<='Z')||(ch>='0'&&ch<='9')||ch=='_'))break;++token_end;}
            if(initial=='\n'||initial=='\r')fputs("       = found: end of line\n",stderr);
            else fprintf(stderr,"       = found: `%.*s`\n",(int)(token_end-original),state.original+original);
        }
    }
    if(kind==4||(kind==5&&code==9))fputs("       = note: this is a compiler implementation limit, not a demonstrated language-rule violation\n",stderr);
    if(semantic_detail&&*semantic_detail)fprintf(stderr,"%s\n",semantic_detail);
    if(semantic&&state.type_approximate)fputs("       = note: an inferred type name uses a generated-source anchor\n",stderr);
    if(semantic){
        for(size_t note=0;note<state.related_count;++note){
            uint32_t encoded=state.related[note];size_t at=(encoded&DIAG_INDEX)-1;
            if(encoded==mapped)continue;
            size_t file=0;while(file<state.files&&at>=state.ends[file])++file;
            if(file==state.files||at<state.starts[file])continue;
            size_t ln=1,col=1,begin=state.starts[file];
            for(size_t i=begin;i<at;++i){uint8_t ch=state.original[i];if(ch=='\n'){++ln;col=1;begin=i+1;}else if(ch=='\t')col+=4-((col-1)%4);else if((ch&0xc0)!=0x80)++col;}
            size_t finish=at;while(finish<state.ends[file]&&state.original[finish]!='\n'&&state.original[finish]!='\r')++finish;
            const char *label=state.related_kind[note]==1?"ownership moved here":state.related_kind[note]==2?"value destroyed here":state.related_kind[note]==3?"borrow created here":state.related_kind[note]==4?"borrowed target declared here":state.related_kind[note]==5?"value declared here":state.related_kind[note]==6?"conflicting dependency originates here":state.related_kind[note]==8?"parameter type required here":state.related_kind[note]==12?"value consumed here":state.related_kind[note]==13?"required field declared here":"another path moves ownership here";
            fprintf(stderr,"%s:%zu:%zu: note: %s%s\n",state.paths[file],ln,col,label,(encoded&DIAG_APPROX)?" (generated-source anchor)":"");
            fprintf(stderr," %5zu | ",ln);size_t display=1;
            for(size_t i=begin;i<finish;++i){uint8_t ch=state.original[i];if(ch=='\t'){size_t spaces=4-((display-1)%4);while(spaces--){fputc(' ',stderr);++display;}}else{fputc(ch,stderr);if((ch&0xc0)!=0x80)++display;}}
            fputs("\n       | ",stderr);for(size_t i=1;i<col;++i)fputc(' ',stderr);fputs("^\n",stderr);
        }
        state.semantic[0]=0;state.related_count=0;
    }
    if(fallback)fputs("       = note: exact failure location unavailable; showing input context\n",stderr);
    else if(approximate)fputs("       = note: generated-code origin; the highlighted location is an enclosing source anchor\n",stderr);
    fflush(stderr);
}while(0);
#undef DIAG_CAP
#undef DIAG_APPROX
#undef DIAG_INDEX
    } }
    result
}


/// Marshal signed diagnostic codes at the trusted native boundary. No language
/// numeric conversion rule is relaxed; these are controller tags, not user data.
fn code_word(value:i64)->usize {
    let mut result:usize=0;
    @unchecked { @c { ${result}=(uintptr_t)${value}; } }
    result
}
/// Scalar controller operations carry empty typed slices, never fabricated pointers.
fn scalar(op:i64,a:usize,b:usize,c:usize,d:usize)->bool {
    let bytes:[u8;0]=[];
    let words:[u64;0]=[];
    control(op,a,b,c,d,&bytes[..],&bytes[..],&words[..])
}
/// Enable user-facing diagnostics while preserving raw machine modes by default.
pub fn diagnostic_enable() { drop(scalar(0,1,0,0,0)); }
/// Reset retained sources/maps for a new compilation; watch never reuses old errors.
pub fn diagnostic_begin() { drop(scalar(1,0,0,0,0)); }
/// Register original text and path using checked slice operands at the native boundary.
pub fn diagnostic_input(path:&[u8],source:&[u8]) {
    let empty:[u64;0]=[];
    drop(control(2,0,0,0,0,source,path,&empty[..]));
}
/// Start a provenance stage while its source buffer is live.
pub fn diagnostic_stage(source:&[u8]) {
    let bytes:[u8;0]=[];let words:[u64;0]=[];
    drop(control(3,0,0,0,0,source,&bytes[..],&words[..]));
}
/// Preserve a directly copied source span, including duplicate specializations.
pub fn diagnostic_copy(start:u64,source:&[u8]) {
    let bytes:[u8;0]=[];let words:[u64;0]=[];
    drop(control(4,start as usize,0,0,0,source,&bytes[..],&words[..]));
}
/// Map rewritten linker names to their original token.
pub fn diagnostic_link(start:u64,old:u64,end:u64,written:u64) {drop(scalar(5,start as usize,old as usize,end as usize,written as usize));}
/// Commit a linked source map after its directly copied spans were registered.
pub fn diagnostic_linked(length:usize) {drop(scalar(6,0,length,0,0));}
/// Compose direct source spans and conservative rewrite anchors.
pub fn diagnostic_rewritten(source:&[u8],offsets:&[u64],old:usize) {
    let empty:[u8;0]=[];
    drop(control(6,0,source.len(),0,old,&empty[..],&empty[..],offsets));
}
/// Render a rule/limitation at its source location; false preserves raw output.
pub fn diagnostic_emit(kind:i64,code:i64,offset:u64)->bool {
    if kind==1 && diagnostic_enabled() {
        let mut message:[u8;4096]=[0;4096];let mut notes:[u64;16]=[18446744073709551615;16];
        let written=semantic_describe(offset,code,&mut message[..],&mut notes[..]);
        if written!=0 {
            let empty:[u8;0]=[];
            drop(control(30,offset as usize,0,0,0,&message[..written],&empty[..],&notes[..]));
        }
    }
    scalar(7,code_word(kind),code_word(code),offset as usize,0)
}
/// Retain parser progress, without reporting speculative parses.
pub fn diagnostic_parse_point(offset:u64) {drop(scalar(8,offset as usize,0,0,0));}
/// Reset parser progress after source rewriting.
pub fn diagnostic_parse_reset() {drop(scalar(9,0,0,0,0));}
/// Emit syntax context only when parsing ultimately fails.
pub fn diagnostic_parse_error() {drop(scalar(10,0,0,0,0));}
/// Explain unreadable inputs and invalid manifests without inventing a token location.
pub fn diagnostic_path(path:&[u8],status:i32) {
    let bytes:[u8;0]=[];let words:[u64;0]=[];
    drop(control(12,0,0,code_word(status as i64),0,&bytes[..],path,&words[..]));
}
/// Explain errors that did not already produce a source diagnostic.
pub fn diagnostic_finish(path:&[u8],status:i32) {
    semantic_end();
    let bytes:[u8;0]=[];let words:[u64;0]=[];
    drop(control(13,0,0,code_word(status as i64),0,&bytes[..],path,&words[..]));
}

/// End a no-op rewrite before checking, without changing its current source map.
pub fn diagnostic_stage_idle() {drop(scalar(11,0,0,0,0));}

/// Keep provenance aligned when closure helpers rotate output text into place.
pub fn diagnostic_reverse(start:u64,end:u64) {drop(scalar(18,start as usize,end as usize,0,0));}
/// Retain the declaration owning a parser failure across original file boundaries.
pub fn diagnostic_parse_root(offset:u64) {drop(scalar(16,offset as usize,0,0,0));}

/// Record the expected syntax at a failed parser position, without emitting during speculation.
/// statement identifies the enclosing expression for unsupported-form explanations.
pub fn diagnostic_parse_expected(offset:u64, expected:usize, statement:u64) {
    drop(scalar(19,offset as usize,expected,statement as usize,0));
}

/// Query the diagnostic mode without changing raw frontend protocols.
pub fn diagnostic_enabled()->bool {scalar(15,0,0,0,0)}

/// Preserve the unsupported construct and declaration owner before returning E0009.
/// This is diagnostic context only: it neither changes a verdict nor claims validity.
pub fn diagnostic_limitation(nodes:&[AstNode],point:u64,reason:&str)->bool {
    if !diagnostic_enabled() { return false; }
    if point>=nodes.len() { return diagnostic_emit(4,9,0); }
    let mut message:[u8;2048]=[0;2048];
    let bytes=reason.as_bytes();
    let mut written:usize=0;
    let output=&mut message[..];
    @unchecked { @c(includes={"stdio.h","stdint.h"}) {
        size_t node=${point},count=(${nodes}).len;
        if(node>=count)node=0;
        int kind=(${nodes}).data[node].f_kind;
        const char *construct=kind==1?"function":kind==35?"async function":kind==3?"parameter":kind==4?"type annotation":kind==5?"binding":kind==6?"return":kind==8?"expression statement":kind==10?"block result":kind==15?"function call":kind==16?"method call":kind==17?"field access":kind==18?"indexed access":kind==21?"assignment":kind==26?"conditional expression":kind==27?"loop":kind==28?"struct":kind==29?"enum":kind==39?"match":kind==49?"implementation":kind==58?"annotation":"expression";
        int length=snprintf((char*)(${output}).data,(${output}).len,"cannot compile this %s: %.*s",construct,(int)(${bytes}).len,(${bytes}).data);
        size_t pos=length>0?(size_t)length:0;if(pos>=(${output}).len)pos=(${output}).len-1;
        size_t owner=node,steps=0;
        while(owner<count&&owner&&steps++<128){
            int owner_kind=(${nodes}).data[owner].f_kind;
            if(owner_kind==1||owner_kind==35||owner_kind==49){
                size_t start=(${nodes}).data[owner].f_name_start,end=(${nodes}).data[owner].f_name_end;
                if(end>start){
                    length=snprintf((char*)(${output}).data+pos,(${output}).len-pos,"\n       = context: %s '\037%llu:%llu\037'",owner_kind==49?"implementation":"function",(unsigned long long)start,(unsigned long long)end);
                    if(length>0){size_t room=(${output}).len-pos;pos+=(size_t)length<room?(size_t)length:room-1;}
                }
            }
            owner=(${nodes}).data[owner].f_parent;
        }
        ${written}=pos;
    } }
    let empty:[u8;0]=[];let notes:[u64;0]=[];
    drop(control(30,nodes[point].start as usize,0,0,0,&message[..written],&empty[..],&notes[..]));
    diagnostic_emit(4,9,nodes[point].start)
}

/// Original-source location for generated abort diagnostics, including raw emit modes.
pub fn runtime_location(offset:u64,output:&mut [u8])->usize {
    let bytes:[u8;0]=[];let words:[u64;0]=[];
    drop(control(31,offset as usize,0,0,0,&output[0..output.len()],&bytes[..],&words[..]));
    let mut length:usize=0;
    while length<output.len() && output[length]!=0{length+=1;}
    length
}
