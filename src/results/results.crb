use bootstrap::checked_state::record as record_checked;
use bootstrap::verify::{violation_site};
use bootstrap::lowering_annotations::annotation_type;
use bootstrap::lowering_types::{wrap_pool,pool_type};
use bootstrap::model::reserve_summary;
use bootstrap::value_summaries::borrowed_record_type;
use bootstrap::process_arguments::{argument_list_annotation, argument_list_type, shared_text_annotation, argument_text_type};
use bootstrap::model::{AstNode, StaticNode, CheckedValue, result_code, result_type, result_payload};
use bootstrap::declarations::nominal_declaration;
use bootstrap::places::{value_record, inline_array, inline_array_type};
use bootstrap::scalar::{verify_primitive, pointer_integer_type};
use bootstrap::verify::{verify_expr, violation};
use bootstrap::ownership::check_owned_struct;
use bootstrap::tasks::copy_task_summary;
use bootstrap::lowering_types::{signed, unsigned, optional, option_code, option_payload};

pub fn unit_result_payload(ty: i64) bool { ty == 10 }

// Keep usize distinct in result identity, even on a 64-bit target.
pub fn scalar_result_payload(ty: i64) i64 {
    if ty>=6000000 && ty<7000000{return ty;}
    if ty == 11 { return pointer_integer_type(); }
    if ty == 2000138 || optional(copy(ty)) { return ty; }
    if ty >= 1 && ty <= 9 { return ty; }
    0
}

// Verification retains its established scalar-Option codes; lowering retains
// canonical Option descriptors. Both denote the same Result arm identity.
pub fn checked_result_payload(ty: i64) i64 {
    if optional(copy(ty)) {
        let inner = option_payload(copy(ty));
        if inner >= 1 && inner <= 9 { return 910 + inner; }
    }
    scalar_result_payload(ty)
}

// Payload admissibility follows the fixed data layout through nominal fields.
pub fn plain_data_type(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64, depth: u64) bool {
    data_payload_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], annotation, depth, false)
}

// Moving a payload may invoke a destructor; unlike replication, it does not
// require that destruction be trivial.
pub fn owned_data_type(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64, depth: u64) bool {
    data_payload_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], annotation, depth, true)
}

fn data_payload_type(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64, depth: u64, destructors: bool) bool {
    if annotation == 0 || depth >= 128 || source[nodes[annotation].start] == 38 { return false; }
    if verify_primitive(&source[0..source.len()], nodes[annotation].name_start, nodes[annotation].name_end) != 0 {
        return graph[annotation].first_child == 0;
    }
    if graph[annotation].first_child != 0 { return false; }
    let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(annotation));
    if nodes[nominal].kind != 28 && nodes[nominal].kind != 29 { return false; }
    let mut member = graph[nominal].first_child;
    while member != 0 {
        let mut field = if nodes[nominal].kind == 29 { graph[member].first_child } else { copy(member) };
        while field != 0 {
            if !data_payload_type(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], graph[field].first_child, depth + 1, destructors) { return false; }
            field = if nodes[nominal].kind == 29 { graph[field].next_sibling } else { 0 };
        }
        member = graph[member].next_sibling;
    }
    if destructors { return true; }
    let mut item = graph[0].first_child;
    let drop_name: [u8; 4] = [100,114,111,112];
    while item != 0 {
        if nodes[item].kind == 49 && nominal_declaration(&source[0..source.len()],
            &nodes[0..nodes.len()], &graph[0..graph.len()], copy(item)) == nominal {
            let mut method = graph[item].first_child;
            while method != 0 {
                let name = &source[nodes[method].name_start..nodes[method].name_end];
                if name.content_eq(&drop_name[..]) { return false; }
                method = graph[method].next_sibling;
            }
        }
        item = graph[item].next_sibling;
    }
    true
}

pub fn payload_type(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) i64 {
    if shared_text_annotation(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(annotation)) { return argument_text_type(); }
    let name = &source[nodes[annotation].name_start..nodes[annotation].name_end];
    let allocation:[u8;1]=[65];
    if name.content_eq(&allocation[..]) && graph[annotation].first_child!=0 && graph[graph[annotation].first_child].next_sibling==0 {
        let element=annotation_type(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],graph[annotation].first_child);
        return wrap_pool(element,true);
    }
    let option: [u8; 6] = [79,112,116,105,111,110];
    let inner = graph[annotation].first_child;
    if name.content_eq(&option[..]) && inner != 0 && graph[inner].next_sibling == 0 {
        let payload = payload_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], inner);
        if payload <= 0 { return 0; }
        return option_code(if payload == 11 { pointer_integer_type() } else { payload });
    }
    let array = inline_array_type(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(annotation));
    if array != 0 { return array; }
    if graph[annotation].first_child != 0 {
        if argument_list_annotation(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], annotation) { return argument_list_type(); }
        return 0;
    }
    let void: [u8; 4] = [86,111,105,100];
    let spelling = &source[nodes[annotation].name_start..nodes[annotation].name_end];
    if source[nodes[annotation].start] == 40 || spelling.content_eq(&void[..]) { return 10; }
    let scalar = verify_primitive(&source[0..source.len()], nodes[annotation].name_start, nodes[annotation].name_end);
    if scalar != 0 {
        let pointer: [u8; 5] = [117,115,105,122,101];
        let spelling = &source[nodes[annotation].name_start..nodes[annotation].name_end];
        if spelling.content_eq(&pointer[..]) { return 11; }
        return scalar;
    }
    let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(annotation));
    if nodes[nominal].kind == 28 {
        if !value_record(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(nominal), 0, true)
            && !borrowed_record_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(nominal), 0) {
            return 0;
        }
    } else if nodes[nominal].kind == 29 {
        if !owned_data_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(annotation), 0) { return 0; }
    } else { return 0; }
    3000000 + signed(nominal)
}

pub fn result_annotation(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], annotation: u64) i64 {
    let name: [u8; 6] = [82,101,115,117,108,116];
    let spelling = &source[nodes[annotation].name_start..nodes[annotation].name_end];
    if !spelling.content_eq(&name[..]) { return 0; }
    let first = graph[annotation].first_child;
    let second = graph[first].next_sibling;
    if first == 0 || second == 0 || graph[second].next_sibling != 0 { return 0; }
    let left = payload_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], first);
    let right = payload_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], second);
    if left <= 0 || right <= 0 { return 0; }
    result_code(left, right)
}

pub fn result_variant(source: &[u8], nodes: &[AstNode], name: u64) i64 {
    let ok: [u8; 2] = [79, 107];
    let err: [u8; 3] = [69, 114, 114];
    let spelling = &source[nodes[name].name_start..nodes[name].name_end];
    if spelling.content_eq(&ok[..]) { return 1; }
    if spelling.content_eq(&err[..]) { return 2; }
    0
}

pub fn construct_result(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], node: u64, expected: i64, variant: i64) i64 {
    if !result_type(copy(expected)) { return -9; }
    let argument = graph[graph[node].first_child].next_sibling;
    if argument == 0 || graph[argument].next_sibling != 0 { return 0 - violation_site(1, nodes[node].start, 437); }
    let payload = result_payload(copy(expected), variant == 1);
    let status = check_envelope_payload(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], &mut values[0..values.len()], copy(argument), copy(payload));
    if status < 0 { return status; }
    if payload>=6000000 && payload<7000000 {
        let slot=reserve_summary(&mut values[0..values.len()],nodes.len() as u64,1);if slot==0{return -9;}
        copy_task_summary(&mut values[0..values.len()],copy(argument),copy(slot),values[argument].ty,false);
        values[node] = CheckedValue{ty:copy(expected),state:1,mutable:false,target:values[argument].target,loan_parent:slot,origin_call:0,writable:false, projection: 0,}; record_checked(&values[0..values.len()],node);
    }else{copy_task_summary(&mut values[0..values.len()], argument, node, copy(expected), false);}
    expected
}

pub fn check_envelope_payload(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], argument: u64, payload: i64) i64 {
    if payload == argument_list_type() { return -9; }
    if payload>=6000000 && payload<7000000 {
        if nodes[argument].kind!=7{return -9;}
        let binding=graph[argument].binding;let ty=values[binding].ty;let root=values[binding].target;
        if bootstrap::pool_results::allocation_type(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],root)!=payload{return 0-violation_site(1, nodes[argument].start, 438);}
        let actual=verify_expr(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&mut values[0..values.len()],argument,ty,1);if actual<0{return actual;}return 0;
    }
    let scalar = checked_result_payload(copy(payload));
    if unit_result_payload(copy(payload)) {
        if nodes[argument].kind != 19 || graph[argument].first_child != 0 {
            return 0 - violation_site(1, nodes[argument].start, 439);
        }
    } else if scalar != 0 || inline_array(copy(payload)) {
        let ty = if scalar != 0 { scalar } else { copy(payload) };
        let actual = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(argument), copy(ty), 1);
        if actual < 0 { return actual; }
        if actual != ty { return 0 - violation_site(1, nodes[argument].start, 440); }
    } else {
        let nominal = unsigned(payload - 3000000);
        let kind: i64 = if nodes[nominal].kind == 29 { 310 } else { 300 };
        if nodes[argument].kind == 37 || nodes[argument].kind == 17 {
            let name = if nodes[graph[argument].first_child].kind == 7 { graph[argument].first_child } else { copy(argument) };
            if nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], name) != nominal {
                return 0 - violation_site(1, nodes[argument].start, 441);
            }
            let actual = check_owned_struct(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(argument), copy(argument));
            if actual < 0 { return actual; }
            if actual != kind { return 0 - violation_site(1, nodes[argument].start, 442); }
        } else if nodes[argument].kind == 15 {
            let actual = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(argument), copy(kind), 1);
            if actual < 0 { return actual; }
            if actual != kind || values[argument].target != 0
                || nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    values[argument].origin_call) != nominal { return 0 - violation_site(1, nodes[argument].start, 443); }
        } else if nodes[argument].kind == 7 {
            let binding = graph[argument].binding;
            let shape = values[binding].origin_call;
            let name = if nodes[shape].kind == 28 || nodes[shape].kind == 29 || nodes[shape].kind == 4
                || nodes[shape].kind == 37 { shape } else { graph[shape].first_child };
            if values[binding].ty != kind || values[binding].target != 0
                || nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], name) != nominal {
                return 0 - violation_site(1, nodes[argument].start, 444);
            }
            let status = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], argument, kind, 1);
            if status < 0 { return status; }
        } else { return -9; }
    }
    0
}
