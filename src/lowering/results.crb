fn lower_result_constructor(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    types: &mut [i64], ctx: &Lowering, node: u64, ty: i64, ok: bool) i64 {
    let operand = graph[graph[node].first_child].next_sibling;
    if operand == 0 || graph[operand].next_sibling != 0 { return -1; }
    let payload = result_payload(copy(ty), copy(ok));
    let scalar = scalar_result_payload(copy(payload));
    let expected = if scalar != 0 { scalar } else { payload };
    let unit = unit_result_payload(copy(expected));
    if !unit {
        let actual = expression(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut types[0..types.len()], ctx, copy(operand), copy(expected));
        if actual != expected { return -1; }
    }
    types[node] = copy(ty);
    if (*ctx).emit {
        declaration(copy(ty), copy(node)); { let code: [u8; 6] = [61,123,48,125,59,10]; byte_text(&code[..]); }
        temporary(copy(node)); { let code: [u8; 12] = [46,108,105,118,101,61,116,114,117,101,59,10]; byte_text(&code[..]); }
        temporary(copy(node));
        if ok { { let code: [u8; 10] = [46,111,107,61,116,114,117,101,59,10]; byte_text(&code[..]); } }
        else { { let code: [u8; 11] = [46,111,107,61,102,97,108,115,101,59,10]; byte_text(&code[..]); } }
        if !unit {
            temporary(node); result_field(ok); character(61); temporary(operand);
            { let code: [u8; 2] = [59,10]; byte_text(&code[..]); }
        }
    }
    ty
}

fn lower_result_match(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], types: &mut [i64],
    ctx: &Lowering, subject: u64, ty: i64, expected: i64, slot: u64) i64 {
    let mut arm = graph[subject].next_sibling;
    let mut common = expected;
    let emit = (*ctx).emit;
    let mut first = true;
    while arm != 0 {
        let pattern = graph[arm].first_child;
        let variant = result_variant(&source[0..source.len()], &nodes[0..nodes.len()], copy(pattern));
        let wildcard = wildcard_pattern(&source[0..source.len()], &nodes[0..nodes.len()], pattern);
        if variant == 0 && !wildcard { return -1; }
        let ok = variant == 1;
        if emit {
            if first && wildcard { { let text: [u8; 2] = [123,10]; byte_text(&text[..]); } }
            else if first {
                { let code: [u8; 3] = [105,102,40]; byte_text(&code[..]); } if !ok { character(33); } temporary(copy(subject)); { let code: [u8; 6] = [46,111,107,41,123,10]; byte_text(&code[..]); }
            } else { { let code: [u8; 6] = [101,108,115,101,123,10]; byte_text(&code[..]); } }
        }
        let binder = graph[pattern].first_child;
        let payload = result_payload(copy(ty), copy(ok));
        if graph[binder].declaration {
            let scalar = scalar_result_payload(copy(payload));
            types[binder] = if scalar != 0 { scalar } else { copy(payload) };
            if emit {
                if (*ctx).poll_body == 0 { c_type(copy(payload)); character(32); }
                local(copy(binder)); character(61); temporary(copy(subject)); result_field(copy(ok)); { let code: [u8; 2] = [59,10]; byte_text(&code[..]); }
                consume(copy(payload), copy(binder), true);
            }
        } else if emit && (*ctx).storage && result_has_nominal_payload(copy(ty)) {
            drop_value(copy(ty), copy(subject), false);
        }
        let arm_type = block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut types[0..types.len()], ctx, graph[pattern].next_sibling, copy(common), copy(slot));
        if arm_type < 0 || (common != 0 && arm_type != 0 && arm_type != common) { return -1; }
        if common == 0 { common = arm_type; }
        if emit {
            if graph[binder].declaration && needs_cleanup(payload, (*ctx).storage) {
                drop_value(types[binder], binder, true);
            }
            { let code: [u8; 2] = [125,10]; byte_text(&code[..]); }
        }
        first = false;
        arm = graph[arm].next_sibling;
    }
    common
}

