    }else{if !optional(copy(inner)) || !optional(copy(outer)){return -1;}payload=option_payload(inner);}
    let scalar=scalar_result_payload(copy(payload));let actual=if scalar!=0{scalar}else{copy(payload)};
    types[node]=copy(actual);
    if emit {
        {let code:[u8;4]=[105,102,40,33];byte_text(&code[..]);}temporary(copy(child));{let code:[u8;1]=[46];byte_text(&code[..]);}
        if result{{let code:[u8;2]=[111,107];byte_text(&code[..]);}}else{{let code:[u8;4]=[115,111,109,101];byte_text(&code[..]);}}{let code:[u8;3]=[41,123,10];byte_text(&code[..]);}
        c_type(copy(outer));{let code:[u8;18]=[32,112,114,111,112,97,103,97,116,105,111,110,95,101,114,114,111,114];byte_text(&code[..]);}number(copy(node));{let code:[u8;6]=[61,123,48,125,59,10];byte_text(&code[..]);}
        if result {
            {let code:[u8;17]=[112,114,111,112,97,103,97,116,105,111,110,95,101,114,114,111,114];byte_text(&code[..]);}number(copy(node));{let code:[u8;28]=[46,108,105,118,101,61,116,114,117,101,59,112,114,111,112,97,103,97,116,105,111,110,95,101,114,114,111,114];byte_text(&code[..]);}number(copy(node));{let code:[u8;15]=[46,112,97,121,108,111,97,100,46,101,114,114,111,114,61];byte_text(&code[..]);}
            if conversion!=0{character(102);number(copy(conversion));character(40);}
            temporary(copy(child));{let code:[u8;14]=[46,112,97,121,108,111,97,100,46,101,114,114,111,114];byte_text(&code[..]);}if conversion!=0{character(41);}{let code:[u8;2]=[59,10];byte_text(&code[..]);}
            temporary(copy(child));{let code:[u8;13]=[46,108,105,118,101,61,102,97,108,115,101,59,10];byte_text(&code[..]);}
        }
        let function=(*ctx).function;let mut root=graph[function].first_child;
        while nodes[root].kind==3 || nodes[root].kind==4{root=graph[root].next_sibling;}
        drop_partial_evaluation(&nodes[0..nodes.len()],&graph[0..graph.len()],&types[0..types.len()],copy(node),(*ctx).storage);
        drop_visible(&nodes[0..nodes.len()],&graph[0..graph.len()],&types[0..types.len()],copy(node),function,true,(*ctx).storage);
        if (*ctx).poll_body==0 {
            unwind_regions(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],copy(node),copy(root));
            if (*ctx).storage{{let code:[u8;18]=[109,101,109,111,114,121,95,99,117,114,115,111,114,40,109,97,114,107];byte_text(&code[..]);}number(root);{let code:[u8;3]=[41,59,10];byte_text(&code[..]);}}
            {let code:[u8;24]=[114,101,116,117,114,110,32,112,114,111,112,97,103,97,116,105,111,110,95,101,114,114,111,114];byte_text(&code[..]);}number(copy(node));{let code:[u8;2]=[59,10];byte_text(&code[..]);}
