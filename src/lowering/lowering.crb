fn function_result(nodes: &[AstNode], graph: &[StaticNode], function: u64) u64 {
    let mut next = graph[function].first_child;
    while nodes[next].kind == 3 { next = graph[next].next_sibling; }
    if nodes[next].kind == 4 { return next; }
    0
}

fn guess(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], types: &[i64], node: u64) i64 {
    let child = graph[node].first_child;
