    let want = if handle_type(copy(expected)) { task_payload(expected) } else { 0 };
    let dry = Lowering { emit: false, result: copy(want), function: copy(worker),
        loop_result: 0, loop_slot: 0, loop_node: 0, storage: (*ctx).storage, poll_body: 0 };
    let result = block(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
        &mut types[0..types.len()], &dry, copy(worker), copy(want), 0);
    if result < 0 || (want != 0 && result != want) { return -1; }
    let result_type = task_code(2, result);
