            } else {
                let want = if kind == 6 { (*ctx).result } else if kind == 10 { copy(expected) } else { 0 };
                let ty = expression(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &mut types[0..types.len()], ctx, copy(child), copy(want));
                if ty < 0 { return ty; }
                if kind == 8 {
                    if emit {
                        if needs_cleanup(copy(ty), copy(storage)) {
                            drop_value(ty, child, false);
                        } else { consume(ty, child, false); }
                    }
                } else if ty != 0 {
                    if kind == 10 { result = copy(ty); }
                    if emit && (*ctx).poll_body == 0 && (kind == 6 || slot == 0) {
                        let function = (*ctx).function;
                        let mut root = if function == 0 || function == body { copy(body) } else { graph[function].first_child };
                        while nodes[root].kind == 3 || nodes[root].kind == 4 { root = graph[root].next_sibling; }
                        drop_visible(&nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()],
                            copy(statement), if function != 0 { function } else { copy(root) }, true, copy(storage));
                        unwind_regions(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(statement), copy(root));
                        if storage { { let code: [u8;18] = [109,101,109,111,114,121,95,99,117,114,115,111,114,40,109,97,114,107]; byte_text(&code[..]); } number(root); { let code: [u8;3] = [41,59,10]; byte_text(&code[..]); } }
                    }
                    if (*ctx).poll_body != 0 && (kind == 6 || (body == (*ctx).poll_body && slot == 0)) {
                        if want != ty || ty <= 0 { return lowering_failure(&nodes[0..nodes.len()],statement); }
                        if emit {
                            drop_visible(&nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()],
                                copy(statement), (*ctx).function, true, copy(storage));
                            if ty <= 9 {
                                { let code: [u8;20] = [102,114,97,109,101,45,62,115,116,97,116,101,46,118,97,108,117,101,46,107]; byte_text(&code[..]); } number(unsigned(copy(ty)));
                            } else {
                                { let code: [u8;49] = [102,114,97,109,101,45,62,115,116,97,116,101,46,112,97,121,108,111,97,100,61,38,102,114,97,109,101,45,62,114,101,115,117,108,116,59,102,114,97,109,101,45,62,114,101,115,117,108,116]; byte_text(&code[..]); }
                            }
                            character(61); temporary(child); { let code: [u8;14] = [59,114,101,116,117,114,110,32,116,114,117,101,59,10]; byte_text(&code[..]); }
                        }
                    } else if outcome(ctx, if kind == 6 { 0 } else { copy(slot) }, child, want, ty) < 0 { return lowering_failure(&nodes[0..nodes.len()],statement); }
                }
            }
        } else { return lowering_failure(&nodes[0..nodes.len()],statement); }
        if emit && graph[statement].next_sibling == 0 {
            if kind == 5 {
                let ty = types[statement];
                if needs_cleanup(copy(ty), copy(storage)) {
                    drop_value(ty, copy(statement), true);
                }
            }
            drop_visible(&nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()],
                copy(statement), copy(body), false, copy(storage));
        }
        statement = graph[statement].next_sibling;
    }
    if emit && storage { { let code: [u8;18] = [109,101,109,111,114,121,95,99,117,114,115,111,114,40,109,97,114,107]; byte_text(&code[..]); } number(copy(body)); { let code: [u8;3] = [41,59,10]; byte_text(&code[..]); } }
    if emit && (storage || regional || release_pages) { reclaim_scope(release_pages); }
    if emit && regional { exit_region(body); }
    result
}

pub fn header(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], types: &mut [i64], function: u64) bool {
    let result = function_result(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(function));
    let ty = annotation_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], result);
    if ty < 0 || vector_type(copy(ty)) {
        drop(diagnostic_limitation(&nodes[0..nodes.len()],if result==0{function}else{result},"C lowering of this return type is not implemented"));
        return false;
    }
    types[function] = ty;
    let mut formal = graph[function].first_child;
    if borrowed_receiver(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(function)) {
        let record = nominal(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], nodes[function].parent);
        if record == 0 { return false; }
        types[formal] = 4000000 + signed(record);
        formal = graph[formal].next_sibling;
    }
    while nodes[formal].kind == 3 {
        let ty = annotation_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], graph[formal].first_child);
        if ty <= 0 || vector_type(copy(ty)) {
            drop(diagnostic_limitation(&nodes[0..nodes.len()],graph[formal].first_child,"C lowering of this parameter type is not implemented"));
            return false;
        }
        types[formal] = ty;
        formal = graph[formal].next_sibling;
    }
    nodes[formal].kind == 2 || (nodes[formal].kind == 4 && nodes[graph[formal].next_sibling].kind == 2)
}

/// Called only when block lowering has failed, never during expression probing.
fn lowering_failure(nodes:&[AstNode],point:u64)i64 {
    drop(diagnostic_limitation(&nodes[0..nodes.len()],point,"C lowering of this statement or its operand form is not implemented"));
    -1
}
