        let ty = types[graph[child].binding];
        if ty >= 10000 && ty < 1000000 { return ty + 1000000; }
        let loan = scalar_reference(ty, graph[node].mutable);
        if loan > 0 { return loan; }
        return 0;
    }
    if kind == 14 && nodes[child].kind == 7 {
        let ty = types[graph[child].binding];
        if ty >= 6000000 && ty < 7000000 { return pool_type(ty); }
        let referent = scalar_referent(ty);
        if referent > 0 { return referent; }
        return 0;
    }
    if kind == 19 { return guess(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()], child); }
    if kind == 15 {
        let name = graph[node].first_child;
        let copy_name: [u8;4] = [99,111,112,121];
        if word(&source[0..source.len()], &nodes[0..nodes.len()], copy(name), &copy_name[..]) {
            return guess(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()], graph[name].next_sibling);
        }
        let callee = bootstrap_callee(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(node));
        if callee != 0 { return types[callee]; }
    }
    if kind == 11 {
        let mark = nodes[node].name_start;
        if source[mark] == 97 {
            return annotation_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], graph[child].next_sibling);
        }
        let left = guess(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()], copy(child));
        if left != 0 { return left; }
        return guess(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()], graph[child].next_sibling);
    }
    0
}

