        number(copy(worker)); { let code: [u8;6] = [41,44,112,111,108,108]; byte_text(&code[..]); } number(copy(worker)); { let code: [u8;8] = [44,100,105,115,112,111,115,101]; byte_text(&code[..]); } number(copy(worker)); { let code: [u8;3] = [41,59,10]; byte_text(&code[..]); }
        capture = graph[worker].first_child;
        while nodes[capture].kind == 57 {
            { let code: [u8;7] = [40,40,70,114,97,109,101]; byte_text(&code[..]); } number(copy(worker)); { let code: [u8;2] = [42,41]; byte_text(&code[..]); } temporary(copy(node)); { let code: [u8;9] = [46,115,116,97,116,101,41,45,62]; byte_text(&code[..]); }
            local(copy(capture)); character(61); local(graph[capture].binding); { let code: [u8;2] = [59,10]; byte_text(&code[..]); }
