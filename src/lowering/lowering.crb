// A native worker uses the ordinary synchronous block lowering. Its
// entry bindings are loaded from a frame populated before pthread_create.
fn native_invoke(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], types: &mut [i64],
    ctx: &Lowering, node: u64, worker: u64, expected: i64) i64 {
    if (*ctx).poll_body != 0 { return -1; }
