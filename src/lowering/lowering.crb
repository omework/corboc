    if a <= 0 { return -1; }
    if cast {
        let ty = annotation_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], right);
        if ty <= 0 || ty > 9 || a > 9 { return -1; }
        if emit {
            emit_checked_cast(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],node,left,a,ty);
        }
        return ty;
    }
    if logical && emit {
        declaration(3, copy(node)); character(61); temporary(copy(left)); { let code: [u8;5] = [59,10,105,102,40]; byte_text(&code[..]); }
        if first == 124 { character(33); }
        temporary(copy(left)); { let code: [u8;3] = [41,123,10]; byte_text(&code[..]); }
    }
    let spilled = (*ctx).poll_body != 0 && !logical && suspends(&nodes[0..nodes.len()], copy(right));
    if spilled {
        types[node] = copy(a);
        if emit { { let code: [u8;12] = [102,114,97,109,101,45,62,115,112,105,108,108]; byte_text(&code[..]); } number(copy(node)); character(61); temporary(copy(left)); { let code: [u8;2] = [59,10]; byte_text(&code[..]); } }
    }
