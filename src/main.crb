fn lexical_name(kind: i64) -> bool {
    kind == 1 || kind == 7 || (kind >= 15 && kind <= 18) || kind == 41
        || (kind >= 44 && kind <= 50) || (kind >= 56 && kind <= 62)
        || kind == 65 || kind == 66 || kind == 70 || kind == 72 || kind == 73 || kind == 76
}

fn declaration_name(token: &Token) -> bool {
    let kind = (*token).kind;
    (*token).annotation >= 0 && (kind == 1 || kind == 50 || kind == 56 || kind == 57
        || kind == 60 || kind == 61 || kind == 70 || kind == 72 || kind == 73 || kind == 76)
}

// A leading-dot float is allowed only where a new operand can begin.
// After a value, the same dot starts a tuple/member projection.
fn ends_operand(kind: i64) -> bool {
    kind == 1 || kind == 3 || kind == 5 || kind == 8 || kind == 9
        || kind == 18 || kind == 40 || kind == 61 || kind == 64
        || kind == 66 || kind == 84
}

fn whitespace(byte: u8) -> bool {
    byte == 32 || byte == 10 || byte == 9 || byte == 13 || byte == 12
}

// The reference lexer permits Unicode whitespace between @asm and its brace.
fn asm_open(source: &[u8], after_name: usize) -> usize {
    let mut cursor = after_name;
    while cursor < source.len() {
        if source[cursor] == 123 { return cursor; }
        let (width, scalar) = utf8_scalar(&source[0..source.len()], copy(cursor));
        if !((scalar >= 9 && scalar <= 13) || scalar == 32 || scalar == 133
            || scalar == 160 || scalar == 5760 || (scalar >= 8192 && scalar <= 8202)
            || scalar == 8232 || scalar == 8233 || scalar == 8239 || scalar == 8287 || scalar == 12288) {
            break;
        }
        cursor = cursor + width;
    }
    0
}

// Each operand receives its own parser token after the opaque assembly token.
struct AssemblyLex {
    end: u64,
    used: u64,
    error: i64,
    offset: u64,
}

fn lex_assembly(source: &[u8], tokens: &mut [Token], open: usize, position: usize) -> AssemblyLex {
    let mut cursor = open + 1;
    let mut count = position + 1;
    while cursor < source.len() {
        let byte = source[cursor];
        if byte == 125 { return AssemblyLex { end: (cursor + 1) as u64, used: count as u64, error: 0, offset: 0 }; }
        if byte == 47 && cursor + 1 < source.len() && source[cursor + 1] == 47 {
            while cursor < source.len() && source[cursor] != 10 { cursor = cursor + 1; }
            continue;
        }
        if byte == 36 && cursor + 1 < source.len() && source[cursor + 1] == 123 {
            let dollar = copy(cursor);
            cursor = cursor + 2;
            let start = copy(cursor);
            let mut valid = cursor < source.len() && name_start(source[cursor]);
            while cursor < source.len() && source[cursor] != 125 {
                if !(name_start(source[cursor]) || digit(source[cursor])) { valid = false; }
                cursor = cursor + 1;
            }
            if cursor == source.len() { return AssemblyLex { end: 0, used: 0, error: 9, offset: dollar as u64 }; }
            if !valid { return AssemblyLex { end: 0, used: 0, error: 10, offset: start as u64 }; }
            if count >= tokens.len() - 3 { return AssemblyLex { end: 0, used: 0, error: 13, offset: start as u64 }; }
            tokens[count] = Token { nominal: false, annotation: 0, kind: 69, start: start as u64, end: cursor as u64 };
            count = count + 1;
        }
        cursor = cursor + 1;
    }
    AssemblyLex { end: 0, used: 0, error: 11, offset: cursor as u64 }
}

// Foreign C remains opaque to the Corbo grammar. Only header paths and ${bindings} cross the boundary.
fn c_space(source:&[u8], after:usize)->usize {
    let mut at=after; while at<source.len() && whitespace(source[at]) { at=at+1; } at
}

fn lex_c(source:&[u8],tokens:&mut [Token],after_name:usize,position:usize)->AssemblyLex {
    let mut at=c_space(&source[0..source.len()],after_name); let mut count=position+1;
    if at<source.len() && source[at]==40 {
        at=c_space(&source[0..source.len()],at+1);
        let keyword:[u8;8]=[105,110,99,108,117,100,101,115];
        if source.len()-at<8 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        let key=&source[at..at+8]; if !key.content_eq(&keyword[..]) { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        at=c_space(&source[0..source.len()],at+8);
        if at==source.len() || source[at]!=61 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        at=c_space(&source[0..source.len()],at+1);
        if at==source.len() || source[at]!=123 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        at=c_space(&source[0..source.len()],at+1);
        while at<source.len() && source[at]!=125 {
            if source[at]!=34 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
            let start=at+1;at=copy(start);
            while at<source.len() && source[at]!=34 {
                let b=source[at];
                if !(name_start(copy(b)) || digit(copy(b)) || b==46 || b==47 || b==45 || b==58) {
                    return AssemblyLex{end:0,used:0,error:14,offset:at as u64};
                } at=at+1;
            }
            if at==source.len() || at==start || count>=tokens.len()-3 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
            tokens[count]=Token{nominal:false,annotation:0,kind:83,start:start as u64,end:at as u64};count=count+1;
            at=c_space(&source[0..source.len()],at+1);
            if at<source.len() && source[at]==125 { break; }
            if at==source.len() || source[at]!=44 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
            at=c_space(&source[0..source.len()],at+1);
        }
        if at==source.len() { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        at=c_space(&source[0..source.len()],at+1);
        if at==source.len() || source[at]!=41 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
        at=c_space(&source[0..source.len()],at+1);
    }
    if at==source.len() || source[at]!=123 { return AssemblyLex{end:0,used:0,error:14,offset:at as u64}; }
    let open=copy(at);at=at+1;let mut depth:u64=1;
    while at<source.len() {
        let b=source[at];
        if b==34 || b==39 {
            let quote=copy(b);at=at+1;
            while at<source.len() && source[at]!=quote {
                if source[at]==92 { at=at+1; } if at<source.len(){at=at+1;}
            }
            if at==source.len(){break;}at=at+1;continue;
        }
        if b==47 && at+1<source.len() && source[at+1]==47 {
            while at<source.len() && source[at]!=10 {at=at+1;}continue;
        }
        if b==47 && at+1<source.len() && source[at+1]==42 {
            at=at+2;while at+1<source.len() && !(source[at]==42 && source[at+1]==47){at=at+1;}
            if at+1>=source.len(){break;}at=at+2;continue;
        }
        if b==36 && at+1<source.len() && source[at+1]==123 {
            let start=at+2;at=copy(start);
            if at==source.len() || !name_start(source[at]) { return AssemblyLex{end:0,used:0,error:10,offset:at as u64}; }
            while at<source.len() && (name_start(source[at]) || digit(source[at])) {at=at+1;}
            if at==source.len() || source[at]!=125 || count>=tokens.len()-3 { return AssemblyLex{end:0,used:0,error:10,offset:at as u64}; }
            tokens[count]=Token{nominal:false,annotation:0,kind:69,start:start as u64,end:at as u64};count=count+1;at=at+1;continue;
        }
        if b==123{depth=depth+1;}if b==125{depth=depth-1;}
        at=at+1;
        if depth==0 {tokens[position]=Token{nominal:false,annotation:source_offset((open+1) as u64),kind:82,start:0,end:at as u64};return AssemblyLex{end:at as u64,used:count as u64,error:0,offset:0};}
    }
    AssemblyLex{end:0,used:0,error:11,offset:at as u64}
}

// The compiler selects these functions using the target of the bootstrap binary.
#(if: target.family == "unix")
    fn target_family() -> i64 { 1 }
#(endif)
#(if: target.family == "windows")
    fn target_family() -> i64 { 2 }
#(endif)
#(if: target.os == "macos")
    fn target_os() -> i64 { 3 }
#(endif)
#(if: target.os == "linux")
    fn target_os() -> i64 { 4 }
#(endif)
#(if: target.os == "windows")
    fn target_os() -> i64 { 2 }
#(endif)
#(if: target.arch == "aarch64")
    fn target_arch() -> i64 { 5 }
#(endif)
#(if: target.arch == "x86_64")
    fn target_arch() -> i64 { 6 }
#(endif)
#(if: target.pointer_width == "32")
    fn target_pointer_width() -> i64 { 7 }
#(endif)
#(if: target.pointer_width == "64")
    fn target_pointer_width() -> i64 { 8 }
#(endif)


fn target_key(key: &[u8]) -> i64 {
    let os: [u8; 2] = [111, 115];
    if key.content_eq(&os[..]) { return target_os(); }
    let family: [u8; 6] = [102, 97, 109, 105, 108, 121];
    if key.content_eq(&family[..]) { return target_family(); }
    let arch: [u8; 4] = [97, 114, 99, 104];
    if key.content_eq(&arch[..]) { return target_arch(); }
    let pointer_width: [u8; 13] = [112, 111, 105, 110, 116, 101, 114, 95, 119, 105, 100, 116, 104];
    if key.content_eq(&pointer_width[..]) { return target_pointer_width(); }
    return 0;
}

fn target_text_eq(text: &[u8], expected: &[u8]) -> bool {
    let mut index: usize = 1;
    let mut position: usize = 0;
    while index < text.len() - 1 {
        if position == expected.len() { return false; }
        let byte = text[index];
        if byte == 92 {
            // Target names contain only ASCII letters, digits and underscores.
            if text[index + 1] != 117 || hex_unit(&text[0..text.len()], index + 2)
                != expected[position] as u32 { return false; }
            index = index + 6;
        } else {
            if byte != expected[position] { return false; }
            index = index + 1;
        }
        position = position + 1;
    }
    position == expected.len()
}

fn target_value_matches(text: &[u8], key: i64) -> bool {
    if key == 1 {
        let value: [u8; 4] = [117, 110, 105, 120];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 2 {
        let value: [u8; 7] = [119, 105, 110, 100, 111, 119, 115];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 3 {
        let value: [u8; 5] = [109, 97, 99, 111, 115];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 4 {
        let value: [u8; 5] = [108, 105, 110, 117, 120];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 5 {
        let value: [u8; 7] = [97, 97, 114, 99, 104, 54, 52];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 6 {
        let value: [u8; 6] = [120, 56, 54, 95, 54, 52];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 7 {
        let value: [u8; 2] = [51, 50];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    if key == 8 {
        let value: [u8; 2] = [54, 52];
        return target_text_eq(&text[0..text.len()], &value[..]);
    }
    false
}

// Compact the selected token stream in place. Keeping source spans intact
// preserves the byte locations of declarations and assembly operands.
fn select_target(source: &[u8], tokens: &mut [Token]) -> usize {
    let mut index: u64 = 0;
    let mut count: usize = 0;
    let mut active: [bool;128] = [false;128];
    let mut depth: u64 = 0;
    while tokens[index].kind != 0 {
        let enabled = if depth == 0 { true } else { active[depth - 1] };
        if tokens[index].kind == 71 && tokens[index + 1].kind == 2 {
            let end_word: [u8;5] = [101,110,100,105,102];
            let word = &source[tokens[index + 2].start..tokens[index + 2].end];
            if word.content_eq(&end_word[..]) {
                if depth == 0 || tokens[index + 3].kind != 3 { return 0; }
                depth = depth - 1; index = index + 4; continue;
            }
            if tokens[index + 2].kind == 44 {
                if tokens[index + 3].kind != 10 || depth == 128 { return 0; }
                index = index + 4;
                let mut include = false; let mut conjunction = true;
                loop {
                    if tokens[index].kind != 1 || tokens[index + 1].kind != 38 || tokens[index + 2].kind != 1 { return 0; }
                    if tokens[index + 3].kind != 32 || tokens[index + 4].kind != 9 { return 0; }
                    let target_word: [u8;6] = [116,97,114,103,101,116];
                    let marker = &source[tokens[index].start..tokens[index].end];
                    if !marker.content_eq(&target_word[..]) { return 0; }
                    let key = target_key(&source[tokens[index + 2].start..tokens[index + 2].end]);
                    if key == 0 { return 0; }
                    let value = target_value_matches(&source[tokens[index + 4].start..tokens[index + 4].end], key);
                    conjunction = conjunction && value; index = index + 5;
                    if tokens[index].kind == 30 { include = include || conjunction; conjunction = true; }
                    else if tokens[index].kind != 31 { break; }
                    index = index + 1;
                }
                let selected = enabled && (include || conjunction);
                if tokens[index].kind != 3 {return 0;}
                active[depth]=selected;depth=depth+1;index=index+1;continue;
            }
        }
        if enabled {
            tokens[count] = Token { nominal:tokens[index].nominal,annotation:tokens[index].annotation,
                kind:tokens[index].kind,start:tokens[index].start,end:tokens[index].end }; count = count + 1;
        }
        index = index + 1;
    }
    if depth != 0 { return 0; }
    let end = tokens[index].end;
    tokens[count] = Token { nominal:false,annotation:0,kind:0,start:copy(end),end:end };
    tokens[count + 1] = Token { nominal:false,annotation:0,kind:0,start:0,end:0 };
    tokens[count + 2] = Token { nominal:false,annotation:0,kind:0,start:0,end:0 };
    count + 3
}

fn mark_nominal_names(source: &[u8], tokens: &mut [Token]) {
    let mut declaration: u64 = 0;
    while tokens[declaration].kind != 0 {
        let kind = tokens[declaration].kind;
        if (kind == 58 || kind == 59) && lexical_name(tokens[declaration + 1].kind)
            && !tokens[declaration + 1].nominal {
            let name = &source[tokens[declaration + 1].start..tokens[declaration + 1].end];
            let mut index: u64 = 0;
            while tokens[index].kind != 0 {
                let candidate = &source[tokens[index].start..tokens[index].end];
                if lexical_name(tokens[index].kind) && candidate.content_eq(&name[0..name.len()]) {
                    let token = Token { nominal: true, annotation: tokens[index].annotation,
                        kind: tokens[index].kind, start: tokens[index].start, end: tokens[index].end };
                    tokens[index] = token;
                }
                index = index + 1;
            }
        }
        declaration = declaration + 1;
    }
    mark_enum_paths(&source[0..source.len()],&mut tokens[0..tokens.len()]);
}

/// A known enum constructor has the same AST shape for :: and legacy dot syntax.
/// Token spans stay unchanged, so linking and original-source maps retain their coordinates.
fn mark_enum_paths(source:&[u8],tokens:&mut [Token]) {
    let mut declaration:u64=0;
    while tokens[declaration].kind!=0 {
        if tokens[declaration].kind==59 && lexical_name(tokens[declaration+1].kind) {
            let name=&source[tokens[declaration+1].start..tokens[declaration+1].end];
            let mut body=declaration+2;
            while tokens[body].kind!=0 && tokens[body].kind!=4{body+=1;}
            if tokens[body].kind==4 {
                let mut variant=body+1;let mut depth:u64=1;let mut expect=true;
                while depth!=0 && tokens[variant].kind!=0 {
                    let kind=tokens[variant].kind;
                    if depth==1 && expect && lexical_name(kind) {
                        let arm=&source[tokens[variant].start..tokens[variant].end];
                        let mut use_at:u64=0;
                        while tokens[use_at].kind!=0 {
                            if lexical_name(tokens[use_at].kind) && tokens[use_at+1].kind==43 && lexical_name(tokens[use_at+2].kind) {
                                let owner=&source[tokens[use_at].start..tokens[use_at].end];
                                let member=&source[tokens[use_at+2].start..tokens[use_at+2].end];
                                if owner.content_eq(&name[0..name.len()]) && member.content_eq(&arm[0..arm.len()]) {
                                    tokens[use_at+1]=Token{nominal:tokens[use_at+1].nominal,annotation:tokens[use_at+1].annotation,kind:38,start:tokens[use_at+1].start,end:tokens[use_at+1].end};
                                }
                            }
                            use_at+=1;
                        }
                        expect=false;
                    }
                    if depth==1 && kind==11{expect=true;}
                    if kind==4 || kind==2 || kind==39{depth+=1;}
                    if kind==5 || kind==3 || kind==40{depth-=1;}
                    variant+=1;
                }
            }
        }
        declaration+=1;
    }
}

fn valid_utf8(source: &[u8]) -> bool {
    let mut cursor: usize = 0;
    while cursor < source.len() {
        let (width, scalar) = utf8_scalar(&source[0..source.len()], copy(cursor));
        drop(scalar);
        if width == 0 { return false; }
        cursor = cursor + width;
    }
    true
}

// Common token classes match the Rust lexer (keywords keep their internal
// parser codes, and operand spans remain children of the assembly token).
fn dump_lex(tokens: &[Token], source: &[u8]) {
    let mut index: usize = 0;
    while index < tokens.len() {
        let kind = tokens[index].kind;
        if kind != 69 {
            let start = tokens[index].start;
            let class: i64 = if kind == 0 { 0 }
                else if kind == 8 { 2 }
                else if kind == 64 { 3 }
                else if kind == 9 { 4 }
                else if kind == 68 { 6 }
                else if name_start(source[start]) { 1 }
                else { 5 };
            print(class);
            print(start);
            print(tokens[index].end);
        }
        index = index + 1;
    }
}

fn lex_error(mode: i32, diagnostic: i64, offset: usize) -> i32 {
    drop(diagnostic_emit(3,diagnostic,offset as u64));
    if mode == 3 { print(diagnostic); print(offset); }
    3
}

fn scan_tokens(source: &[u8], tokens: &mut [Token], check: i32) -> (i32, usize) {
    if !valid_utf8(&source[0..source.len()]) { return (3, 0); }
    if tokens.len() < 3 { return (4, 0); }
    let mut count: usize = 0;
    let mut cursor: usize = 0;
    while cursor < source.len() {
        let start = copy(cursor);
        let byte = source[cursor];
        cursor = cursor + 1;

        if whitespace(copy(byte)) { continue; }
        if byte == 47 && cursor < source.len() && source[cursor] == 47 {
            while cursor < source.len() && source[cursor] != 10 {
                cursor = cursor + 1;
            }
            continue;
        }

        if count >= tokens.len() - 3 { return (4, 0); }
        if byte == 64 && source.len() - cursor >= 3
            && source[cursor] == 97 && source[cursor + 1] == 115 && source[cursor + 2] == 109 {
            let open = asm_open(&source[0..source.len()], cursor + 3);
            if open != 0 {
                let assembly = lex_assembly(&source[0..source.len()], &mut tokens[0..tokens.len()],
                    open, copy(count));
                if assembly.error == 13 { return (4, 0); }
                if assembly.error != 0 { return (lex_error(copy(check), assembly.error, assembly.offset as usize), 0); }
                tokens[count] = Token { nominal: false, annotation: 0, kind: 68, start: start as u64, end: assembly.end };
                cursor = assembly.end as usize;
                count = assembly.used as usize;
                continue;
            }
        }

        if byte==64 && cursor<source.len() && source[cursor]==99
            && (cursor+1==source.len() || !(name_start(source[cursor+1]) || digit(source[cursor+1]))) {
            let native=lex_c(&source[0..source.len()],&mut tokens[0..tokens.len()],cursor+1,copy(count));
            if native.error!=0 {return (lex_error(copy(check),native.error,native.offset as usize),0);}
            let body=tokens[count].annotation;
            tokens[count]=Token{nominal:false,annotation:body,kind:82,start:start as u64,end:native.end};
            cursor=native.end as usize;count=native.used as usize;continue;
        }
        let mut kind: i64 = 0;
        let mut annotation: i64 = 0;
        let mut nominal = false;
        let after_value = count != 0 && ends_operand(tokens[count - 1].kind);
        let tuple_index = count != 0 && tokens[count - 1].kind == 38;
        if name_start(copy(byte)) {
            while cursor < source.len() {
                let next = source[cursor];
                if !(name_start(copy(next)) || digit(next)) { break; }
                cursor = cursor + 1;
            }
            nominal = byte >= 65 && byte <= 90;
            kind = name_kind(&source[start..cursor]);
            annotation = annotation_word(&source[start..cursor]);
            if annotation == 0 && builtin_or_placeholder(&source[start..cursor]) {
                let addr_name: [u8; 4] = [97, 100, 100, 114];
                let spelling = &source[start..cursor];
                annotation = if spelling.content_eq(&addr_name[..]) { -2 } else { -1 };
            }
        } else if digit(copy(byte)) || (byte == 46 && !after_value && cursor < source.len() && digit(source[cursor])) {
            if byte == 48 && cursor < source.len() && (source[cursor] == 120 || source[cursor] == 88) {
                cursor = cursor + 1;
                let first = copy(cursor);
                while cursor < source.len() && hex_digit(source[cursor]) < 16 {
                    cursor = cursor + 1;
                }
                if first == cursor { return (lex_error(copy(check), 2, copy(start)), 0); }
                kind = 8;
            } else {
                while cursor < source.len() && digit(source[cursor]) { cursor = cursor + 1; }
                kind = 8;
                let mut digit_index = copy(start);
                while digit_index < cursor {
                    if source[digit_index] != 48 { annotation = 29; break; }
                    digit_index = digit_index + 1;
                }
                if byte == 46 { kind = 64; }
                if byte != 46 && !tuple_index && cursor < source.len() && source[cursor] == 46
                    && !(cursor + 1 < source.len() && source[cursor + 1] == 46) {
                    kind = 64;
                    cursor = cursor + 1;
                    while cursor < source.len() && digit(source[cursor]) { cursor = cursor + 1; }
                }
            }
        } else if byte == 34 {
            // The whole source has already been checked for valid UTF-8.
            while cursor < source.len() && source[cursor] != 34 {
                let current = source[cursor];
                if current < 32 { return (lex_error(copy(check), 3, copy(cursor)), 0); }
                if current == 92 {
                    let (end, error, offset) = scan_escape(&source[0..source.len()], copy(cursor));
                    if error == 13 { return (4, 0); }
                if error != 0 { return (lex_error(copy(check), error, offset), 0); }
                    cursor = end;
                } else {
                    cursor = cursor + 1;
                }
            }
            if cursor == source.len() { return (lex_error(copy(check), 12, copy(start)), 0); }
            cursor = cursor + 1;
            kind = 9;
            if cursor - start == 3 && source[start + 1] == 67 { annotation = 26; }
        } else {
            let next: u8 = if cursor < source.len() { source[cursor] } else { 0 };
            let (mark, width) = punctuation(byte, next);
            kind = mark;
            cursor = cursor + (width - 1);
            if kind == 36 && cursor < source.len() && source[cursor] == 61 {
                kind = 80;
                cursor = cursor + 1;
            }
            if kind == 0 { return (lex_error(copy(check), 1, copy(start)), 0); }
        }
        tokens[count] = Token { nominal: nominal, annotation: annotation, kind: kind, start: start as u64, end: cursor as u64 };
        count = count + 1;
    }
    // Keep two initialized guard tokens for lookahead on malformed input.
    tokens[count] = Token { nominal: false, annotation: 0, kind: 0, start: cursor as u64, end: cursor as u64 };
    (0, count)
}

fn lex(source: &[u8], check: i32) -> i32 {
    // One token per source byte at most, plus EOF and two guards.
    let mut tokens: [Token; 131075] = [Token { nominal: false, annotation: 0, kind: 0, start: 0, end: 0 }; 131075];
    let (status, count) = scan_tokens(&source[0..source.len()], &mut tokens[..], copy(check));
    if status != 0 { return status; }
    if check == 3 {
        dump_lex(&tokens[..count + 1], &source[0..source.len()]);
        return 0;
    }
    let selected = select_target(&source[0..source.len()], &mut tokens[..count + 3]);
    if selected == 0 { return 7; }
    mark_nominal_names(&source[0..source.len()], &mut tokens[..selected]);
    let visibility = [LayoutVisibility { kind: 0, name: 0, start: 0, end: 0, origin: 0 }; 1];
    parse(&source[0..source.len()], &tokens[..selected], check, 0, false, &visibility[..0])
}


fn syntax_leaf(kind: i64, parent: u64, token: &Token) -> AstNode {
    AstNode {
        kind: kind, parent: parent, start: (*token).start, end: (*token).end,
        name_start: (*token).start, name_end: (*token).end, public: false,
    }
}

fn precedence(kind: i64) -> u8 {
    if kind == 30 { return 1; }
    if kind == 31 { return 2; }
    if kind == 27 { return 3; }
    if kind == 26 { return 4; }
    if kind == 25 { return 5; }
    if (kind >= 32 && kind <= 35) || kind == 23 || kind == 24 { return 6; }
    if kind == 36 || kind == 37 { return 7; }
    if kind == 19 || kind == 20 { return 8; }
    if kind == 21 || kind == 22 || kind == 6 { return 9; }
    if kind == 41 { return 10; }
    0
}

// Parse a field list for either a declaration or a constructor.
fn parse_fields(depth: u64, tokens: &[Token], nodes: &mut [AstNode], open: u64,
    free: u64, parent: u64, types: bool) -> (u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[open].start); return (0, 0); }
    let mut index = open + 1;
    let mut count = free;
    while tokens[index].kind != 5 {
        if !lexical_name(tokens[index].kind) || tokens[index + 1].kind != 10 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        let field = copy(count);
        let start = tokens[index].start;
        let end_name = tokens[index].end;
        if types {
            let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 2, count + 1, copy(field));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
        } else {
            let (next, used, root) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 2, count + 1, copy(field), 0);
            drop(root);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
        }
        nodes[field] = AstNode { kind: 31, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: start, name_end: end_name, public: false,
        };
        if tokens[index].kind != 11 { break; }
        index = index + 1;
    }
    if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    return (index + 1, count);
}

// A positional field has no source name. Its equal name offsets encode the
// one-based position so the existing aggregate passes can resolve it.
fn parse_positional_fields(depth: u64, tokens: &[Token], nodes: &mut [AstNode], open: u64,
    free: u64, parent: u64, kind: i64) -> (u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[open].start); return (0, 0); }
    let mut index = open + 1;
    if tokens[index].kind == 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    let mut count = free;
    let mut position: u64 = 1;
    while tokens[index].kind != 3 {
        let field = copy(count);
        let start = tokens[index].start;
        if kind == 54 {
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            nodes[count + 1] = syntax_leaf(41, copy(field), &tokens[index]);
            index = index + 1;
            count = count + 2;
        } else if kind == 4 {
            let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index, count + 1, copy(field));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
        } else {
            let (next, used, value) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index, count + 1, copy(field), 0);
            drop(value);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
        }
        nodes[field] = AstNode { kind: if kind == 54 { 54 } else { 31 }, parent: copy(parent), start: start,
            end: tokens[index - 1].end, name_start: copy(position), name_end: copy(position), public: false };
        position = position + 1;
        if tokens[index].kind != 11 { break; }
        index = index + 1;
    }
    if tokens[index].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    return (index + 1, count);
}

fn parse_import(tokens: &[Token], nodes: &mut [AstNode], first: u64, free: u64) -> (u64, u64) {
    if !lexical_name(tokens[first + 1].kind) || tokens[first + 2].kind != 43 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let mut index = first + 3;
    let mut count = free + 1;
    while lexical_name(tokens[index].kind) && tokens[index + 1].kind == 43 { index = index + 2; }
    if tokens[index].kind == 4 {
        index = index + 1;
        if tokens[index].kind == 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        while tokens[index].kind != 5 {
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let member = copy(index);
            let position = copy(count);
            count = count + 1;
            index = index + 1;
            if tokens[index].kind == 41 {
                index = index + 1;
                if !declaration_name(&tokens[index]) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                nodes[count] = syntax_leaf(34, copy(position), &tokens[index]);
                count = count + 1;
                index = index + 1;
            }
            nodes[position] = AstNode { kind: 33, parent: copy(free), start: tokens[member].start,
                end: tokens[index - 1].end, name_start: tokens[member].start, name_end: tokens[member].end, public: false,
            };
            if tokens[index].kind != 11 { break; }
            index = index + 1;
        }
        if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 1;
    } else {
        if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 1;
        if tokens[index].kind == 41 {
            index = index + 1;
            if !declaration_name(&tokens[index]) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            nodes[count] = syntax_leaf(34, copy(free), &tokens[index]);
            count = count + 1;
            index = index + 1;
        }
    }
    if tokens[index].kind != 14 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    nodes[free] = AstNode { kind: 32, parent: 0, start: tokens[first].start,
        end: tokens[index].end, name_start: tokens[first + 1].start, name_end: tokens[first + 1].end, public: false,
    };
    return (index + 1, count);
}

fn reparent(nodes: &mut [AstNode], index: u64, parent: u64) {
    let kind = nodes[index].kind;
    let start = nodes[index].start;
    let end = nodes[index].end;
    let name_start = nodes[index].name_start;
    let name_end = nodes[index].name_end;
    nodes[index] = AstNode { kind: kind, parent: parent, start: start, end: end,
        name_start: name_start, name_end: name_end, public: false,
    };
}

fn parse_type(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let start = tokens[first].start;
    let mark = tokens[first].kind;
    let mut index = first + 1;
    let mut count = free + 1;
    let mut name_start: u64 = 0;
    let mut name_end: u64 = 0;
    if mark == 25 || mark == 31 || mark == 39 {
        if mark != 39 && tokens[index].kind == 16 { index = index + 1; }
        let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(free));
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = next;
        count = used;
        if mark == 39 {
            if tokens[index].kind == 14 {
                index = index + 1;
                if tokens[index].kind != 8 && !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                let (next_length, used_length, length_node) = parse_expression(0, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(free), 0);
                if next_length == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                drop(length_node);
                count = used_length;
                index = next_length;
            }
            if tokens[index].kind != 40 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
        }
    } else if mark == 2 || mark == 7 {
        if mark == 7 {
            if tokens[index].kind != 2 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            name_start = copy(start);
            name_end = tokens[first].end;
            index = index + 1;
        }
        let mut arity: u64 = 0;
        while tokens[index].kind != 3 {
            let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(free));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
            arity = arity + 1;
            if tokens[index].kind != 3 {
                if tokens[index].kind != 11 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 1;
            }
        }
        index = index + 1;
        if mark == 2 && arity == 1 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        if mark == 7 {
            if tokens[index].kind != 12 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 1, copy(count), copy(free));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
        }
    } else {
        if !lexical_name(copy(mark)) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        name_start = copy(start);
        name_end = tokens[first].end;
        while tokens[index].kind == 43 {
            index = index + 1;
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
        }
        if tokens[index].kind == 23 {
            index = index + 1;
            while true {
                if tokens[index].kind == 8 {
                    nodes[count] = syntax_leaf(94, copy(free), &tokens[index]);
                    index += 1; count += 1;
                } else {
                    let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(free));
                    if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                    index = next;
                    count = used;
                }
                if tokens[index].kind != 11 { break; }
                index = index + 1;
            }
            if tokens[index].kind != 24 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
        }
    }
    nodes[free] = AstNode { kind: 4, parent: parent, start: start,
        end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false,
    };
    (index, count)
}

fn parse_pattern(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let mut index = first + 1;
    let mut count = free + 1;
    let mut kind: i64 = 41;
    let mut name_start = tokens[first].start;
    let mut name_end = tokens[first].end;
    if tokens[first].kind == 2 {
        if tokens[index].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 1;
        kind = 43;
        name_start = 0;
        name_end = 0;
    } else {
        if !lexical_name(tokens[first].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        let mut variant_separator:u64=0;
        while tokens[index].kind == 43 {
            variant_separator=index;
            index = index + 1;
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
        }
        name_end=tokens[index-1].end;
        if variant_separator!=0 && tokens[index].kind!=38 {
            name_end=tokens[variant_separator-1].end;
            index=variant_separator;
        }
        if tokens[index].kind == 38 || (variant_separator!=0 && tokens[index].kind==43) {
            index = index + 1;
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
            kind = 53;
            if tokens[index].kind == 2 {
                let (next, used) = parse_positional_fields(depth + 1, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(free), 54);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = next;
                count = used;
            } else if tokens[index].kind == 4 {
                index = index + 1;
                while tokens[index].kind != 5 {
                    if !lexical_name(tokens[index].kind) || tokens[index + 1].kind != 10
                        || !lexical_name(tokens[index + 2].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                    nodes[count] = AstNode { kind: 54, parent: copy(free), start: tokens[index].start,
                        end: tokens[index + 2].end, name_start: tokens[index].start,
                        name_end: tokens[index].end, public: false };
                    nodes[count + 1] = syntax_leaf(41, copy(count), &tokens[index + 2]);
                    count = count + 2;
                    index = index + 3;
                    if tokens[index].kind != 11 { break; }
                    index = index + 1;
                }
                if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 1;
            }
        } else if tokens[index].kind == 2 {
            let (next, used) = parse_pattern(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 1, copy(count), copy(free));
            if next == 0 || tokens[next].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next + 1;
            count = used;
            kind = 42;
        }
    }
    nodes[free] = AstNode { kind: kind, parent: parent, start: tokens[first].start,
        end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false,
    };
    (index, count)
}

// Return the next token, the next free node, and the expression root.
// A next token of zero signals a syntax error.
fn parse_expression(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64, minimum: u8) -> (u64, u64, u64) {
    parse_expression_context(depth, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
        first, free, parent, minimum, 0, false)
}

fn parse_test_and_block(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    let (next, used, test) = parse_expression_context(copy(depth), &tokens[0..tokens.len()],
        &mut nodes[0..nodes.len()], copy(first), copy(free), copy(parent), 0, 1, false);
    drop(test);
    if next != 0 && (tokens[next].kind == 4 || tokens[next].kind == 71) {
        return parse_block(depth, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            next, used, parent);
    }
    let (retry, consumed, fallback) = parse_expression_context(copy(depth), &tokens[0..tokens.len()],
        &mut nodes[0..nodes.len()], first, free, copy(parent), 0, 2, false);
    drop(fallback);
    if retry == 0 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    return parse_block(depth, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
        retry, consumed, parent);
}

fn parse_expression_context(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64, minimum: u8, context: i64, primary_only: bool) -> (u64, u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[first].start); return (0, 0, 0); }
    let before_block = context != 0;
    let start = tokens[first].start;
    let atom = tokens[first].kind;
    let mut index = copy(first);
    let mut root = free;
    let mut count = root + 1;
    if atom == 30 || atom == 27 || atom == 72 {
        let mut name_end: u64 = 0;
        let mut name_start: u64 = 0;
        if atom == 72 {
            name_start = copy(start);
            name_end = tokens[index].end;
            index = index + 1;
        }
        let header = tokens[index].kind;
        let kind: i64 = if (header == 4 || header == 71) && atom == 72 { 56 } else { 55 };
        if kind == 55 {
            if header != 27 && header != 30 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = index + 1;
            if header == 27 {
                if tokens[index].kind == 27 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                while tokens[index].kind != 27 {
                    let param = copy(count);
                    let param_start = tokens[index].start;
                    let receiver = tokens[index].kind == 25;
                    if receiver { index = index + 1; }
                    if tokens[index].kind == 16 { index = index + 1; }
                    if tokens[index].kind != 66 && !declaration_name(&tokens[index]) { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    let name = copy(index);
                    index = index + 1;
                    count = count + 1;
                    if !receiver || tokens[name].kind != 66 {
                        if tokens[index].kind != 10 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                            index + 1, copy(count), copy(param));
                        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        index = next;
                        count = used;
                    }
                    nodes[param] = AstNode { kind: 3, parent: copy(root), start: param_start,
                        end: tokens[index - 1].end, name_start: tokens[name].start,
                        name_end: tokens[name].end, public: false };
                    if tokens[index].kind == 27 { break; }
                    if tokens[index].kind != 11 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    index = index + 1;
                }
                index = index + 1;
            }
            if tokens[index].kind == 12 {
                let (next, used) = parse_type(depth + 1,
                    &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    index + 1, copy(count), copy(root));
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used;
            }
        }
        let (next, used) = parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(root));
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = next;
        count = used;
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false };
    } else if atom == 62 {
        let (next, used, subject) = parse_expression_context(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            index + 1, copy(count), copy(root), 0, 1, false);
        drop(subject);
        if next == 0 || tokens[next].kind != 4 || tokens[next + 1].kind == 5 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = next + 1;
        count = used;
        while tokens[index].kind != 5 {
            let arm = copy(count);
            let arm_start = tokens[index].start;
            let (arrow, after_pattern) = parse_pattern(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), count + 1, copy(arm));
            if arrow == 0 || tokens[arrow].kind != 63 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            let (after, total) = parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                arrow + 1, after_pattern, copy(arm));
            if after == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = after;
            count = total;
            nodes[arm] = AstNode { kind: 40, parent: copy(root), start: arm_start,
                end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false,
            };
            if tokens[index].kind != 11 { break; }
            index = index + 1;
        }
        if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = index + 1;
        nodes[root] = AstNode { kind: 39, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false,
        };
    } else if atom == 39 {
        index = index + 1;
        let mut kind: i64 = 44;
        let mut items: u64 = 0;
        while tokens[index].kind != 40 {
            let (next, used, item) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(root), 0);
            drop(item);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = next;
            count = used;
            items = items + 1;
            if tokens[index].kind == 14 && items == 1 {
                index = index + 1;
                if tokens[index].kind != 8 && !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                let (next_length, used_length, length_node) = parse_expression(depth + 1, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(root), 0);
                if next_length == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                drop(length_node);
                count = used_length;
                index = next_length;
                kind = 45;
                break;
            }
            if tokens[index].kind != 11 { break; }
            index = index + 1;
        }
        if tokens[index].kind != 40 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = index + 1;
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false,
        };
    } else if atom == 4 || atom == 71 {
        let (next, used) = parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(root), copy(parent));
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = next;
        count = used;
    } else if atom == 44 && tokens[index + 1].kind == 15 {
        let pattern_token = index + 2;
        let (separator, discarded) = parse_pattern(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()], pattern_token, count, root);
        drop(discarded);
        if separator == 0 || tokens[separator].kind != 13 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        let (body_token, after_subject, subject) = parse_expression_context(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            separator + 1, count, root, 0, 1, false);
        drop(subject);
        if body_token == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        let arm = after_subject;
        let (again, after_pattern) = parse_pattern(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()], pattern_token, arm + 1, arm);
        if again != separator { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        let (after_body, used) = parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()], body_token, after_pattern, arm);
        if after_body == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        nodes[arm] = AstNode { kind: 40, parent: root, start: tokens[pattern_token].start,
            end: tokens[after_body - 1].end, name_start: 0, name_end: 0, public: false };
        let fallback = used;
        nodes[fallback + 1] = AstNode { kind: 41, parent: fallback, start: tokens[after_body - 1].end,
            end: tokens[after_body - 1].end, name_start: 0, name_end: 0, public: false };
        index = after_body;
        count = fallback + 3;
        let fallback_body = fallback + 2;
        if tokens[index].kind == 45 {
            if tokens[index + 1].kind == 44 {
                let statement = count;
                let (next, used_else, otherwise) = parse_expression_context(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    index + 1, statement + 1, statement, 11, 0, true);
                drop(otherwise);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                count = used_else;
                index = next;
                nodes[statement] = AstNode { kind: 10, parent: fallback_body, start: tokens[after_body + 1].start,
                    end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false };
                nodes[fallback_body] = AstNode { kind: 2, parent: fallback, start: tokens[after_body].start,
                    end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false };
            } else {
                let (next, used_else) = parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()], index + 1, fallback_body, fallback);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used_else;
            }
        } else {
            nodes[fallback_body] = AstNode { kind: 2, parent: fallback, start: tokens[index - 1].end,
                end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false };
        }
        nodes[fallback] = AstNode { kind: 40, parent: root, start: nodes[fallback + 1].start,
            end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false };
        nodes[root] = AstNode { kind: 39, parent: parent, start: start, end: tokens[index - 1].end,
            name_start: start, name_end: tokens[first].end, public: false };
    } else if atom == 44 || atom == 49 || atom == 76 {
        index = index + 1;
        let (next, used) = if atom == 44 {
            parse_test_and_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(root))
        } else {
            parse_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(root))
        };
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = next;
        count = used;
        if atom == 44 && tokens[index].kind == 45 && tokens[index + 1].kind == 44 && tokens[index + 2].kind == 15 {
            // Normalize else-if-let to an ordinary else scope with a match tail.
            let fallback = count;
            let statement = fallback + 1;
            let (after, total, branch) = parse_expression_context(depth + 1, &tokens[0..tokens.len()],
                &mut nodes[0..nodes.len()], index + 1, statement + 1, statement, 11, 0, true);
            drop(branch);
            if after == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            nodes[fallback] = AstNode { kind: 2, parent: root, start: tokens[index + 1].start,
                end: tokens[after - 1].end, name_start: 0, name_end: 0, public: false };
            nodes[statement] = AstNode { kind: 10, parent: fallback, start: tokens[index + 1].start,
                end: tokens[after - 1].end, name_start: 0, name_end: 0, public: false };
            index = after;
            count = total;
        } else if atom == 44 && tokens[index].kind == 45 {
            let (after, total, branch) = parse_expression_context(depth + 1, &tokens[0..tokens.len()],
                &mut nodes[0..nodes.len()], index + 1, copy(count), copy(root), 11, 0, true);
            if after == 0 || (nodes[branch].kind != 2 && nodes[branch].kind != 26) { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = after;
            count = total;
        }
        let kind = if atom == 44 { 26 } else if atom == 76 { 65 } else { 27 };
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false,
        };
    } else if atom == 25 || atom == 21 || atom == 20 || atom == 28 || atom == 29 {
        let operator = copy(index);
        index = index + 1;
        if atom == 25 && tokens[index].kind == 16 { index = index + 1; }
        let (next, used, unused_root_0) = parse_expression_context(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(root), 11, copy(context), false); drop(unused_root_0);
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = next;
        count = used;
        let kind = if atom == 25 { 13 } else if atom == 21 { 14 } else { 12 };
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: tokens[operator].start,
            name_end: tokens[operator].end, public: false,
        };
    } else if atom == 2 {
        index = index + 1;
        let mut kind: i64 = 19;
        if tokens[index].kind != 3 {
            let (next, used, unused_root_1) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(root), 0); drop(unused_root_1);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = next;
            count = used;
            if tokens[index].kind == 11 {
                kind = 20;
                if tokens[index + 1].kind == 3 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                while tokens[index].kind == 11 {
                    index = index + 1;
                    if tokens[index].kind == 3 { break; }
                    let (next_item, used_item, unused_root_2) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(root), 0); drop(unused_root_2);
                    if next_item == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    index = next_item;
                    count = used_item;
                }
            }
        }
        if tokens[index].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        index = index + 1;
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false,
        };
    } else {
        if !lexical_name(copy(atom)) && atom != 8 && atom != 9 && atom != 64 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
        let kind = if atom == 8 || atom == 9 || atom == 18 || atom == 64 { 9 } else { 7 };
        let mut name_end = tokens[index].end;
        let mut name_start = copy(start);
        let mut kind = kind;
        index = index + 1;
        if kind == 7 {
            while tokens[index].kind == 43 {
                index = index + 1;
                if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = index + 1;
                kind = 36;
            }
            if tokens[index].kind == 23 {
                let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(first), copy(count), copy(root));
                if next != 0 {
                    if tokens[first].annotation == 20 && tokens[next].kind == 43 && tokens[next + 1].annotation == 21 && tokens[next + 2].kind == 2 {
                        if tokens[next + 3].kind != 8 || tokens[next + 4].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        nodes[used] = syntax_leaf(9, copy(root), &tokens[next + 3]);
                        count = used + 1;
                        index = next + 5;
                        kind = 66;
                    } else if tokens[next].kind == 43 && lexical_name(tokens[next + 1].kind)
                        && tokens[next + 2].kind == 2 {
                        name_start = tokens[next + 1].start;
                        name_end = tokens[next + 1].end;
                        count = used;
                        index = next + 2;
                        kind = 36;
                    }
                }
            }
            if tokens[index].kind == 4 && tokens[index - 1].nominal
                && (!before_block || tokens[index + 2].kind == 10 || (context == 1 && tokens[index + 1].kind == 5)) {
                let (next, used) = parse_fields(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(count), copy(root), false);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used;
                kind = 37;
            }
        }
        nodes[root] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false,
        };
    }

    if primary_only { return (index, count, root); }
    let mut nominal_receiver = nodes[root].kind == 7 || nodes[root].kind == 36;
    nominal_receiver = nominal_receiver && tokens[index - 1].nominal;
    while tokens[index].kind == 2 || tokens[index].kind == 38 || tokens[index].kind == 39 || tokens[index].kind == 84 || tokens[index].kind == 28 {
        let outer = copy(count);
        count = count + 1;
        reparent(&mut nodes[0..nodes.len()], copy(root), copy(outer));
        if tokens[index].kind==84 || tokens[index].kind==28 {
            nodes[outer]=AstNode{kind:79,parent:copy(parent),start:nodes[root].start,end:tokens[index].end,
                name_start:tokens[index].start,name_end:tokens[index].end,public:false};
            index=index+1;root=outer;nominal_receiver=false;continue;
        }
        let mut kind: i64 = 15;
        let mut name_start: u64 = 0;
        let mut name_end: u64 = 0;
        let mut method: i64 = 0;
        let mut closed = false;
        let mark = tokens[index].kind;
        let member_token = index + 1;
        index = index + 1;
        if mark == 38 {
            if !lexical_name(tokens[index].kind) && tokens[index].kind != 8 { diagnostic_parse_expected(tokens[index].start,109,tokens[member_token - 1].start); return (0, 0, 0); }
            method = tokens[index].annotation;
            let awaiting = tokens[index].kind == 61;
            name_start = tokens[index].start;
            name_end = tokens[index].end;
            index = index + 1;
            kind = if awaiting { 38 } else if tokens[index].kind == 2 { 16 } else { 17 };
            if kind == 16 && nominal_receiver {
                let (next, used) = parse_positional_fields(depth + 1, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(outer), 31);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used;
                kind = 37;
                closed = true;
            }
            if kind == 16 {
                index = index + 1;
                if (method == 21 || method == 33) && tokens[index].kind == 4
                    && (tokens[index + 1].kind == 5 || tokens[index + 2].kind == 10) {
                    let initializer = copy(count);
                    let initializer_start = tokens[index].start;
                    let (next, used) = parse_fields(depth + 1, &tokens[0..tokens.len()],
                        &mut nodes[0..nodes.len()], copy(index), count + 1, copy(initializer), false);
                    if next == 0 || tokens[next].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    nodes[initializer] = AstNode { kind: 74, parent: copy(outer), start: initializer_start,
                        end: tokens[next].end, name_start: 0, name_end: 0, public: false };
                    index = next + 1;
                    count = used;
                    closed = true;
                } else if lexical_name(tokens[index].kind) && tokens[index + 1].kind == 10 {
                    while tokens[index].kind != 3 {
                        if !lexical_name(tokens[index].kind) || tokens[index + 1].kind != 10 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        let field = copy(count);
                        let label = copy(index);
                        let (next, used, value) = parse_expression(depth + 1, &tokens[0..tokens.len()],
                            &mut nodes[0..nodes.len()], index + 2, count + 1, copy(field), 0);
                        drop(value);
                        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        index = next;
                        count = used;
                        nodes[field] = AstNode { kind: 31, parent: copy(outer), start: tokens[label].start,
                            end: tokens[index - 1].end, name_start: tokens[label].start,
                            name_end: tokens[label].end, public: false };
                        if tokens[index].kind != 11 { break; }
                        index = index + 1;
                    }
                    if tokens[index].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    index = index + 1;
                    closed = true;
                }
            }
            if kind == 17 && tokens[index].kind == 4
                && nominal_receiver
                && (!before_block || tokens[index + 2].kind == 10 || (context == 1 && tokens[index + 1].kind == 5)) {
                let (next, used) = parse_fields(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(count), copy(outer), false);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used;
                kind = 37;
            }
        }
        if mark == 39 || (kind == 16 && method == 28 && !closed && tokens[index].kind != 3) {
            let closing: i64 = if mark == 39 { 40 } else { 3 };
            if mark == 39 { kind = 18; }
            if mark == 39 && tokens[index].kind == closing { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            while tokens[index].kind != closing {
                let range_start = tokens[index].start;
                let mut first_bound: u64 = 0;
                if tokens[index].kind != 42 {
                    let (next, used, bound) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(outer), 0);
                    if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    index = next;
                    count = used;
                    first_bound = bound;
                }
                if tokens[index].kind == 42 {
                    let range = copy(count);
                    count = count + 1;
                    let separator = copy(index);
                    if first_bound != 0 {
                        reparent(&mut nodes[0..nodes.len()], copy(first_bound), copy(range));
                    }
                    index = index + 1;
                    if tokens[index].kind != closing && tokens[index].kind != 11 {
                        let (next, used, bound) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                            copy(index), copy(count), copy(range), 0);
                        drop(bound);
                        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                        index = next;
                        count = used;
                    }
                    nodes[range] = AstNode { kind: 46, parent: copy(outer), start: range_start,
                        end: tokens[index - 1].end, name_start: tokens[separator].start,
                        name_end: tokens[separator].end, public: false,
                    };
                }
                if mark == 39 || tokens[index].kind != 11 { break; }
                index = index + 1;
            }
            if tokens[index].kind != closing { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = index + 1;
        } else if !closed && kind != 17 && kind != 38 && kind != 37 {
            while tokens[index].kind != 3 {
                let (next, used, unused_root_4) = parse_expression(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(count), copy(outer), 0); drop(unused_root_4);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                index = next;
                count = used;
                if tokens[index].kind != 3 {
                    if tokens[index].kind != 11 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
                    index = index + 1;
                }
            }
            index = index + 1;
        }
        nodes[outer] = AstNode { kind: kind, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false,
        };
        nominal_receiver = mark == 38 && nodes[outer].kind == 17 && tokens[member_token].nominal;
        root = outer;
    }

    let mut compared = false;
    while true {
        let mark = tokens[index].kind;
        let mut composite = copy(mark);
        let mut width: u64 = 1;
        if mark == 24 && assignment_width(&tokens[0..tokens.len()], copy(index)) == 3 { break; }
        if mark == 24 && tokens[index].end == tokens[index + 1].start {
            if tokens[index + 1].kind == 24 { composite = 37; width = 2; }
            if tokens[index + 1].kind == 13 { composite = 35; width = 2; }
        }
        let priority = precedence(composite);
        if priority == 0 || priority < minimum { break; }
        if priority == 6 {
            if compared { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            compared = true;
        }
        let operator = copy(index);
        index = index + width;
        let outer = copy(count);
        count = count + 1;
        reparent(&mut nodes[0..nodes.len()], copy(root), copy(outer));
        if priority == 10 {
            let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(outer));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = next;
            count = used;
        } else {
            let (next, used, unused_root_5) = parse_expression_context(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(outer), priority + 1, copy(context), false); drop(unused_root_5);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0, 0); }
            index = next;
            count = used;
        }
        nodes[outer] = AstNode { kind: 11, parent: copy(parent), start: copy(start),
            end: tokens[index - 1].end, name_start: tokens[operator].start,
            name_end: tokens[operator].end, public: false,
        };
        root = outer;
    }
    (index, count, root)
}

fn parse_annotation(tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    if tokens[first].kind != 71 || tokens[first + 1].kind != 2
        || tokens[first + 2].kind != 1 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let tag_token = first + 2;
    let tag = tokens[tag_token].annotation;
    let mut index = first + 3;
    let mut count = free + 1;
    if tag == 32 {
        if tokens[index].kind != 10 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index += 1;
        if tokens[index].kind == 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        while true {
            let entry = copy(count);
            let first_name = copy(index);
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index += 1;
            while tokens[index].kind == 43 {
                index += 1;
                if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index += 1;
            }
            if tokens[index].kind != 13 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            nodes[entry + 1] = AstNode { kind: if index == first_name + 1 { 7 } else { 36 },
                parent: copy(entry), start: tokens[first_name].start, end: tokens[index - 1].end,
                name_start: tokens[first_name].start, name_end: tokens[first_name].end, public: false };
            let (next, used, expression) = parse_expression(0, &tokens[0..tokens.len()],
                &mut nodes[0..nodes.len()], index + 1, entry + 2, copy(entry), 0);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            drop(expression);
            nodes[entry] = AstNode { kind: 80, parent: copy(free), start: tokens[first_name].start,
                end: tokens[next - 1].end, name_start: 0, name_end: 0, public: false };
            index = next;
            count = used;
            if tokens[index].kind != 11 { break; }
            index += 1;
            if tokens[index].kind == 3 { break; }
        }
    } else if tag == 34 {
        if tokens[index].kind != 10 || tokens[index + 1].annotation != 35
            || tokens[index + 2].kind != 13 || tokens[index + 3].annotation != 36 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        let property = index + 1;
        nodes[count] = AstNode { kind: 84, parent: copy(free), start: tokens[property].start,
            end: tokens[index + 3].end, name_start: tokens[property].start,
            name_end: tokens[property].end, public: false };
        count += 1;
        index += 4;
    } else if tag == 4 && tokens[index].kind == 3 {
        // Bare #(lock) is an object marker; placement is checked semantically.
    } else if tag == 4 {
        if tokens[index].kind != 10 || tokens[index + 1].annotation != 6 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 2;
        if tokens[index].kind != 13 || tokens[index + 1].kind != 66 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 1;
        let target = copy(index);
        index = index + 1;
        let mut kind: i64 = 59;
        if tokens[index].kind == 11 {
            if tokens[index + 1].annotation != 7 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 2;
            if tokens[index].kind != 13 || tokens[index + 1].annotation != 27 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 2;
            kind = 60;
        }
        nodes[count] = AstNode { kind: kind, parent: copy(free), start: tokens[target].start,
            end: tokens[index - 1].end, name_start: tokens[target].start, name_end: tokens[target].end,
            public: false };
        count = count + 1;
    } else if tag == 5 {
        if tokens[index].kind == 10 {
            if tokens[index + 1].annotation != 8 || tokens[index + 2].kind != 13 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 3;
            if tokens[index].annotation != 9 || tokens[index + 1].kind != 38 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 2;
            let end = copy(index);
            if tokens[index].kind == 61 {
                index = index + 1;
            } else {
                if tokens[index].kind != 1 || tokens[index + 1].kind != 2
                    || tokens[index + 2].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 3;
            }
            nodes[count] = AstNode { kind: 61, parent: copy(free), start: tokens[end].start,
                end: tokens[index - 1].end, name_start: tokens[end].start, name_end: tokens[end].end,
                public: false };
            count = count + 1;
        }
    } else if tag == 22 {
        if tokens[index].kind != 10 || tokens[index + 1].kind != 1 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        let carrier = index + 1;
        index = index + 2;
        if tokens[index].kind == 3 {
            // A bare name introduces an unconstrained parameter. The closing
            // parenthesis is consumed by the common annotation tail below.
            nodes[count] = AstNode { kind: 67, parent: copy(free), start: tokens[carrier].start,
                end: tokens[carrier].end, name_start: tokens[carrier].start,
                name_end: tokens[carrier].end, public: false };
            count = count + 1;
        } else {
            if tokens[index].kind == 23 {
            if tokens[index + 1].kind != 1 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let parameter = index + 1;
            let parameter_node = copy(count);
            count = count + 1;
            index = index + 2;
            if tokens[index].kind == 10 {
                index = index + 1;
                while true {
                    let (next, used) = parse_type(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(parameter_node));
                    if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                    index = next;
                    count = used;
                    if tokens[index].kind != 11 { break; }
                    index = index + 1;
                }
            }
            if tokens[index].kind != 24 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
            nodes[parameter_node] = AstNode { kind: 68, parent: copy(free), start: tokens[parameter].start,
                end: tokens[index - 1].end, name_start: tokens[parameter].start,
                name_end: tokens[parameter].end, public: false };
            }
            let mut kind: i64 = 70;
            if tokens[index].annotation == 23 { kind = 69; index = index + 1; }
            if tokens[index].kind != 4 || tokens[index + 1].kind == 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 1;
            let contract = copy(count);
            count = count + 1;
            while tokens[index].kind != 5 {
                let method_start = tokens[index].start;
                let asynchronous = tokens[index].kind == 60;
                if asynchronous { index = index + 1; }
                let method_node = copy(count);
                let (next, used) = parse_function(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(count), count + 1, copy(contract), copy(method_start), 71);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                if asynchronous {
                    let method_end = nodes[method_node].end;
                    let method_name_start = nodes[method_node].name_start;
                    let method_name_end = nodes[method_node].name_end;
                    nodes[method_node] = AstNode { kind: 35, parent: copy(contract), start: method_start,
                        end: method_end, name_start: method_name_start,
                        name_end: method_name_end, public: false };
                }
                index = next;
                count = used;
            }
            index = index + 1;
            nodes[contract] = AstNode { kind: kind, parent: copy(free), start: tokens[carrier].start,
                end: tokens[index - 1].end, name_start: tokens[carrier].start,
                name_end: tokens[carrier].end, public: false };
        }
    } else if tag == 24 {
        if tokens[index].kind != 10 || tokens[index + 2].kind != 13 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        if tokens[index + 1].annotation == 30 {
            let property = index + 1;
            index = index + 3;
            if tokens[index].kind != 8 || tokens[index].annotation != 29
                || tokens[index + 1].annotation < 17 || tokens[index + 1].annotation > 19 {
                diagnostic_parse_point(tokens[index].start); return (0, 0);
            }
            index = index + 2;
            nodes[count] = AstNode { kind: 75, parent: copy(free), start: tokens[property].start,
                end: tokens[index - 1].end, name_start: tokens[property].start,
                name_end: tokens[property].end, public: false };
            nodes[count + 1] = syntax_leaf(9, copy(count), &tokens[index - 2]);
            count = count + 2;
        } else {
            if tokens[index].kind != 10 || tokens[index + 1].annotation != 25
                || tokens[index + 2].kind != 13 || tokens[index + 3].kind != 4 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let property = index + 1;
            let capacities = copy(count);
            count = count + 1;
            index = index + 4;
            if tokens[index].kind == 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            while tokens[index].kind != 5 {
                let name = copy(index);
                if tokens[index].kind != 1 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 1;
                while tokens[index].kind == 43 {
                    index = index + 1;
                    if tokens[index].kind != 1 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                    index = index + 1;
                }
                if tokens[index].kind != 10 || tokens[index + 1].kind != 8 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 1;
                nodes[count + 1] = syntax_leaf(9, copy(count), &tokens[index]);
                nodes[count] = AstNode { kind: 72, parent: copy(capacities), start: tokens[name].start,
                    end: tokens[index].end, name_start: tokens[name].start, name_end: tokens[name].end,
                    public: false };
                count = count + 2;
                index = index + 1;
                if tokens[index].kind != 11 { break; }
                index = index + 1;
            }
            if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            nodes[capacities] = AstNode { kind: 73, parent: copy(free), start: tokens[property].start,
                end: tokens[index].end, name_start: tokens[property].start, name_end: tokens[property].end,
                public: false };
            index = index + 1;
        }
    } else if tag == 1 || tag == 2 {
        if tokens[index].kind != 10 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = index + 1;
        let mut properties: i64 = 0;
        while tokens[index].kind != 3 {
            let key = tokens[index].annotation;
            let mut kind: i64 = 62;
            if tag == 2 {
                if key != 15 && key != 16 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                if properties == 0 && key != 15 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                if key == 16 { kind = 63; }
            } else if key < 10 || key > 14 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let mask: i64 = 1 << (key - 10);
            if (properties & mask) != 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            properties = properties | mask;
            let property = copy(index);
            if tokens[index + 1].kind != 13 || tokens[index + 2].kind != 8
                || tokens[index + 2].annotation != 29 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = index + 2;
            nodes[count + 1] = syntax_leaf(9, copy(count), &tokens[index]);
            index = index + 1;
            if kind == 62 {
                if tokens[index].annotation < 17 || tokens[index].annotation > 19 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = index + 1;
            }
            nodes[count] = AstNode { kind: kind, parent: copy(free), start: tokens[property].start,
                end: tokens[index - 1].end, name_start: tokens[property].start,
                name_end: tokens[property].end, public: false };
            count = count + 2;
            if tokens[index].kind != 11 { break; }
            index = index + 1;
            if tokens[index].kind == 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        }
        if tag == 2 && properties == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    } else if tag != 3 {
        diagnostic_parse_point(tokens[index].start); return (0, 0);
    }
    if tokens[index].kind != 3 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    nodes[free] = AstNode { kind: 58, parent: parent, start: tokens[first].start,
        end: tokens[index].end, name_start: tokens[tag_token].start,
        name_end: tokens[tag_token].end, public: false };
    (index + 1, count)
}

fn parse_block(depth: u64, tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    if depth % 256 >= 128 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let mut index = copy(first);
    let mut count = free + 1;
    if tokens[index].kind == 71 && tokens[index + 2].annotation == 32 {
        let (next, used) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(free));
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = next;
        count = used;
    }
    if tokens[index].kind == 71 {
        let region = tokens[index + 2].annotation == 2;
        let (next, used) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(free));
        if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        index = next;
        count = used;
        if region && tokens[index].kind == 71 && tokens[index + 2].annotation == 3 {
            let (after, total) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(free));
            if after == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = after;
            count = total;
        }
    }
    if tokens[index].kind != 4 { diagnostic_parse_expected(tokens[index].start,102,tokens[first].start); return (0, 0); }
    index = index + 1;
    let mut named_moves = true;
    while tokens[index].kind != 5 {
        let start = tokens[index].start;
        let statement = copy(count);
        count = count + 1;
        let mark = tokens[index].kind;
        if mark == 72 && lexical_name(tokens[index + 1].kind) && tokens[index + 2].kind == 14 {
            if !named_moves { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            nodes[statement] = AstNode { kind: 57, parent: copy(free), start: start,
                end: tokens[index + 2].end, name_start: tokens[index + 1].start,
                name_end: tokens[index + 1].end, public: false };
            index = index + 3;
            continue;
        }
        named_moves = false;
        if mark == 85 {
            index += 1;
            if tokens[index].kind == 16 { index += 1; }
            let binding = index;
            let mut binding_end = tokens[index].end;
            if tokens[index].kind == 2 {
                if tokens[binding-1].kind==16{diagnostic_parse_expected(tokens[index].start,110,start);return (0,0);}
                index += 1;
                let mut arity:u64 = 0;
                while tokens[index].kind != 3 {
                    if tokens[index].kind == 16 { index += 1; }
                    if !declaration_name(&tokens[index]) { diagnostic_parse_expected(tokens[index].start,106,start); return (0,0); }
                    arity += 1; index += 1;
                    if tokens[index].kind == 3 { break; }
                    if tokens[index].kind != 11 { diagnostic_parse_expected(tokens[index].start,107,start); return (0,0); }
                    index += 1;
                }
                if arity < 2 { diagnostic_parse_expected(tokens[index].start,108,start); return (0,0); }
                binding_end = tokens[index].end; index += 1;
            } else {
                if !declaration_name(&tokens[index]) { diagnostic_parse_expected(tokens[index].start,106,start); return (0,0); }
                index += 1;
            }
            if tokens[index].kind != 86 { diagnostic_parse_expected(tokens[index].start,104,start); return (0,0); }
            let (next, used) = parse_test_and_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 1, count, statement);
            if next == 0 { return (0,0); }
            nodes[statement] = AstNode { kind:95, parent:free, start:start, end:tokens[next-1].end,
                name_start:tokens[binding].start, name_end:binding_end, public:false };
            index=next; count=used; continue;
        }
        if mark == 67 {
            if tokens[index + 1].kind != 70 || tokens[index + 2].kind != 4 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let (next, used) = parse_block(256 + (depth % 256) + 1,
                &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 2, copy(count), copy(statement));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = next;
            count = used;
            nodes[statement] = AstNode { kind: 50, parent: copy(free), start: start,
                end: tokens[index - 1].end, name_start: 0, name_end: 0, public: false };
            continue;
        }
        if mark==82 {
            if depth<256 {return (0,0);}
            let end=tokens[index].end;let body=raw_offset(tokens[index].annotation);index=index+1;
            while tokens[index].kind==83 || tokens[index].kind==69 {
                nodes[count]=AstNode{kind:if tokens[index].kind==83{78}else{52},parent:copy(statement),
                    start:tokens[index].start,end:tokens[index].end,name_start:0,name_end:0,public:false};
                count=count+1;index=index+1;
            }
            nodes[statement]=AstNode{kind:77,parent:copy(free),start:start,end:end,name_start:copy(body),name_end:body,public:false};continue;
        }
        if mark == 68 {
            if depth < 256 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            let end = tokens[index].end;
            index = index + 1;
            while tokens[index].kind == 69 {
                nodes[count] = AstNode { kind: 52, parent: copy(statement), start: tokens[index].start,
                    end: tokens[index].end, name_start: 0, name_end: 0, public: false };
                count = count + 1;
                index = index + 1;
            }
            nodes[statement] = AstNode { kind: 51, parent: copy(free), start: start,
                end: end, name_start: 0, name_end: 0, public: false };
            continue;
        }
        let mut kind: i64 = 8;
        let mut name_start: u64 = 0;
        let mut name_end: u64 = 0;
        let mut tuple_start: u64 = 0;
        let mut tuple_end: u64 = 0;
        if mark == 15 {
            kind = 5;
            index = index + 1;
            if tokens[index].kind == 2 {
                kind = 47;
                index = index + 1;
                tuple_start = copy(index);
                let mut bindings: u64 = 0;
                while tokens[index].kind != 3 {
                    if tokens[index].kind == 16 { index = index + 1; }
                    if !declaration_name(&tokens[index]) { diagnostic_parse_expected(tokens[index].start,100,start); return (0, 0); }
                    bindings = bindings + 1;
                    index = index + 1;
                    if tokens[index].kind != 3 {
                        if tokens[index].kind != 11 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                        index = index + 1;
                    }
                }
                if bindings < 2 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                tuple_end = copy(index);
                index = index + 1;
            } else {
                if tokens[index].kind == 16 { index = index + 1; }
                if !declaration_name(&tokens[index]) { diagnostic_parse_expected(tokens[index].start,100,start); return (0, 0); }
                name_start = tokens[index].start;
                name_end = tokens[index].end;
                index = index + 1;
            }
            if tokens[index].kind == 10 {
                let (next, used) = parse_type(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    index + 1, copy(count), copy(statement));
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = next;
                count = used;
            }
            if tokens[index].kind != 13 { diagnostic_parse_expected(tokens[index].start,101,start); return (0, 0); }
            index = index + 1;
        } else if mark == 17 || mark == 47 || mark == 48 || mark == 50 {
            kind = if mark == 17 { 6 } else if mark == 47 { 23 } else if mark == 48 { 24 } else { 25 };
            index = index + 1;
        }
        if mark == 46 {
            let (after, total) = parse_test_and_block(depth + 1, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 1, copy(count), copy(statement));
            if after == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            index = after;
            count = total;
            kind = 22;
        } else {
            let mut root: u64 = 0;
            if !((kind == 6 || kind == 23 || kind == 24 || kind == 25) && tokens[index].kind == 14) {
                if kind == 24 || kind == 25 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                // A leading block/control expression is a complete statement.
                // Otherwise a following dereference statement can be parsed as
                // multiplication with the preceding if/loop/block expression.
                let block_statement=kind==8 && (mark==44 || mark==49 || mark==4 || mark==71 || mark==76);
                let (next, used, value) = parse_expression_context(depth + 1, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(statement), 0,0,block_statement);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = next;
                count = used;
                root = value;
            }
            let width = assignment_width(&tokens[0..tokens.len()], copy(index));
            if kind == 8 && width != 0 {
                kind = 21;
                name_start = tokens[index].start;
                name_end = tokens[index + width - 1].end;
                let (next, used, rhs) = parse_expression(depth + 1, &tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], index + width, copy(count), copy(statement), 0);
                drop(rhs);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                index = next;
                count = used;
            }
            if tokens[index].kind == 14 {
                index = index + 1;
            } else {
                if kind != 8 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
                if tokens[index].kind == 5 {
                    kind = 10;
                } else if nodes[root].kind != 2 && nodes[root].kind != 26 && nodes[root].kind != 27 && nodes[root].kind != 39 && nodes[root].kind != 56 && nodes[root].kind != 65 {
                    diagnostic_parse_expected(tokens[index].start,103,start); return (0, 0);
                }
            }
        }
        while tuple_start < tuple_end {
            let binding_start = tokens[tuple_start].start;
            if tokens[tuple_start].kind == 16 { tuple_start = tuple_start + 1; }
            nodes[count] = AstNode { kind: 48, parent: copy(statement), start: binding_start,
                end: tokens[tuple_start].end, name_start: tokens[tuple_start].start,
                name_end: tokens[tuple_start].end, public: false,
            };
            count = count + 1;
            tuple_start = tuple_start + 1;
            if tokens[tuple_start].kind == 11 { tuple_start = tuple_start + 1; }
        }
        nodes[statement] = AstNode { kind: kind, parent: copy(free), start: start,
            end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false,
        };
    }
    nodes[free] = AstNode { kind: 2, parent: parent, start: tokens[first].start,
        end: tokens[index].end, name_start: 0, name_end: 0, public: false,
    };
    return (index + 1, count);
}

fn parse_function(tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, available: u64, parent: u64, item_start: u64, function_kind: i64) -> (u64, u64) {
    let method_addr = parent != 0 && tokens[first + 1].annotation == -2;
    if tokens[first].kind != 7 || !method_addr && !declaration_name(&tokens[first + 1]) {
        diagnostic_parse_expected(tokens[first + 1].start,113,item_start); return (0,0);
    }
    if tokens[first + 2].kind != 2 {
        diagnostic_parse_expected(tokens[first + 2].start,114,item_start); return (0,0);
    }
    let function = free;
    let name_start = tokens[first + 1].start;
    let name_end = tokens[first + 1].end;
    let mut count = available;
    let mut index = first + 3;
    while tokens[index].kind != 3 {
        let start = tokens[index].start;
        let receiver = tokens[index].kind == 25;
        if receiver { index = index + 1; }
        if tokens[index].kind == 16 { index = index + 1; }
        let name = copy(index);
        let mark = tokens[index].kind;
        if mark != 66 && !declaration_name(&tokens[index]) { diagnostic_parse_expected(tokens[index].start,115,item_start); return (0, 0); }
        let parameter = copy(count);
        count = count + 1;
        index = index + 1;
        if !receiver || mark != 66 {
            if tokens[index].kind != 10 { diagnostic_parse_expected(tokens[index].start,116,item_start); return (0, 0); }
            let (next, used) = parse_type(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                index + 1, copy(count), copy(parameter));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            count = used;
            index = next;
        }
        nodes[parameter] = AstNode { kind: 3, parent: copy(function), start: start,
            end: tokens[index - 1].end, name_start: tokens[name].start, name_end: tokens[name].end, public: false,
        };
        if tokens[index].kind != 3 {
            if tokens[index].kind != 11 { diagnostic_parse_expected(tokens[index].start,117,item_start); return (0, 0); }
            index = index + 1;
        }
    }
    index = index + 1;
    if tokens[index].kind == 12 {
        index = index + 1;
        let (next, used) = parse_type(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), copy(function));
        if next == 0 { diagnostic_parse_expected(tokens[index].start,118,item_start); return (0, 0); }
        index = next;
        count = used;
    }
    if function_kind == 71 {
        if tokens[index].kind != 14 { diagnostic_parse_expected(tokens[index].start,119,item_start); return (0, 0); }
        nodes[function] = AstNode { kind: 1, parent: parent, start: item_start,
            end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: false };
        return (index + 1, count);
    }
    if function_kind == 64 {
        if tokens[index].kind != 14 { diagnostic_parse_expected(tokens[index].start,119,item_start); return (0, 0); }
        nodes[function] = AstNode { kind: function_kind, parent: parent, start: item_start,
            end: tokens[index].end, name_start: name_start, name_end: name_end, public: false };
        return (index + 1, count);
    }
    let (next, used) = parse_block(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
        copy(index), copy(count), copy(function));
    if next == 0 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    nodes[function] = AstNode {
        kind: function_kind, parent: parent, start: item_start, end: tokens[next - 1].end,
        name_start: name_start, name_end: name_end, public: false,
    };
    return (next, used);
}

// A node index also identifies the scope or binding introduced by that node.

struct ExitContext {
    function: u64,
    loop_target: u64,
}

fn child_order(nodes: &[AstNode], left: u64, right: u64) -> bool {
    let left_kind = nodes[left].kind;
    let right_kind = nodes[right].kind;
    // A conditional pattern precedes its subject in source, but match analysis
    // always evaluates the subject before visiting either arm.
    if left_kind == 40 && right_kind != 40 { return false; }
    if left_kind != 40 && right_kind == 40 { return true; }
    if left_kind == 48 && right_kind != 48 { return false; }
    if left_kind != 48 && right_kind == 48 { return true; }
    if left_kind == 68 && (right_kind == 69 || right_kind == 70) { return true; }
    if right_kind == 68 && (left_kind == 69 || left_kind == 70) { return false; }
    nodes[left].start < nodes[right].start
}

fn set_child(graph: &mut [StaticNode], node: u64, child: u64) {
    let sibling = graph[node].next_sibling;
    graph[node] = StaticNode { first_child: child, next_sibling: sibling,
        scope: 0, scope_parent: 0, scope_entry: false, declaration: false,
        mutable: false, type_node: 0, initializer: 0, fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0, private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 };
}

fn set_sibling(graph: &mut [StaticNode], node: u64, sibling: u64) {
    let child = graph[node].first_child;
    graph[node] = StaticNode { first_child: child, next_sibling: sibling,
        scope: 0, scope_parent: 0, scope_entry: false, declaration: false,
        mutable: false, type_node: 0, initializer: 0, fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0, private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 };
}

fn find_binding(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    node: u64, visible: u64) -> u64 {
    let spelling = &source[nodes[node].name_start..nodes[node].name_end];
    let mut candidate = visible;
    while candidate != 0 {
        let name = &source[nodes[candidate].name_start..nodes[candidate].name_end];
        if spelling.content_eq(&name[0..name.len()]) { return candidate; }
        candidate = graph[candidate].visible;
    }
    0
}

fn resolve_node(source: &[u8], nodes: &[AstNode], tokens: &[Token], graph: &mut [StaticNode],
    node: u64, parent_scope: u64, visible: u64, shared_body: u64, context: &ExitContext, track_fields: bool) -> u64 {
    let kind = nodes[node].kind;
    let first_child = graph[node].first_child;
    let mut scope = copy(parent_scope);
    let mut scope_parent: u64 = 0;
    let mut body: u64 = 0;
    if kind == 1 || kind == 35 || kind == 55 || kind == 40 || kind == 27 || kind == 22 || kind == 64 {
        let mut last = copy(first_child);
        while last != 0 && graph[last].next_sibling != 0 { last = graph[last].next_sibling; }
        if last != 0 && nodes[last].kind == 2 {
            body = copy(last);
            scope = last;
        } else {
            scope = copy(node);
        }
        if kind == 22 { scope = copy(node); }
    } else if kind == 2 && node != shared_body {
        scope = copy(node);
    }
    let scope_entry = scope != parent_scope;
    if scope_entry { scope_parent = copy(parent_scope); }
    let mut function = (*context).function;
    let mut loop_target = (*context).loop_target;
    if kind == 1 || kind == 35 || kind == 55 {
        function = copy(node);
        loop_target = 0;
    }
    if kind == 22 || kind == 27 { loop_target = copy(node); }
    let destination: u64 = if kind == 6 { copy(function) }
        else if kind == 23 || kind == 24 { copy(loop_target) } else { 0 };
    let child_context = ExitContext { function: function, loop_target: loop_target };
    let mut candidate = copy(visible);
    let mut child = copy(first_child);
    let mut last_child: u64 = 0;
    let mut type_node: u64 = 0;
    while child != 0 {
        candidate = resolve_node(&source[0..source.len()], &nodes[0..nodes.len()], &tokens[0..tokens.len()],
            &mut graph[0..graph.len()], copy(child), copy(scope), candidate, copy(body), &child_context, copy(track_fields));
        if type_node == 0 && nodes[child].kind == 4 { type_node = copy(child); }
        last_child = copy(child);
        child = graph[child].next_sibling;
    }
    let spelling = &source[nodes[node].name_start..nodes[node].name_end];
    let mut introduces = kind == 5 || kind == 3 || kind == 48 || kind == 57;
    if kind == 41 && first_child == 0 && spelling.len() > 0 {
        introduces = spelling[0] >= 97 && spelling[0] <= 122;
    }
    if spelling.len() == 1 && spelling[0] == 95 { introduces = false; }
    let mut binding: u64 = 0;
    if kind == 7 || kind == 57 {
        binding = find_binding(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(node), copy(visible));
    }
    if kind == 52 {
        // Operand nodes carry their spelling in their byte span.
        let operand = &source[nodes[node].start..nodes[node].end];
        binding = copy(visible);
        while binding != 0 {
            let name = &source[nodes[binding].name_start..nodes[binding].name_end];
            if operand.content_eq(&name[0..name.len()]) { break; }
            binding = graph[binding].visible;
        }
    }
    let declaration = introduces;
    let method_new = kind == 16 && spelling.len() == 3
        && spelling[0] == 110 && spelling[1] == 101 && spelling[2] == 119;
    let fact = if kind == 57 && !declaration { 0 } else { fact_kind(copy(kind), method_new) };
    let mutable = point_mutable(&tokens[0..tokens.len()], nodes[node].start, nodes[node].name_start,
        copy(fact) == 3, copy(declaration));
    let mut field_name: u64 = 0;
    if track_fields && (kind == 31 || kind == 54) && nodes[node].name_start == nodes[node].name_end {
        field_name = (tokens.len() as u64) + nodes[node].name_start;
    } else if track_fields && (kind == 17 || kind == 31 || kind == 54) {
        // Resolve each member spelling to a canonical token span. The
        // verifier can compare field identities without reopening source.
        let mut token: u64 = 0;
        while token < tokens.len() as u64 {
            let candidate = &source[tokens[token].start..tokens[token].end];
            if spelling.content_eq(&candidate[0..candidate.len()]) {
                field_name = token + 1;
                break;
            }
            token = token + 1;
        }
    }
    let sibling = graph[node].next_sibling;
    graph[node] = StaticNode { first_child: first_child, next_sibling: sibling,
        scope: copy(scope), scope_parent: scope_parent, scope_entry: scope_entry, declaration: copy(declaration),
        mutable: mutable, type_node: if declaration { type_node } else { 0 },
        initializer: if declaration && kind == 5 { last_child } else { 0 },
        fact: fact, visible: copy(candidate), binding: binding, destination: destination, field_name: field_name, private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 };
    if scope != parent_scope || kind == 2 || kind == 1 || kind == 35 || kind == 55
        || kind == 40 || kind == 27 || kind == 22 || kind == 64 || kind == 58 { return visible; }
    if declaration { return node; }
    candidate
}

// Child links are the point's operands. Fact-specific payloads select these
// operands, except for resolved bindings, exit destinations and captures.
fn fact_kind(kind: i64, is_new: bool) -> i64 {
    if kind == 7 || kind == 52 { return 1; }
    if kind == 57 { return 2; }
    if kind == 13 { return 3; }
    if kind == 66 { return 4; }
    if kind == 16 && is_new { return 5; }
    if kind == 44 || kind == 45 || kind == 37 { return 6; }
    if kind == 55 { return 7; }
    if kind == 6 || kind == 23 || kind == 24 || kind == 10 { return 8; }
    if kind == 38 { return 9; }
    if kind == 18 || kind == 17 || kind == 14 { return 10; }
    if kind == 15 || kind == 16 { return 11; }
    if kind == 21 { return 12; }
    if kind == 26 || kind == 39 || kind == 22 { return 13; }
    if kind == 25 { return 14; }
    0
}


fn point_mutable(tokens: &[Token], start: u64, name_start: u64, borrow: bool, declaration: bool) -> bool {
    if !borrow && !declaration { return false; }
    let mut prefix = token_at(&tokens[0..tokens.len()], start);
    if borrow { return tokens[prefix + 1].kind == 16; }
    while tokens[prefix].kind != 0 && tokens[prefix].start < name_start {
        if tokens[prefix].kind == 16 { return true; }
        prefix = prefix + 1;
    }
    false
}

fn emit_point(nodes: &[AstNode], graph: &[StaticNode], node: u64) {
    print(graph[node].fact);
    print(if graph[node].mutable { 1 } else { 0 });
    print(graph[node].destination);
    print(if nodes[node].kind == 55 && nodes[node].name_end > nodes[node].name_start { 1 } else { 0 });
    print(graph[node].type_node);
    print(graph[node].initializer);
}

// Walk each closure's subtree once. The marker array deduplicates repeated
// uses of a declaration without clearing the array between closures.
fn emit_captures(nodes: &[AstNode], graph: &[StaticNode]) {
    let mut seen: [u64; 524289] = [0; 524289];
    let mut closure: u64 = 1;
    while closure < nodes.len() as u64 {
        if nodes[closure].kind == 55 {
            let scope = graph[closure].scope;
            let mut cursor = graph[closure].first_child;
            while cursor != 0 {
                let kind = nodes[cursor].kind;
                let binding = graph[cursor].binding;
                if binding != 0 && (kind == 7 || kind == 52) && seen[binding] != closure {
                    let origin_scope = graph[binding].scope;
                    let mut ancestor = nodes[closure].parent;
                    while ancestor != 0 && graph[ancestor].scope != origin_scope {
                        ancestor = nodes[ancestor].parent;
                    }
                    if graph[ancestor].scope == origin_scope && origin_scope != scope {
                        seen[binding] = copy(closure);
                        print(closure);
                        print(binding);
                    }
                }
                let child = graph[cursor].first_child;
                if child != 0 {
                    cursor = child;
                    continue;
                }
                while cursor != closure && graph[cursor].next_sibling == 0 {
                    cursor = nodes[cursor].parent;
                }
                if cursor == closure { break; }
                cursor = graph[cursor].next_sibling;
            }
        }
        closure = closure + 1;
    }
}

fn build_graph(source: &[u8], nodes: &[AstNode], tokens: &[Token], graph: &mut [StaticNode], track_fields: bool) {
    let mut node: u64 = 1;
    while node < nodes.len() as u64 {
        let parent = nodes[node].parent;
        let mut sibling = graph[parent].first_child;
        let mut previous: u64 = 0;
        while sibling != 0 && !child_order(&nodes[0..nodes.len()], copy(node), copy(sibling)) {
            previous = copy(sibling);
            sibling = graph[sibling].next_sibling;
        }
        set_sibling(&mut graph[0..graph.len()], copy(node), sibling);
        if previous == 0 {
            set_child(&mut graph[0..graph.len()], parent, copy(node));
        } else {
            set_sibling(&mut graph[0..graph.len()], previous, copy(node));
        }
        node = node + 1;
    }
    // Branch/lock contracts are metadata, not signature parameters. Keep their
    // AST ownership and child links while presenting an ordinary call signature.
    node = 1;
    while node < nodes.len() as u64 {
        if nodes[node].kind == 1 || nodes[node].kind == 35 || nodes[node].kind == 28 || nodes[node].kind == 29 {
            let mut first = graph[node].first_child;
            let branch: [u8; 6] = [98,114,97,110,99,104];
            let lock: [u8; 4] = [108,111,99,107];
            while nodes[first].kind == 58 {
                let word = &source[nodes[first].name_start..nodes[first].name_end];
                let thread_word: [u8; 6] = [116,104,114,101,97,100];
                if !word.content_eq(&branch[..]) && !word.content_eq(&lock[..]) && !word.content_eq(&thread_word[..]) { break; }
                if (nodes[node].kind == 28 || nodes[node].kind == 29)
                    && !word.content_eq(&lock[..]) && !word.content_eq(&thread_word[..]) { break; }
                first = graph[first].next_sibling;
            }
            set_child(&mut graph[0..graph.len()], copy(node), first);
        }
        node += 1;
    }
    let context = ExitContext { function: 0, loop_target: 0 };
    let visible = resolve_node(&source[0..source.len()], &nodes[0..nodes.len()], &tokens[0..tokens.len()], &mut graph[0..graph.len()], 0, 0, 0, 0, &context, track_fields);
    drop(visible);
}

fn emit_static_tree(source: &[u8], nodes: &[AstNode], tokens: &[Token], check: i32, env_call: u64, package: bool, visibility: &[LayoutVisibility]) -> i32 {
    let mut graph = [StaticNode { first_child: 0, next_sibling: 0, scope: 0, scope_parent: 0, scope_entry: false, declaration: false,
        mutable: false, type_node: 0, initializer: 0, fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0, private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 }; 524289];
    build_graph(&source[0..source.len()], &nodes[0..nodes.len()], &tokens[0..tokens.len()], &mut graph[..], true);
    let mut node: u64 = 0;
    if check != 0 {
        let mut layout: usize = 0;
        let mut declaration = graph[0].first_child;
        while declaration != 0 && layout < visibility.len() && visibility[layout].name != 0 {
            if nodes[declaration].name_start == visibility[layout].name
                && (nodes[declaration].kind == 28 || visibility[layout].kind != 0) {
                if visibility[layout].kind != 0 && visibility[layout].kind != 12 {
                    let fact = &mut graph[declaration].fact;
                    *fact = 40 + visibility[layout].kind;
                }
                let start = visibility[layout].start;
                let end = visibility[layout].end;
                let private_start = &mut graph[declaration].private_start;
                *private_start = start;
                let private_end = &mut graph[declaration].private_end;
                *private_end = end;
                let origin = &mut graph[declaration].private_origin;
                *origin = visibility[layout].origin;
                layout = layout + 1;
            }
            declaration = graph[declaration].next_sibling;
        }
        if layout < visibility.len() && visibility[layout].name != 0 { return 9; }
        let mut item = graph[0].first_child;
        let mut custom = false;
        while item != 0 {
            if nodes[item].kind == 49 { custom = true; }
            item = graph[item].next_sibling;
        }
        prepare_accesses(&source[0..source.len()], &nodes[0..nodes.len()], &mut graph[..]);
        let status = check_tree(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], &tokens[0..tokens.len()], copy(custom), check == 5 || check == 2 || check == 6 || check == 7, copy(env_call), package, check==6 || check==7);
        if status != 0 { return status; }
        if check == 5 || check == 7 || (check == 1 && !custom) { return 0; }
        if check==6 {
            if lower_program(&source[0..source.len()],&nodes[0..nodes.len()],&graph[..],false,false,true)
                && lower_program(&source[0..source.len()],&nodes[0..nodes.len()],&graph[..],true,false,true){return 0;}
            return 9;
        }
        if check == 2 {
            if emit_pool_c(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], false) == 0 {
                return emit_pool_c(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], true);
            }
            if lower_program(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], false, env_call != 0, false)
                && lower_program(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], true, env_call != 0, false) { return 0; }
            return 9;
        }
        return emit_pool_c(&source[0..source.len()], &nodes[0..nodes.len()], &graph[..], false);
    }
    print(-1);
    node = 0;
    while node < nodes.len() as u64 {
        print(graph[node].scope);
        print(graph[node].binding);
        print(graph[node].scope_parent);
        print(if graph[node].declaration { 1 } else { 0 });
        emit_point(&nodes[0..nodes.len()], &graph[..], copy(node));
        node = node + 1;
    }
    print(-3);
    node = 0;
    while node < nodes.len() as u64 {
        let mut child = graph[node].first_child;
        while child != 0 {
            print(node);
            print(child);
            child = graph[child].next_sibling;
        }
        node = node + 1;
    }
    print(-4);
    node = 1;
    while node < nodes.len() as u64 {
        if graph[node].scope_entry { print(graph[node].scope); }
        node = node + 1;
    }
    print(-2);
    emit_captures(&nodes[0..nodes.len()], &graph[..]);
    0
}

// Parse top-level items into a flat AST.
// The lexer always supplies a final EOF token.
fn parse_constant(tokens: &[Token], nodes: &mut [AstNode], first: u64,
    item: u64, parent: u64, item_start: u64, public: bool) -> (u64, u64) {
    if !declaration_name(&tokens[first + 1]) || tokens[first + 2].kind != 10 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let (equal, used) = parse_type(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
        first + 3, item + 1, copy(item));
    if equal == 0 || tokens[equal].kind != 13 { diagnostic_parse_point(tokens[first].start); return (0, 0); }
    let initializer = equal + 1;
    let negative = tokens[initializer].kind == 20;
    let literal = if negative { initializer + 1 } else { copy(initializer) };
    let kind = tokens[literal].kind;
    if (kind != 8 && kind != 64 && (kind != 18 || negative)) || tokens[literal + 1].kind != 14 {
        diagnostic_parse_point(tokens[first].start); return (0, 0);
    }
    if negative {
        nodes[used] = AstNode { kind: 12, parent: copy(item), start: tokens[initializer].start,
            end: tokens[literal].end, name_start: tokens[initializer].start,
            name_end: tokens[initializer].end, public: false };
        nodes[used + 1] = syntax_leaf(9, copy(used), &tokens[literal]);
    } else {
        nodes[used] = syntax_leaf(9, copy(item), &tokens[literal]);
    }
    nodes[item] = AstNode { kind: 76, parent: parent, start: item_start,
        end: tokens[literal + 1].end, name_start: tokens[first + 1].start,
        name_end: tokens[first + 1].end, public: public };
    (literal + 2, used + (if negative { 2 } else { 1 }))
}

fn parse_generic_parameters(tokens: &[Token], nodes: &mut [AstNode], first: u64,
    free: u64, parent: u64) -> (u64, u64) {
    let mut index = first + 1;
    let mut count = copy(free);
    while true {
        if !declaration_name(&tokens[index]) { diagnostic_parse_point(tokens[index].start); return (0, 0); }
        let mut previous = copy(free);
        while previous < count {
            if tokens[index].start == nodes[previous].name_start { diagnostic_parse_point(tokens[index].start); return (0, 0); }
            previous = previous + 1;
        }
        nodes[count] = AstNode { kind: 67, parent: copy(parent), start: tokens[index].start,
            end: tokens[index].end, name_start: tokens[index].start, name_end: tokens[index].end, public: false };
        count = count + 1;
        index = index + 1;
        if tokens[index].kind != 11 { break; }
        index = index + 1;
    }
    if tokens[index].kind != 24 { diagnostic_parse_point(tokens[index].start); return (0, 0); }
    return (index + 1, count);
}

fn parse_nodes(tokens: &[Token], nodes: &mut [AstNode]) -> u64 {
    let mut count: u64 = 1;
    let mut index: u64 = 0;
    if tokens[index].kind == 71 && tokens[index + 2].annotation == 1 {
        let (next, used) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(count), 0);
        if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
        index = next;
        count = used;
    }
    while tokens[index].kind != 0 {
        diagnostic_parse_root(tokens[index].start);
        let item_start = tokens[index].start;
        if tokens[index].kind == 56 {
            let (next, used) = parse_import(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
            index = next;
            count = used;
            continue;
        }
        let configurable = tokens[index].kind == 71 && tokens[index + 2].annotation == 31;
        if configurable {
            if tokens[index + 1].kind != 2 || tokens[index + 3].kind != 3 { diagnostic_parse_point(tokens[index].start); return 0; }
            index += 4;
        }
        let mut public = tokens[index].kind == 57;
        if public { index = index + 1; }
        if tokens[index].kind == 71 && tokens[index + 2].annotation == 24 {
            if public { diagnostic_parse_point(tokens[index].start); return 0; }
            let (next, used) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), 0);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
            index = next;
            count = used;
            continue;
        }
        let item = copy(count);
        while tokens[index].kind == 71 {
            if tokens[index + 2].annotation != 4 && tokens[index + 2].annotation != 5
                && tokens[index + 2].annotation != 22 && tokens[index + 2].annotation != 34 { diagnostic_parse_point(tokens[index].start); return 0; }
            if count == item { count = count + 1; }
            let (next, used) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), copy(item));
            if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
            index = next;
            count = used;
        }
        if tokens[index].kind == 57 {
            if public { diagnostic_parse_point(tokens[index].start); return 0; }
            public = true;
            index = index + 1;
        }
        let item_kind = tokens[index].kind;
        if configurable && item_kind != 81 { diagnostic_parse_point(tokens[index].start); return 0; }
        if count != item && item_kind != 7 && item_kind != 60 && item_kind != 73 && item_kind != 58 && item_kind != 59 { diagnostic_parse_point(tokens[index].start); return 0; }
        if item_kind == 81 {
            let (next, used) = parse_constant(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                copy(index), copy(count), 0, item_start, public);
            if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
            index = next;
            count = used;
            continue;
        }
        if item_kind == 58 || item_kind == 59 {
            if !declaration_name(&tokens[index + 1]) { diagnostic_parse_point(tokens[index].start); return 0; }
            let declaration = copy(item);
            let name_start = tokens[index + 1].start;
            let name_end = tokens[index + 1].end;
            if count == item { count = count + 1; }
            index = index + 2;
            if tokens[index].kind == 23 {
                let (next, used) = parse_generic_parameters(&tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(declaration));
                if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                index = next;
                count = used;
            }
            if tokens[index].kind != 4 { diagnostic_parse_point(tokens[index].start); return 0; }
            if item_kind == 58 {
                let (next, used) = parse_fields(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(count), copy(declaration), true);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                count = used;
                index = next;
            } else {
                index = index + 1;
                if tokens[index].kind == 5 { diagnostic_parse_point(tokens[index].start); return 0; }
                while tokens[index].kind != 5 {
                    if !declaration_name(&tokens[index]) { diagnostic_parse_point(tokens[index].start); return 0; }
                    let name = copy(index);
                    let variant = copy(count);
                    count = count + 1;
                    index = index + 1;
                    if tokens[index].kind == 4 {
                        let (next, used) = parse_fields(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                            copy(index), copy(count), copy(variant), true);
                        if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                        index = next;
                        count = used;
                    } else if tokens[index].kind == 2 {
                        let (next, used) = parse_positional_fields(0, &tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                            copy(index), copy(count), copy(variant), 4);
                        if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                        count = used;
                        index = next;
                    }
                    nodes[variant] = AstNode { kind: 30, parent: copy(declaration), start: tokens[name].start,
                        end: tokens[index - 1].end, name_start: tokens[name].start, name_end: tokens[name].end, public: false,
                    };
                    if tokens[index].kind != 11 { break; }
                    index = index + 1;
                }
                if tokens[index].kind != 5 { diagnostic_parse_point(tokens[index].start); return 0; }
                index = index + 1;
            }
            let kind = if item_kind == 58 { 28 } else { 29 };
            nodes[declaration] = AstNode { kind: kind, parent: 0, start: item_start,
                end: tokens[index - 1].end, name_start: name_start, name_end: name_end, public: copy(public),
            };
            continue;
        }
        if item_kind == 65 {
            if public { diagnostic_parse_point(tokens[index].start); return 0; }
            let implementation = copy(count);
            count = count + 1;
            index = index + 1;
            if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return 0; }
            let type_name = copy(index);
            index = index + 1;
            while tokens[index].kind == 43 {
                index = index + 1;
                if !lexical_name(tokens[index].kind) { diagnostic_parse_point(tokens[index].start); return 0; }
                index = index + 1;
            }
            if tokens[index].kind == 23 {
                let (next, used) = parse_generic_parameters(&tokens[0..tokens.len()],
                    &mut nodes[0..nodes.len()], copy(index), copy(count), copy(implementation));
                if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                index = next;
                count = used;
            }
            if tokens[index].kind != 4 { diagnostic_parse_point(tokens[index].start); return 0; }
            index = index + 1;
            while tokens[index].kind != 5 {
                if tokens[index].kind == 81 {
                    let start = tokens[index].start;
                    let (next, used) = parse_constant(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(implementation), start, false);
                    if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                    index = next;
                    count = used;
                    continue;
                }
                let method = copy(count);
                let method_start = tokens[index].start;
                count = count + 1;
                while tokens[index].kind == 71 {
                    if tokens[index + 2].annotation != 4 && tokens[index + 2].annotation != 5
                        && tokens[index + 2].annotation != 22 && tokens[index + 2].annotation != 34 { diagnostic_parse_point(tokens[index].start); return 0; }
                    let (after, total) = parse_annotation(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                        copy(index), copy(count), copy(method));
                    if after == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                    index = after;
                    count = total;
                }
                let method_public = tokens[index].kind == 57;
                if method_public { index += 1; }
                let method_kind: i64 = if tokens[index].kind == 60 { 35 } else { 1 };
                if copy(method_kind) == 35 { index += 1; }
                let (next, used) = parse_function(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
                    copy(index), copy(method), copy(count), copy(implementation), method_start, method_kind);
                if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
                let exported = &mut nodes[method].public;
                *exported = method_public;
                count = used;
                index = next;
            }
            nodes[implementation] = AstNode { kind: 49, parent: 0, start: item_start,
                end: tokens[index].end, name_start: tokens[type_name].start, name_end: tokens[type_name].end, public: false,
            };
            index = index + 1;
            continue;
        }
        let function_kind: i64 = if item_kind == 60 { 35 } else if item_kind == 73 { 64 } else { 1 };
        if item_kind == 60 { index = index + 1; }
        if item_kind == 73 {
            if tokens[index + 1].kind != 9 || tokens[index + 1].annotation != 26 {
                diagnostic_parse_point(tokens[index].start); return 0;
            }
            index = index + 2;
        }
        if (tokens.len() as u64) - index < 4 || tokens[index].kind != 7 { diagnostic_parse_point(tokens[index].start); return 0; }
        if !declaration_name(&tokens[index+1]) { diagnostic_parse_expected(tokens[index+1].start,113,item_start); return 0; }
        if tokens[index+2].kind != 2 { diagnostic_parse_expected(tokens[index+2].start,114,item_start); return 0; }

        if count == item { count = count + 1; }
        let (next, used) = parse_function(&tokens[0..tokens.len()], &mut nodes[0..nodes.len()],
            copy(index), copy(item), copy(count), 0, item_start, function_kind);
        if next == 0 { diagnostic_parse_point(tokens[index].start); return 0; }
        if public {
            let declaration = AstNode { kind: nodes[item].kind, parent: 0, start: nodes[item].start,
                end: nodes[item].end, name_start: nodes[item].name_start, name_end: nodes[item].name_end,
                public: true };
            nodes[item] = declaration;
        }
        count = used;
        index = next;
    }
    nodes[0] = AstNode {
        kind: 0, parent: 0, start: 0, end: tokens[index].end, name_start: 0, name_end: 0, public: false,
    };
    count
}

fn parse(source: &[u8], tokens: &[Token], check: i32, env_call: u64, package: bool, visibility: &[LayoutVisibility]) -> i32 {
    let mut nodes = [AstNode {
        kind: 0, parent: 0, start: 0, end: 0, name_start: 0, name_end: 0, public: false,
    }; 524289];
    diagnostic_parse_reset();
    let count = parse_nodes(&tokens[0..tokens.len()], &mut nodes[..]);
    if count == 0 { diagnostic_parse_error();return 7; }
    let mut node: usize = 0;
    while (node as u64) < count {
        if check != 0 && check != 4 { node = node + 1; continue; }
        print(nodes[node].kind);
        print(nodes[node].parent);
        print(nodes[node].start);
        print(nodes[node].end);
        print(nodes[node].name_start);
        print(nodes[node].name_end);
        print(if nodes[node].public { 1 } else { 0 });
        node = node + 1;
    }
    if check == 4 { return 0; }
    if check != 0 && has_configuration(&source[0..source.len()], &nodes[..node], &tokens[0..tokens.len()]) {
        return parse_configuration(&source[0..source.len()], &nodes[..node], &tokens[0..tokens.len()],
            check, env_call, package, &visibility[0..visibility.len()]);
    }
    if check != 0 && (has_iteration_syntax(&source[0..source.len()], &nodes[..node]) || has_self_type(&source[0..source.len()],&tokens[0..tokens.len()])) {
        return parse_callables(&source[0..source.len()],check,env_call,package,visibility);
    }
    let generic = generic_recipes(&source[0..source.len()], &nodes[..node]);
    if check != 0 && (generic || has_pipeline(&source[0..source.len()], &tokens[0..tokens.len()])) {
        return parse_pipeline(&source[0..source.len()], &nodes[..node], &tokens[0..tokens.len()],
            check, env_call, package, &visibility[0..visibility.len()], generic);
    }
    if check != 0 && has_callables(&source[0..source.len()], &nodes[..node]) {
        return parse_callables(&source[0..source.len()], check, env_call, package, visibility);
    }
    emit_static_tree(&source[0..source.len()], &nodes[..node], &tokens[0..tokens.len()], check, env_call, package, visibility)
}

// Recipe detection is reused by the iterative specialization workspace.
fn generic_recipes(source: &[u8], nodes: &[AstNode]) -> bool {
    let mut generic = false;
    let mut candidate: u64 = 1;
    while candidate < nodes.len() as u64 {
        let kind = nodes[candidate].kind;
        if (kind == 67 || (kind == 58 && nodes[candidate].name_end - nodes[candidate].name_start == 4
            && source[nodes[candidate].name_start] == 116)) && (nodes[nodes[candidate].parent].kind == 28 || nodes[nodes[candidate].parent].kind == 29)
            && !deferred_iterator(&source[0..source.len()], &nodes[0..nodes.len()], nodes[candidate].parent) { generic = true; }
        if kind == 58
            && (nodes[nodes[candidate].parent].kind == 1 || nodes[nodes[candidate].parent].kind == 35) {
            let type_name: [u8; 4] = [116,121,112,101];
            let name = &source[nodes[candidate].name_start..nodes[candidate].name_end];
            if name.content_eq(&type_name[..]) { generic = true; }
        }
        if kind == 36 {
            let suffix: [u8; 10] = [58,58,116,114,121,95,102,114,111,109];
            if nodes[candidate].end >= nodes[candidate].start + 10
                && same_bytes(&source[nodes[candidate].end - 10..nodes[candidate].end], &suffix[..])
                && verify_primitive(&source[0..source.len()], nodes[candidate].name_start, nodes[candidate].name_end) != 0 { generic = true; }
        }
        candidate = candidate + 1;
    }
    generic
}

// Configuration monomorphization precedes generic/callable specialization.
fn parse_configuration(source: &[u8], nodes: &[AstNode], tokens: &[Token], check: i32,
    env_call: u64, package: bool, visibility: &[LayoutVisibility]) -> i32 {
    if source.len() >= 4194304 { return 4; }
    let mut graph = [StaticNode { first_child: 0, next_sibling: 0, scope: 0, scope_parent: 0,
        scope_entry: false, declaration: false, mutable: false, type_node: 0, initializer: 0,
        fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0,
        private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 }; 524289];
    build_graph(&source[0..source.len()],&nodes[0..nodes.len()],&tokens[0..tokens.len()], &mut graph[..], true);
    let mut output: [u8; 4194304] = [0; 4194304];
    let mut offsets: [u64; 4194304] = [0; 4194304];
    let mut views = [LayoutVisibility { kind: 0, name: 0, start: 0, end: 0, origin: 0 }; 4096];
    diagnostic_stage(&source[0..source.len()]);
    let (error, written, view_count) = expand_configuration(&source[0..source.len()],&nodes[0..nodes.len()], &graph[..nodes.len()],&tokens[0..tokens.len()],
        &mut output[..], &mut offsets[..],&visibility[0..visibility.len()], &mut views[..]);
    if error != 0 { return error; }
    diagnostic_rewritten(&output[..written],&offsets[..],source.len());
    let mut rewritten = [Token { nominal: false, annotation: 0, kind: 0, start: 0, end: 0 }; 524292];
    let (status, count) = scan_tokens(&output[..written], &mut rewritten[..], copy(check));
    if status != 0 { return status; }
    let selected = select_target(&output[..written], &mut rewritten[..count + 3]);
    if selected == 0 { return 7; }
    mark_nominal_names(&output[..written], &mut rewritten[..selected]);
    let env: u64 = if env_call == 0 { 0 } else { offsets[env_call] };
    parse(&output[..written], &rewritten[..selected], check, env, package, &views[..view_count])
}

// Callable expansion reuses its syntax and graph workspace. Generated capture
// records enter the ordinary verifier, summaries and placement plan.
fn parse_callables(source: &[u8], check: i32, env_call: u64, package: bool,
    visibility: &[LayoutVisibility]) -> i32 {
    if source.len() >= 4194304 { return 4; }
    let mut current: [u8; 4194304] = [0; 4194304];
    let mut expanded: [u8; 4194304] = [0; 4194304];
    let mut offsets: [u64; 4194304] = [0; 4194304];
    // Sparse output-name -> original implementation-name map for this rewrite.
    let mut impl_origins: [u64; 32769] = [0; 32769];
    let mut syntax = [AstNode { kind: 0, parent: 0, start: 0, end: 0,
        name_start: 0, name_end: 0, public: false }; 524289];
    let mut tokens = [Token { nominal: false, annotation: 0, kind: 0, start: 0, end: 0 }; 524292];
    let mut graph = [StaticNode { first_child: 0, next_sibling: 0, scope: 0, scope_parent: 0,
        scope_entry: false, declaration: false, mutable: false, type_node: 0, initializer: 0,
        fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0,
        private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 }; 524289];
    let mut views = [LayoutVisibility { kind: 0, name: 0, start: 0, end: 0, origin: 0 }; 4096];
    let mut length = source.len() as u64;
    let mut byte: u64 = 0;
    while byte < length { current[byte] = source[byte]; byte = byte + 1; }
    let mut view: usize = 0;
    while view < visibility.len() && visibility[view].name != 0 {
        views[view] = LayoutVisibility { kind: visibility[view].kind, name: visibility[view].name,
            start: visibility[view].start, end: visibility[view].end, origin: visibility[view].origin };
        view = view + 1;
    }
    let mut env = env_call;
    loop {
        let (error, count) = scan_tokens(&current[..length], &mut tokens[..], 2);
        if error != 0 { return error; }
        let selected = select_target(&current[..length], &mut tokens[..count + 3]);
        if selected == 0 { return 7; }
        mark_nominal_names(&current[..length], &mut tokens[..selected]);
        diagnostic_parse_reset();
        let used = parse_nodes(&tokens[..selected], &mut syntax[..]);
        if used == 0 { diagnostic_parse_error();return 7; }
        let mut reset: u64 = 0;
        while reset < used {
            graph[reset] = StaticNode { first_child: 0, next_sibling: 0, scope: 0, scope_parent: 0,
                scope_entry: false, declaration: false, mutable: false, type_node: 0, initializer: 0,
                fact: 0, visible: 0, binding: 0, destination: 0, field_name: 0,
                private_start: 0, private_end: 0, private_origin: 0, access_mode: 0, protection: 0 };
            reset = reset + 1;
        }
        build_graph(&current[..length], &syntax[..used], &tokens[..selected], &mut graph[..], true);
        let empty_values:[CheckedValue;1]=[CheckedValue {ty:0,state:0,mutable:false,target:0,loan_parent:0,origin_call:0,writable:false};1];
        semantic_begin(&current[..length],&syntax[..used],&graph[..used],&empty_values[0..0],diagnostic_enabled());
        let generic = generic_recipes(&current[..length], &syntax[..used]);
        let factory = iterator_factory(&current[..length], &syntax[..used]);
        impl_origins[0] = 0;
        diagnostic_stage(&current[..length]);
        let mut rewrite_status: i32 = 0;
        let mut rewrite_length: u64 = 0;
        let (self_status,self_length)=expand_self_type(&current[..length],&syntax[..used],&graph[..used],&tokens[..selected],&mut expanded[..],&mut offsets[..]);
        if self_status!=0{return self_status;}
        let no_error:i32=0;
        let (syntax_status, syntax_length) = if self_length!=0{(no_error,self_length)}else{expand_iteration_syntax(&current[..length], &syntax[..used], &graph[..used],
            &tokens[..selected], &mut expanded[..], &mut offsets[..])};
        if syntax_status != 0 { return syntax_status; }
        rewrite_length = syntax_length;
        if rewrite_length == 0 && (generic || factory != 0 || has_pipeline(&current[..length], &tokens[..selected])) {
            let (status, written) = rewrite_pipeline(&current[..length], &syntax[..used], &graph[..used],
                &tokens[..selected], generic, factory, &mut expanded[..], &mut offsets[..], &mut impl_origins[..]);
            rewrite_status = status;
            rewrite_length = written;
        }
        if rewrite_status != 0 { return rewrite_status; }
        let mut status: i32 = 0;
        let mut written = copy(rewrite_length);
        if rewrite_length == 0 {
            let (result, expanded_length) = specialize_callables(&current[..length], &syntax[..used], &graph[..used],
                &tokens[..selected], &mut expanded[..], &mut offsets[..]);
            status = result;
            written = expanded_length;
        }
        if status != 0 { return status; }
        if written == 0 {
            diagnostic_stage_idle();
            return emit_static_tree(&current[..length], &syntax[..used], &tokens[..selected],
                check, env, package, &views[..view]);
        }
        if written >= 4194304 { return 4; }
        if written == length {
            let previous = &current[..length];
            if previous.content_eq(&expanded[..written]) { return 7; }
        }
        diagnostic_rewritten(&expanded[..written],&offsets[..],length as usize);
        // Private generic layouts produce one visibility record per concrete
        // instance; an omitted template is not itself an output declaration.
        let mut generic_layout = false;
        let mut item: usize = 0;
        while item < view {
            let mut end = views[item].name;
            while end < length && ((current[end] >= 48 && current[end] <= 57) || (current[end] >= 65 && current[end] <= 90) || (current[end] >= 97 && current[end] <= 122) || current[end] == 95) { end += 1; }
            while end < length && current[end] <= 32 { end += 1; }
            if (views[item].kind == 0 || views[item].kind == 14) && end < length && current[end] == 60 { generic_layout = true; }
            item += 1;
        }
        if generic_layout {
            let (error, count) = scan_tokens(&expanded[..written], &mut tokens[..], 2);
            if error != 0 { return error; }
            let selected = select_target(&expanded[..written], &mut tokens[..count+3]);
            if selected == 0 { return 7; }
            mark_nominal_names(&expanded[..written], &mut tokens[..selected]);
            diagnostic_parse_reset();
            let count = parse_nodes(&tokens[..selected], &mut syntax[..]);
            if count == 0 { diagnostic_parse_error();return 7; }
            let mut mapped = [LayoutVisibility { kind: 0, name: 0, start: 0, end: 0, origin: 0 }; 4096];
            let prefix: [u8;20] = [95,95,99,111,114,98,111,95,115,112,101,99,105,97,108,105,122,101,100,95];
            let mut stored: usize = 0;
            item = 0;
            while item < view {
                let mut end = views[item].name;
                while end < length && ((current[end] >= 48 && current[end] <= 57) || (current[end] >= 65 && current[end] <= 90) || (current[end] >= 97 && current[end] <= 122) || current[end] == 95) { end += 1; }
                let old_start = views[item].name;
                let name_length = end - old_start;
                let mut candidate: u64 = 1;
                let mut found = false;
                while candidate < count {
                    if syntax[candidate].parent == 0 && (syntax[candidate].kind == 28 || views[item].kind != 0) {
                        let actual_start = syntax[candidate].name_start;
                        let actual_end = syntax[candidate].name_end;
                        let actual_length = actual_end - actual_start;
                        let direct = actual_start == offsets[views[item].name]
                            && same_bytes(&expanded[actual_start..actual_end], &current[old_start..end]);
                        let minimum: u64 = name_length + 21;
                        let mut instance = false;
                        if (views[item].kind == 0 || views[item].kind == 14) && syntax[candidate].kind == 28 && actual_length > minimum {
                            let prefix_end = actual_start + 20;
                            let origin_end = prefix_end + copy(name_length);
                            instance = same_bytes(&expanded[actual_start..prefix_end], &prefix[..])
                                && same_bytes(&expanded[prefix_end..origin_end], &current[old_start..end]) && expanded[origin_end] == 95;
                        }
                        if direct || instance {
                            if stored == 4096 { return 4; }
                            let mut upper = syntax[candidate].end;
                            // Implementations carry their own authenticated origin;
                            // the declaration range must not include foreign impls.
                            mapped[stored] = LayoutVisibility { kind: views[item].kind, name: actual_start,
                                start: if instance { syntax[candidate].start } else { offsets[views[item].start] },
                                end: if instance { upper } else { offsets[views[item].end] }, origin: views[item].origin };
                            stored += 1; found = true;
                        }
                    }
                    candidate += 1;
                }
                while end < length && current[end] <= 32 { end += 1; }
                if !found && (views[item].kind != 0 || end == length || current[end] != 60) { return 9; }
                item += 1;
            }
            // Authenticate each generated implementation by the file which
            // authored it, rather than by the type it happens to implement.
            let mut implementation: u64 = 0;
            while implementation < impl_origins[0] {
                let original = impl_origins[implementation * 2 + 2];
                let mut owner: usize = 0;
                while owner < view {
                    if (views[owner].kind == 0 || views[owner].kind == 14) && original >= views[owner].start && original < views[owner].end {
                        if stored == 4096 { return 4; }
                        mapped[stored] = LayoutVisibility { kind: 12,
                            name: impl_origins[implementation * 2 + 1], start: 0, end: 0, origin: views[owner].origin };
                        stored += 1;
                        break;
                    }
                    owner += 1;
                }
                implementation += 1;
            }
            // emit_static_tree consumes records in declaration order.
            item = 1;
            while item < stored {
                let mut at = copy(item);
                while at > 0 && mapped[at-1].name > mapped[at].name {
                    let saved = LayoutVisibility { kind: mapped[at-1].kind, name: mapped[at-1].name, start: mapped[at-1].start, end: mapped[at-1].end, origin: mapped[at-1].origin };
                    mapped[at-1] = LayoutVisibility { kind: mapped[at].kind, name: mapped[at].name, start: mapped[at].start, end: mapped[at].end, origin: mapped[at].origin };
                    mapped[at] = saved; at -= 1;
                }
                item += 1;
            }
            item = 0;
            while item < stored { views[item] = LayoutVisibility { kind: mapped[item].kind, name: mapped[item].name, start: mapped[item].start, end: mapped[item].end, origin: mapped[item].origin }; item += 1; }
            view = stored;
        } else {
            item = 0;
            while item < view {
                views[item] = LayoutVisibility { kind: views[item].kind, name: offsets[views[item].name],
                    start: offsets[views[item].start], end: offsets[views[item].end], origin: views[item].origin };
                item += 1;
            }
        }
        if env != 0 { env = offsets[env]; }
        byte = 0;
        while byte < written { current[byte] = expanded[byte]; byte = byte + 1; }
        length = written;
    }
    9
}

fn rewrite_pipeline(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    generic: bool, factory: u64, expanded: &mut [u8], offsets: &mut [u64], origins: &mut [u64]) -> (i32, u64) {
    if factory != 0 {
        return specialize_factory(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], factory, expanded, offsets);
    }
    if generic {
        let (method_status, method_written) = promote_method_templates(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()], &mut expanded[0..expanded.len()], &mut offsets[0..offsets.len()]);
        if method_status != 0 || method_written != 0 { return (method_status, method_written); }
        let (conversion_status, conversion_written) = specialize_conversion(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()],
            &mut expanded[0..expanded.len()], &mut offsets[0..offsets.len()]);
        if conversion_status != 0 || conversion_written != 0 { return (conversion_status, conversion_written); }
        let (status, written) = specialize_functions(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()],
            &mut expanded[0..expanded.len()], &mut offsets[0..offsets.len()]);
        if status != 0 || written != 0 { return (status, written); }
        return specialize_structs(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()], expanded, offsets, origins);
    }
    specialize_pipelines(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()], expanded, offsets)
}

fn parse_pipeline(source: &[u8], nodes: &[AstNode], tokens: &[Token], check: i32,
    env_call: u64, package: bool, visibility: &[LayoutVisibility], generic: bool) -> i32 {
    drop(nodes); drop(tokens); drop(generic);
    parse_callables(&source[0..source.len()], check, env_call, package, &visibility[0..visibility.len()])
}

fn main() -> i32 {
    match args() {
        Err(error) => { drop(error); return 6; },
        Ok(arguments) => {
            if arguments.len() != 0 {
                let command = arguments[0];
                let bytes = command.as_bytes();
                let new_flag: [u8; 3] = [110,101,119];
                if bytes.content_eq(&new_flag[..]) {
                    if arguments.len() != 2 { return new_usage(); }
                    let name = arguments[1];
                    let name_bytes = name.as_bytes();
                    return new_package(name_bytes);
                }
                let package_check_flag: [u8; 5] = [99,104,101,99,107];
                if bytes.content_eq(&package_check_flag[..]) {
                    diagnostic_enable();
                    let current: [u8; 1] = [46];
                    let watch_flag: [u8; 7] = [45,45,119,97,116,99,104];
                    if arguments.len() == 1 { return check_package(&current[..], false); }
                    let first = arguments[1];
                    let first_bytes = first.as_bytes();
                    if arguments.len() == 2 {
                        if first_bytes.content_eq(&watch_flag[..]) { return check_package(&current[..], true); }
                        if first_bytes.len() == 0 || first_bytes[0] == 45 { return check_usage(); }
                        return check_package(first_bytes, false);
                    }
                    if arguments.len() == 3 {
                        let second = arguments[2];
                        let second_bytes = second.as_bytes();
                        if first_bytes.content_eq(&watch_flag[..]) {
                            if second_bytes.len() == 0 || second_bytes[0] == 45 { return check_usage(); }
                            return check_package(second_bytes, true);
                        }
                        if second_bytes.content_eq(&watch_flag[..]) && first_bytes.len() > 0 && first_bytes[0] != 45 {
                            return check_package(first_bytes, true);
                        }
                    }
                    return check_usage();
                }
                let build_flag: [u8; 5] = [98,117,105,108,100];
                if bytes.content_eq(&build_flag[..]) {
                    diagnostic_enable();
                    let current: [u8; 1] = [46];
                    let output_flag: [u8; 2] = [45,111];
                    if arguments.len() == 1 { return build_default(&current[..]); }
                    let first = arguments[1];
                    let first_bytes = first.as_bytes();
                    if arguments.len() == 2 {
                        if first_bytes.len() == 0 || first_bytes[0] == 45 { return build_usage(); }
                        return build_default(first_bytes);
                    }
                    if arguments.len() == 3 {
                        if !first_bytes.content_eq(&output_flag[..]) { return build_usage(); }
                        let output = arguments[2];
                        let output_bytes = output.as_bytes();
                        return build_package(&current[..], output_bytes);
                    }
                    if arguments.len() == 4 {
                        let option = arguments[2];
                        let option_bytes = option.as_bytes();
                        if !option_bytes.content_eq(&output_flag[..]) { return build_usage(); }
                        let output = arguments[3];
                        let output_bytes = output.as_bytes();
                        return build_package(first_bytes, output_bytes);
                    }
                    return build_usage();
                }
            }
            if arguments.len() == 2 || arguments.len() == 4 {
                let flag = arguments[0];
                let check_flag: [u8; 7] = [45, 45, 99, 104, 101, 99, 107];
                let bytes = flag.as_bytes();
                let package_flag_bytes: [u8; 16] = [45, 45, 101, 109, 105, 116, 45, 112, 97, 99, 107, 97, 103, 101, 45, 99]; // --emit-package-c
                let package_flag = &package_flag_bytes[..];
                if bytes.content_eq(&package_flag[0..package_flag.len()]) {
                    let directory = arguments[1];
                    let directory_bytes = directory.as_bytes();
                    if arguments.len() == 2 {
                        let empty: [u8; 0] = [];
                        return compile_package(directory_bytes, &empty[..]);
                    }
                    let option = arguments[2];
                    let option_bytes = option.as_bytes();
                    let stdlib_flag: [u8; 12] = [45, 45, 115, 116, 100, 108, 105, 98, 45, 100, 105, 114]; // --stdlib-dir
                    if !option_bytes.content_eq(&stdlib_flag[..]) { return 6; }
                    let stdlib = arguments[3];
                    let stdlib_bytes = stdlib.as_bytes();
                    return compile_package(directory_bytes, stdlib_bytes);
                }
                if arguments.len() != 2 { return 6; }
                let emit_flag: [u8; 8] = [45, 45, 101, 109, 105, 116, 45, 99];
                let lex_flag: [u8; 5] = [45, 45, 108, 101, 120];
                let ast_flag: [u8; 5] = [45, 45, 97, 115, 116];
                let verify_flag: [u8; 8] = [45,45,118,101,114,105,102,121];
                let runtime_flag:[u8;16]=[45,45,101,109,105,116,45,114,117,110,116,105,109,101,45,99];
                let mode: i32 = if bytes.content_eq(&check_flag[..]) { 1 }
                    else if bytes.content_eq(&emit_flag[..]) { 2 }
                    else if bytes.content_eq(&lex_flag[..]) { 3 }
                    else if bytes.content_eq(&ast_flag[..]) { 4 }
                    else if bytes.content_eq(&verify_flag[..]) { 5 }
                    else if bytes.content_eq(&runtime_flag[..]) { 6 } else { 0 };
                if mode == 0 { return 6; }
                let filename = arguments[1];
                let path = filename.as_bytes();
                return compile_file(path, mode);
            }
            if arguments.len() != 1 { return 6; }
            let argument = arguments[0];
            let path = argument.as_bytes();
            return compile_file(path, 0);
        },
    };
}

// Package and file checks return before C generation and share verification.
fn check_once(root: &[u8], file: &[u8], stdlib: &[u8], kind: i32) -> i32 {
    diagnostic_begin();
    if kind == 0 {
        check_message("corboc: checking package\n");
    } else {
        check_message("corboc: checking file (with module context)\n");
    }
    let result: i32 = if kind != 0 && !check_file_present(&file[0..file.len()]) {
        11
    } else if kind == 1 {
        compile_input_selection(&root[0..root.len()], stdlib, 7, false, &file[0..file.len()])
    } else if kind == 2 {
        compile_input_mode(&file[0..file.len()], stdlib, 7, true)
    } else {
        compile_input_mode(&root[0..root.len()], stdlib, if kind == 0 { 5 } else { 7 }, false)
    };
    if result == 0 {
        check_message("corboc: check passed\n");
    } else {
        if kind!=0 {diagnostic_finish(&file[0..file.len()],result);} else {diagnostic_finish(&root[0..root.len()],result);}
        check_message("corboc: check failed (see compiler diagnostics)\n");
    }
    result
}

fn check_package(input: &[u8], watch: bool) -> i32 {
    diagnostic_begin();
    let mut root: [u8; 4096] = [0; 4096];
    let mut file: [u8; 4096] = [0; 4096];
    let context = check_target(&input[0..input.len()], &mut root[..], &mut file[..]);
    let kind = context.kind;
    let root_end = context.root_end;
    let file_end = context.file_end;
    if kind > 2 {
        diagnostic_finish(input,kind);
        return kind;
    }
    let mut stdlib: [u8; 4096] = [0; 4096];
    let end = installed_stdlib(&mut stdlib[..]);
    if end == 0 {
        check_message("corboc: cannot locate installed STD at ../share/corbo/stdlib/src\n");
        return 11;
    }
    if !watch {
        return check_once(&root[..root_end], &file[..file_end], &stdlib[..end], kind);
    }
    let mut observed: [u8; 32] = [0; 32];
    let mut scan_status = check_snapshot(
        &root[..root_end],
        &file[..file_end],
        &stdlib[..end],
        &mut observed[..]
    );
    refresh_terminal();
    drop(check_once(
        &root[..root_end],
        &file[..file_end],
        &stdlib[..end],
        kind
    ));
    check_message("corboc: watching sources, dependencies and manifests; press Ctrl-C to stop\n");
    let mut dirty = false;
    while true {
        if !pause() {
            check_message("corboc: watcher sleep failed\n");
            return 11;
        }
        let mut current: [u8; 32] = [0; 32];
        let current_status = check_snapshot(
            &root[..root_end],
            &file[..file_end],
            &stdlib[..end],
            &mut current[..]
        );
        if scan_status != current_status || watch_changed(&observed[..], &current[..]) {
            let mut at: usize = 0;
            while at < 32 {
                observed[at] = current[at];
                at += 1;
            }
            scan_status = current_status;
            dirty = true;
        } else if dirty {
            // Two stable snapshots debounce saves. Failed checks keep watching;
            // missing dependency directories are retried by subsequent snapshots.
            refresh_terminal();
            if scan_status == 0 {
                drop(check_once(
                    &root[..root_end],
                    &file[..file_end],
                    &stdlib[..end],
                    kind
                ));
            } else {
                check_message("corboc: source scan failed; waiting for readable files\n");
            }
            check_message("corboc: watching sources, dependencies and manifests; press Ctrl-C to stop\n");
            dirty = false;
        }
    }
    0
}

fn compile_file(filename: &[u8], check: i32) -> i32 {
    if filename.len() >= 4096 { return 6; }
    let mut path: [u8; 4096] = [0; 4096];
    let mut index: usize = 0;
    while index < filename.len() {
        path[index] = filename[index];
        index = index + 1;
    }
    let mut buffer: [u8; 524288] = [0; 524288];
    let (status, filled) = read_source(&path[..index + 1], &mut buffer[..]);
    if status != 0 { return status; }
    lex(&buffer[..filled], check)
}

fn compile_package(root: &[u8], stdlib: &[u8]) -> i32 {
    compile_package_mode(root, stdlib, 2)
}

// Package resolution/linking is identical for verification and code generation.
fn compile_package_mode(root: &[u8], stdlib: &[u8], mode: i32) -> i32 {
    compile_input_mode(root,stdlib,mode,false)
}

/// Match a module path against a qualified token sequence without resolving
/// symbols. The linker still decides visibility, aliases and ambiguities.
fn check_module_end(source: &[u8], tokens: &[Token], first: usize, module: &[u8]) -> usize {
    let mut at: usize = 0;
    let mut token = first;
    while at < module.len() {
        let start = at;
        while at < module.len() && module[at] != 58 { at += 1; }
        if token >= tokens.len() || tokens[token].kind == 0 { return 0; }
        let expected = &module[start..at];
        if tokens[token].kind == 4 {
            // Grouped imports name several alternative components after the
            // same qualified prefix. Skip aliases while finding that member.
            token += 1;
            loop {
                if token >= tokens.len() || tokens[token].kind == 0 || tokens[token].kind == 5 { return 0; }
                let member = &source[tokens[token].start..tokens[token].end];
                if member.content_eq(&expected[0..expected.len()]) { break; }
                while token < tokens.len() && tokens[token].kind != 0 && tokens[token].kind != 5
                    && tokens[token].kind != 11 { token += 1; }
                if tokens[token].kind != 11 { return 0; }
                token += 1;
            }
        }
        let actual = &source[tokens[token].start..tokens[token].end];
        if !actual.content_eq(&expected[0..expected.len()]) { return 0; }
        token += 1;
        if at < module.len() {
            if at + 1 >= module.len() || module[at + 1] != 58 || tokens[token].kind != 43 { return 0; }
            at += 2;
            token += 1;
        }
    }
    token
}

fn check_module_prefix(source: &[u8], tokens: &[Token], first: usize, module: &[u8]) -> bool {
    check_module_end(source, tokens, first, module) != 0
}

/// Select only the requested module and its transitive qualified/imported
/// modules. Original source identities are retained through compaction.
fn focus_check_input(source: &mut [u8], names: &[u8], files: &mut [PackageFile],
    tokens: &mut [Token], path: &[u8], mode: i32) -> (i32, u64, u64) {
    let total = files.len();
    let mut primary: usize = total;
    let mut file: usize = 0;
    while file < total {
        let identity = &names[files[file].path_start..files[file].path_end];
        if identity.content_eq(&path[0..path.len()]) { primary = file; break; }
        file += 1;
    }
    if primary == total { return (11, 0, 0); }
    let mut selected: [bool; 256] = [false; 256];
    let mut visited: [bool; 256] = [false; 256];
    let module = &names[files[primary].module_start..files[primary].module_end];
    file = 0;
    while file < total {
        let other = &names[files[file].module_start..files[file].module_end];
        selected[file] = files[file].package == 64 || other.content_eq(&module[0..module.len()]);
        file += 1;
    }
    // Keep offsets global during discovery so lexical/configuration diagnostics
    // map directly to the original file, even before source reordering.
    let mut working: [u8; 4194304] = [32; 4194304];
    let mut previous_start: usize = 0;
    let mut previous_end: usize = 0;
    loop {
        let mut next: usize = total;
        if !visited[primary] { next = primary; }
        if next == total {
            file = 0;
            while file < total {
                if selected[file] && !visited[file] && files[file].package != 64 { next = file; break; }
                file += 1;
            }
        }
        if next == total { break; }
        visited[next] = true;
        let start: usize = if next == 0 { 0 } else { files[next - 1].end as usize + 1 };
        let end = files[next].end as usize + 1;
        let mut at = previous_start;
        while at < previous_end { working[at] = 32; at += 1; }
        drop(append(&mut working[..], start, &source[start..end]));
        previous_start = start;
        previous_end = end;
        let (status, count) = scan_tokens(&working[..end], &mut tokens[0..tokens.len()], copy(mode));
        if status != 0 { return (status, 0, 0); }
        let used = select_target(&working[..end], &mut tokens[0..count + 3]);
        if used == 0 { return (7, 0, 0); }
        let mut token: usize = 0;
        while token + 1 < used && tokens[token].kind != 0 {
            if tokens[token + 1].kind == 43 && (token == 0 || tokens[token - 1].kind != 43) {
                let mut longest: usize = 0;
                file = 0;
                while file < total {
                    let candidate = &names[files[file].module_start..files[file].module_end];
                    if candidate.len() > longest && check_module_prefix(&source[0..source.len()],
                        &tokens[0..used], token, &candidate[0..candidate.len()]) { longest = candidate.len(); }
                    file += 1;
                }
                if longest != 0 {
                    file = 0;
                    while file < total {
                        let candidate = &names[files[file].module_start..files[file].module_end];
                        if candidate.len() == longest && check_module_prefix(&source[0..source.len()],
                            &tokens[0..used], token, &candidate[0..candidate.len()]) { selected[file] = true; }
                        file += 1;
                    }
                }
            }
            token += 1;
        }
        // Import aliases are lexical to this file. Preserve module aliases,
        // grouped imports and qualified descendants without pulling in every
        // other module of the dependency package.
        let mut alias_tokens: [usize; 4096] = [0; 4096];
        let mut alias_files: [usize; 4096] = [0; 4096];
        let mut aliases: usize = 0;
        token = 0;
        let use_word = "use";
        let use_bytes = use_word.as_bytes();
        while token + 1 < used && tokens[token].kind != 0 {
            let spelling = &source[tokens[token].start..tokens[token].end];
            if spelling.content_eq(&use_bytes[0..use_bytes.len()]) {
                file = 0;
                while file < total {
                    let candidate = &names[files[file].module_start..files[file].module_end];
                    let end = check_module_end(&source[0..source.len()], &tokens[0..used], token + 1,
                        &candidate[0..candidate.len()]);
                    if end != 0 {
                        let kind = tokens[end].kind;
                        if kind == 43 && tokens[end + 1].kind == 4 { selected[file] = true; }
                        if kind == 41 || kind == 14 || kind == 11 || kind == 5 {
                            selected[file] = true;
                            if aliases == 4096 { return (4, 0, 0); }
                            alias_tokens[aliases] = if kind == 41 { end + 1 } else { end - 1 };
                            alias_files[aliases] = file;
                            aliases += 1;
                        }
                    }
                    file += 1;
                }
            }
            token += 1;
        }
        token = 0;
        while token + 1 < used && tokens[token].kind != 0 {
            if tokens[token + 1].kind == 43 {
                let actual = &source[tokens[token].start..tokens[token].end];
                let mut alias: usize = 0;
                while alias < aliases {
                    let name = alias_tokens[alias];
                    let spelling = &source[tokens[name].start..tokens[name].end];
                    if actual.content_eq(spelling) {
                        let owner = alias_files[alias];
                        let prefix = &names[files[owner].module_start..files[owner].module_end];
                        file = 0;
                        while file < total {
                            let candidate = &names[files[file].module_start..files[file].module_end];
                            let length = prefix.len();
                            if candidate.len() > length + 2 && candidate[length] == 58 && candidate[length + 1] == 58 {
                                let head = &candidate[0..length];
                                if head.content_eq(&prefix[0..prefix.len()]) && check_module_prefix(&source[0..source.len()],
                                    &tokens[0..used], token + 2, &candidate[length + 2..candidate.len()]) { selected[file] = true; }
                            }
                            file += 1;
                        }
                    }
                    alias += 1;
                }
            }
            token += 1;
        }
    }
    let mut ordered = [PackageFile { end: 0, module_start: 0, module_end: 0,
        entry: false, package: 0, visible: 0, path_start: 0, path_end: 0 }; 256];
    let mut written: usize = 0;
    let mut count: usize = 0;
    let mut pass: usize = 0;
    diagnostic_stage(&source[0..source.len()]);
    while pass <= total {
        let mut selected_file: usize = primary;
        if pass != 0 { selected_file = pass - 1; }
        pass += 1;
        if !selected[selected_file] || (pass > 1 && selected_file == primary) { continue; }
        let mut start: usize = 0;
        if selected_file != 0 { start = files[selected_file - 1].end as usize + 1; }
        let end = files[selected_file].end as usize + 1;
        written = append(&mut working[..], written, &source[start..end]);
        if written == 0 { return (4, 0, 0); }
        ordered[count] = PackageFile { end: written as u64 - 1,
            module_start: files[selected_file].module_start, module_end: files[selected_file].module_end,
            entry: files[selected_file].entry, package: files[selected_file].package,
            visible: files[selected_file].visible,
            path_start: files[selected_file].path_start, path_end: files[selected_file].path_end };
        count += 1;
    }
    diagnostic_linked(written);
    let mut at: usize = 0;
    while at < written { source[at] = working[at]; at += 1; }
    file = 0;
    while file < count {
        files[file] = PackageFile { end: ordered[file].end, module_start: ordered[file].module_start,
            module_end: ordered[file].module_end, entry: ordered[file].entry,
            package: ordered[file].package, visible: ordered[file].visible,
            path_start: ordered[file].path_start, path_end: ordered[file].path_end };
        file += 1;
    }
    (0, written as u64, count as u64)
}

fn compile_input_mode(root: &[u8], stdlib: &[u8], mode: i32, file:bool) -> i32 {
    let empty: [u8; 0] = [];
    compile_input_selection(root, stdlib, mode, file, &empty[..])
}

fn compile_input_selection(root: &[u8], stdlib: &[u8], mode: i32, file:bool, focus: &[u8]) -> i32 {
    diagnostic_begin();
    // Include the compiler sources and the documented standard library in a single package.
    let mut source: [u8; 4194304] = [0; 4194304];
    let mut names: [u8; 131072] = [0; 131072];
    let mut files = [PackageFile { end: 0, module_start: 0, module_end: 0, entry: false, package: 0, visible: 0, path_start: 0, path_end: 0 }; 256];
    let package = read_check_input(root,stdlib,&mut source[..],&mut names[..],&mut files[..],file);
    if package.error != 0 { return package.error; }
    // Allow 1536 Ki tokens for the combined compiler and standard library, plus sentinels.
    let mut tokens: [Token; 1572867] = [Token { nominal: false, annotation: 0, kind: 0, start: 0, end: 0 }; 1572867];
    let mut source_end = package.source_end;
    let mut files_end = package.files_end;
    if focus.len() != 0 {
        let (status, length, count) = focus_check_input(&mut source[..source_end], &names[..package.names_end],
            &mut files[..files_end], &mut tokens[..], focus, copy(mode));
        if status != 0 { return status; }
        source_end = length;
        files_end = count;
    }
    let (status, count) = scan_tokens(&source[..source_end], &mut tokens[..], copy(mode));
    if status != 0 { return status; }
    let selected = select_target(&source[..source_end], &mut tokens[..count + 3]);
    if selected == 0 { return 7; }
    prepare_native_exports(&source[..source_end], &names[..package.names_end],
        &files[..files_end], &mut tokens[..selected]);
    mark_nominal_names(&source[..source_end], &mut tokens[..selected]);
    let mut nodes = [AstNode {
        kind: 0, parent: 0, start: 0, end: 0, name_start: 0, name_end: 0, public: false,
    }; 524289];
    let used = parse_nodes(&tokens[..selected], &mut nodes[..]);
    if used == 0 { diagnostic_parse_error();return 7; }
    let mut graph = [StaticNode {
        first_child: 0, next_sibling: 0, scope: 0, scope_parent: 0, scope_entry: false,
        declaration: false, mutable: false, type_node: 0, initializer: 0, fact: 0,
        visible: 0, binding: 0, destination: 0, field_name: 0, private_start: 0, private_end: 0, private_origin: 0,
        access_mode: 0, protection: 0,
    }; 524289];
    build_graph(&source[..source_end], &nodes[..used], &tokens[..selected], &mut graph[..], false);
    let mut linked: [u8; 4194304] = [0; 4194304];
    let mut visibility = [LayoutVisibility { kind: 0, name: 0, start: 0, end: 0, origin: 0 }; 4096];
    diagnostic_stage(&source[..source_end]);
    let (error, length, env_call) = link_package(&source[..source_end], &names[..package.names_end],
        &files[..files_end], &tokens[..selected], &nodes[..used], &graph[..used], &mut linked[..], &mut visibility[..], mode==7);
    if error != 0 { return error; }
    diagnostic_linked(length);
    // Reuse the package token storage for the rewritten source.
    let (rewritten_status, rewritten_count) = scan_tokens(&linked[..length], &mut tokens[..], copy(mode));
    if rewritten_status != 0 { return rewritten_status; }
    let remaining = select_target(&linked[..length], &mut tokens[..rewritten_count + 3]);
    if remaining == 0 { return 7; }
    mark_nominal_names(&linked[..length], &mut tokens[..remaining]);
    parse(&linked[..length], &tokens[..remaining], mode, env_call, true, &visibility[..])
}


#(if: target.os == "macos" && target.arch == "aarch64")
fn build_usage() -> i32 {
    let message: [u8; 42] = [117,115,97,103,101,58,32,99,111,114,98,111,99,32,98,117,105,108,100,32,91,80,65,67,75,65,71,69,93,32,91,45,111,32,79,85,84,80,85,84,93,10]; // usage: corboc build [PACKAGE] [-o OUTPUT]
    diagnostic(&message[..]);
    6
}

// Default outputs live under the selected package root, independent of the caller's cwd.
fn build_default(root: &[u8]) -> i32 {
    let mut output: [u8; 4096] = [0; 4096];
    let (status, directory, end) = binary_output(&root[0..root.len()], &mut output[..]);
    if status != 0 {
        let message: [u8; 44] = [99,111,114,98,111,99,58,32,99,97,110,110,111,116,32,114,101,97,100,32,112,97,99,107,97,103,101,32,98,105,110,97,114,121,32,115,101,116,116,105,110,103,115,10];
        diagnostic(&message[..]);
        dependency_diagnostic(copy(status));
        return status;
    }
    output[directory] = 0;
    let created = ensure_directory(&output[..directory + 1]);
    output[directory] = 47;
    if !created {
        let message: [u8; 38] = [99,111,114,98,111,99,58,32,99,97,110,110,111,116,32,99,114,101,97,116,101,32,98,117,105,108,100,32,100,105,114,101,99,116,111,114,121,10];
        diagnostic(&message[..]);
        return 11;
    }
    build_package(root, &output[..end])
}

fn build_package(root: &[u8], output: &[u8]) -> i32 {
    if output.len() == 0 || output.len() >= 4096 { return build_usage(); }
    let mut stdlib: [u8; 4096] = [0; 4096];
    let std_end = stdlib_path(&mut stdlib[..]);
    if std_end == 0 {
        let message: [u8; 64] = [99, 111, 114, 98, 111, 99, 58, 32, 115, 116, 97, 110, 100, 97, 114, 100, 32, 108, 105, 98, 114, 97, 114, 121, 32, 109, 105, 115, 115, 105, 110, 103, 32, 102, 114, 111, 109, 32, 46, 46, 47, 115, 104, 97, 114, 101, 47, 99, 111, 114, 98, 111, 47, 115, 116, 100, 108, 105, 98, 47, 115, 114, 99, 10]; // corboc: standard library missing from ../share/corbo/stdlib/src
        diagnostic(&message[..]);
        return 11;
    }
    let mut workspace: [u8; 4096] = [0; 4096];
    let end = workspace_path(&output[0..output.len()], &mut workspace[..]);
    if end == 0 {
        let message: [u8; 48] = [99, 111, 114, 98, 111, 99, 58, 32, 99, 97, 110, 110, 111, 116, 32, 99, 114, 101, 97, 116, 101, 32, 116, 101, 109, 112, 111, 114, 97, 114, 121, 32, 98, 117, 105, 108, 100, 32, 100, 105, 114, 101, 99, 116, 111, 114, 121, 10]; // corboc: cannot create temporary build directory
        diagnostic(&message[..]);
        return 11;
    }
    let mut source: [u8; 4096] = [0; 4096];
    let mut binary: [u8; 4096] = [0; 4096];
    let mut destination: [u8; 4096] = [0; 4096];
    let c_suffix: [u8; 10] = [47, 112, 114, 111, 103, 114, 97, 109, 46, 99]; // /program.c
    let exe_suffix: [u8; 8] = [47, 112, 114, 111, 103, 114, 97, 109]; // /program
    let cb = append(&mut source[..], 0, &workspace[..end]);
    let ce = append(&mut source[..], cb, &c_suffix[..]);
    let eb = append(&mut binary[..], 0, &workspace[..end]);
    let ee = append(&mut binary[..], eb, &exe_suffix[..]);
    let destination_end = append(&mut destination[..], 0, output);
    let status = build_in_workspace(root, &stdlib[..std_end], &source[..ce + 1],
        &binary[..ee + 1], &destination[..destination_end + 1]);
    clean(&workspace[..end + 1], &source[..ce + 1], &binary[..ee + 1]);
    status
}

fn dependency_diagnostic(status: i32) {
    if status == 12 {
        let message: [u8; 54] = [99,111,114,98,111,99,58,32,105,110,118,97,108,105,100,32,112,97,99,107,97,103,101,32,109,97,110,105,102,101,115,116,32,111,114,32,100,101,112,101,110,100,101,110,99,121,32,102,105,101,108,100,115,10]; // invalid package manifest or dependency fields
        diagnostic(&message[..]);
    }
    if status == 13 {
        let message: [u8; 54] = [99,111,114,98,111,99,58,32,105,109,112,111,114,116,32,117,110,97,118,97,105,108,97,98,108,101,32,111,114,32,100,101,112,101,110,100,101,110,99,121,32,110,111,116,32,100,101,99,108,97,114,101,100,10]; // import unavailable or dependency not declared
        diagnostic(&message[..]);
    }
    if status == 16 {
        let message: [u8; 25] = [99,111,114,98,111,99,58,32,100,101,112,101,110,100,101,110,99,121,32,99,121,99,108,101,10]; // dependency cycle
        diagnostic(&message[..]);
    }
    if status == 17 {
        let message: [u8; 43] = [99,111,114,98,111,99,58,32,100,101,112,101,110,100,101,110,99,121,32,110,97,109,101,32,111,114,32,115,111,117,114,99,101,32,99,111,110,102,108,105,99,116,10]; // dependency name or source conflict
        diagnostic(&message[..]);
    }
    if status == 18 {
        let message: [u8; 41] = [99,111,114,98,111,99,58,32,114,101,118,32,109,117,115,116,32,98,101,32,97,32,102,117,108,108,32,71,105,116,32,99,111,109,109,105,116,32,73,68,10]; // rev must be a full Git commit ID
        diagnostic(&message[..]);
    }
    if status == 19 {
        let message: [u8; 37] = [99,111,114,98,111,99,58,32,71,105,116,32,102,101,116,99,104,32,111,114,32,99,104,101,99,107,111,117,116,32,102,97,105,108,101,100,10]; // Git fetch or checkout failed
        diagnostic(&message[..]);
    }
    if status == 20 {
        let message: [u8; 56] = [99,111,114,98,111,99,58,32,112,97,116,104,32,100,101,112,101,110,100,101,110,99,121,32,101,115,99,97,112,101,115,32,105,116,115,32,112,105,110,110,101,100,32,71,105,116,32,99,104,101,99,107,111,117,116,10]; // path dependency escapes its pinned Git checkout
        diagnostic(&message[..]);
    }
}

fn build_in_workspace(root: &[u8], stdlib: &[u8], source: &[u8], binary: &[u8], output: &[u8]) -> i32 {
    let saved = redirect_stdout(&source[0..source.len()]);
    if saved < 0 {
        let message: [u8; 39] = [99, 111, 114, 98, 111, 99, 58, 32, 99, 97, 110, 110, 111, 116, 32, 111, 112, 101, 110, 32, 116, 101, 109, 112, 111, 114, 97, 114, 121, 32, 67, 32, 111, 117, 116, 112, 117, 116, 10]; // corboc: cannot open temporary C output
        diagnostic(&message[..]);
        return 11;
    }
    let status = compile_package(&root[0..root.len()], stdlib);
    diagnostic_finish(&root[0..root.len()],status);
    if !restore_stdout(saved) {
        let message: [u8; 40] = [99, 111, 114, 98, 111, 99, 58, 32, 99, 97, 110, 110, 111, 116, 32, 102, 108, 117, 115, 104, 32, 116, 101, 109, 112, 111, 114, 97, 114, 121, 32, 67, 32, 111, 117, 116, 112, 117, 116, 10]; // corboc: cannot flush temporary C output
        diagnostic(&message[..]);
        return 11;
    }
    if status != 0 {
        let message: [u8; 35] = [99, 111, 114, 98, 111, 99, 58, 32, 112, 97, 99, 107, 97, 103, 101, 32, 99, 111, 109, 112, 105, 108, 97, 116, 105, 111, 110, 32, 102, 97, 105, 108, 101, 100, 10]; // corboc: package compilation failed
        diagnostic(&message[..]);
        dependency_diagnostic(copy(status));
        if status == 8 {
            let mut details: [u8; 128] = [0; 128];
            let (read_status, count) = read_source(&source[0..source.len()], &mut details[..]);
            if read_status == 0 && count > 0 { diagnostic(&details[..count]); }
        }
        return status;
    }
    let compiled = toolchain(&source[0..source.len()], &binary[0..binary.len()]);
    if compiled != 0 {
        let message: [u8; 31] = [99, 111, 114, 98, 111, 99, 58, 32, 67, 32, 99, 111, 109, 112, 105, 108, 101, 114, 32, 102, 97, 105, 108, 101, 100, 32, 40, 99, 99, 41, 10]; // corboc: C compiler failed (cc)
        diagnostic(&message[..]);
        return compiled;
    }
    if !publish(&binary[0..binary.len()], output) {
        let message: [u8; 34] = [99, 111, 114, 98, 111, 99, 58, 32, 99, 97, 110, 110, 111, 116, 32, 112, 117, 98, 108, 105, 115, 104, 32, 101, 120, 101, 99, 117, 116, 97, 98, 108, 101, 10]; // corboc: cannot publish executable
        diagnostic(&message[..]);
        return 11;
    }
    0
}
#(endif)

#(if: target.os == "linux" || target.os == "windows" || target.arch == "x86_64")
fn build_usage() -> i32 { 6 }
fn build_default(root: &[u8]) -> i32 { drop(root); 6 }
fn build_package(root: &[u8], output: &[u8]) -> i32 {
    drop(root);
    drop(output);
    6
}
#(endif)
