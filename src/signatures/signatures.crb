fn readonly_argument_use(nodes: &[AstNode], graph: &[StaticNode], point: u64, argument: u64, record: bool) -> bool {
    let mut parent = nodes[point].parent;
    if parent == 0 || graph[parent].first_child != point { return false; }
    let kind = nodes[parent].kind;
    if record && kind != 18 {
        if kind != 14 { return false; }
        let mut projected = nodes[parent].parent;
        while nodes[projected].kind == 19 { projected = nodes[projected].parent; }
        if nodes[projected].kind != 17 { return false; }
    } else if !record && kind != 18 && kind != 16 { return false; }
    while parent != 0 {
        let kind = nodes[parent].kind;
        if kind == 15 || kind == 21 || kind == 55 || kind == 56
            || (kind == 13 && graph[parent].mutable) { return false; }
        if parent == argument { return true; }
        parent = nodes[parent].parent;
    }
    false
}

pub fn argument_conflicts(nodes: &[AstNode], graph: &[StaticNode], values: &[CheckedValue],
    previous: u64, input: u64) -> bool {
    if values[previous].ty==300 || values[previous].ty==475 {
        let mut at=copy(input);
        while at<nodes.len() as u64 && nodes[at].start<nodes[input].end {
            let binding=graph[at].binding;
            if binding!=0 && reserves(&values[0..values.len()],&graph[0..graph.len()],copy(previous),binding){return true;}
            at=at+1;
        }
        return false;
    }
    let root = values[previous].target;
    let parent = values[previous].loan_parent;
    let loan = values[previous].ty;
    let record = loan == 734;
    let mut point = copy(input);
    while point < nodes.len() as u64 && nodes[point].start < nodes[input].end {
        if (root != 0 && graph[point].binding == root) || (parent != 0 && graph[point].binding == parent) {
            if (!record && (loan < 741 || loan > 749)) || values[previous].writable
                || !readonly_argument_use(&nodes[0..nodes.len()], &graph[0..graph.len()],
                    copy(point), copy(input), copy(record)) { return true; }
        }
        point = point + 1;
    }
    false
}

pub fn move_slice_argument(nodes: &[AstNode], graph: &[StaticNode], values: &mut [CheckedValue],
    input: u64, expected: i64) -> i64 {
    let binding = graph[input].binding;
    if values[binding].state != 1 { return 0 - violation(6, nodes[input].start); }
    if values[binding].ty != expected { return 0 - violation(1, nodes[input].start); }
    if !live_roots(&values[0..values.len()], &graph[0..graph.len()], copy(binding)) {
        return 0 - violation(4, nodes[input].start);
    }
    let exclusive = values[binding].writable;
    let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
        &graph[0..graph.len()], copy(binding), copy(input), copy(exclusive));
    if conflict < 0 { return -9; }
    if conflict > 0 { return 0 - violation(5, nodes[input].start); }
    let target = values[binding].target;
    let parent = values[binding].loan_parent;
    let shape = values[binding].origin_call;
    let mutable = values[binding].mutable;
    values[input] = CheckedValue { ty: copy(expected), state: 1, mutable: false,
        target: copy(target), loan_parent: copy(parent), origin_call: copy(shape), writable: copy(exclusive) };
    values[binding] = CheckedValue { ty: expected, state: 2, mutable: mutable,
        target: target, loan_parent: parent, origin_call: shape, writable: exclusive };
    1
}

pub fn check_slice_argument(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], input: u64, slice: i64, element: u64, exclusive: bool) -> i64 {
    let checked = if nodes[input].kind == 7 {
        move_slice_argument(&nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(input), copy(slice))
    } else if nodes[input].kind == 13 {
        bind_slice(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], &mut values[0..values.len()], copy(input), copy(input), 0)
    } else { return -9; };
    if checked < 0 { return checked; }
    if checked == 0 { return -9; }
    if values[input].ty != slice || values[input].writable != exclusive {
        return 0 - violation(1, nodes[input].start);
    }
    if slice == 749 {
        let actual_shape = inline_array_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], values[input].origin_call);
        let expected_shape = inline_array_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(element));
        if actual_shape != expected_shape { return 0 - violation(1, nodes[input].start); }
    } else if element != 0 {
        let current = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], values[input].origin_call);
        let expected = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], element);
        if current == 0 || current != expected { return 0 - violation(1, nodes[input].start); }
    }
    1
}

// Resolve a field summary through borrowed record layers and constructor
// argument mappings. A unique concrete origin is required.
pub fn shared_result_member(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &[CheckedValue], owner: u64, field: u64, depth: u64) -> u64 {
    if owner == 0 || depth >= 128 { return 0; }
    if values[owner].ty == 734 {
        return shared_result_member(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &values[0..values.len()], values[owner].target, field, depth + 1);
    }
    if values[owner].ty != 300 && values[owner].ty != 301 { return 0; }
    let constructor = values[owner].origin_call;
    if nodes[constructor].kind != 37 { return 0; }
    let parent = values[owner].loan_parent;
    let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(constructor));
    let mut member = graph[constructor].first_child;
    let mut found: u64 = 0;
    while member != 0 {
        let actual = if constructor_arguments(values[parent].ty) {
            constructor_field_value(&graph[0..graph.len()], &values[0..values.len()], copy(parent), copy(member))
        } else if parent != 0 { copy(parent) } else { copy(member) };
        if nominal == nodes[field].parent && graph[member].field_name == graph[field].field_name { return actual; }
        if values[actual].ty == 734 || values[actual].ty == 300 || values[actual].ty == 301 {
            let nested = shared_result_member(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &values[0..values.len()], actual, copy(field), depth + 1);
            if nested != 0 {
                if found != 0 && found != nested { return 0; }
                found = nested;
            }
        }
        member = graph[member].next_sibling;
    }
    found
}

pub fn check_signature(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], function: u64, argument: u64,
    expected: i64, mode: i64, call: u64) -> i64 {
    let start = nodes[call].start;
    let deferred = nodes[function].kind == 35;
    if !deferred && mode == 0 && expected == 0 {
        let effect = direct_entry_effect(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            &mut values[0..values.len()], copy(function), copy(argument));
        if effect < 0 { return effect; }
        if effect != 0 { return 0; }
    }
    let mut parameter = graph[function].first_child;
    let mut input = copy(argument);
    let mut reserved: [u64; 64] = [0; 64];
    let mut reservations: u64 = 0;
    let text_extension=nodes[call].kind==16 && nodes[nodes[function].parent].kind!=49 && split_callee(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],copy(call))==function;
    if text_extension{input=graph[call].first_child;}
    if nodes[call].kind == 16 && !text_extension {
        let receiver = graph[call].first_child;
        if value_receiver(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(function)) {
            input = receiver;
        } else {
            let checked = reserve_method_receiver(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(receiver), copy(parameter));
            if checked < 0 { return checked; }
            reserved[0] = receiver;
            reservations = 1;
            parameter = graph[parameter].next_sibling;
        }
    }
    let mut waited: u64 = 0;
    let mut completion: u64 = 0;
    while parameter != 0 && nodes[parameter].kind == 3 {
        if input == 0 { return 0 - violation(8, start); }
        let ty_node = graph[parameter].first_child;
        let ty = verify_primitive(&source[0..source.len()], nodes[ty_node].name_start, nodes[ty_node].name_end);
        let allocation = region_signature(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node), false);
        let handle = scalar_handle_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node));
        let map = map_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node));
        if map < 0 { return map; }
        let (array, length) = scalar_array_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node));
        if array < 0 { return array; }
        let (array_view, count) = array_ref_type(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node));
        if array_view < 0 { return array_view; }
        let mut actual: i64 = 0;
        let mut index: u64 = 0;
        while index < reservations {
            let previous = reserved[index];
            if graph[previous].access_mode == 1 && graph[input].access_mode == 1
                && reference_preparation(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(input), 0) {
                index += 1;
                continue;
            }
            // Reuse the same field-disjointness proof as the reservation check below.
            if disjoint_fields(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(previous), copy(input)) {
                index += 1;
                continue;
            }
            if values[previous].ty==300 || values[previous].ty==475 {
                if argument_conflicts(&nodes[0..nodes.len()],&graph[0..graph.len()],&values[0..values.len()],copy(previous),copy(input)){return 0-violation(5,nodes[input].start);}
                index=index+1;continue;
            }
            let root = values[previous].target;
            let parent = values[previous].loan_parent;
            let mut point = copy(input);
            while point < nodes.len() as u64 && nodes[point].start < nodes[input].end {
                if ((root != 0 && graph[point].binding == root) || (parent != 0 && graph[point].binding == parent))
                    && !(!values[previous].writable && readonly_scalar(&source[0..source.len()],
                        &nodes[0..nodes.len()], &graph[0..graph.len()], copy(input), 0)) {
                    let loan = values[previous].ty;
                    let record = loan == 734;
                    if (!record && (loan < 741 || loan > 749)) || values[previous].writable
                        || !readonly_argument_use(&nodes[0..nodes.len()], &graph[0..graph.len()],
                            copy(point), copy(input), record) { return -9; }
                }
                point = point + 1;
            }
            index = index + 1;
        }
        let (slice, element, exclusive) = slice_parameter(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node));
        if slice != 0 {
            // A named slice argument moves its descriptor. A temporary
            // reborrow stays reserved while subsequent arguments evaluate.
            if reservations == 64 { return -9; }
            let checked = check_slice_argument(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(input), copy(slice), element, copy(exclusive));
            if checked < 0 { return checked; }
            index = 0;
            while index < reservations {
                let previous = reserved[index];
            if graph[previous].access_mode == 1 && graph[input].access_mode == 1
                && reference_preparation(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(input), 0) {
                index += 1;
                continue;
            }
                if values[previous].target == values[input].target
                    && !disjoint_fields(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(previous), copy(input))
                    && (exclusive || values[previous].writable)
                    && !(graph[previous].access_mode == 1 && graph[input].access_mode == 1) { return -9; }
                index = index + 1;
            }
            actual = slice;
            reserved[reservations] = copy(input);
            reservations = reservations + 1;
        }
        if actual == 0 && !deferred && reservations == 0 {
            let pool_type = region_signature(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(ty_node), true);
            if pool_type == 99 || (pool_type >= 101 && pool_type <= 107) {
                let place = graph[input].first_child;
                let pool = graph[place].binding;
                if nodes[input].kind != 13 || nodes[place].kind != 7 || !graph[input].mutable
                    || values[pool].ty != pool_type || !values[pool].mutable || values[pool].state != 1 {
                    return 0 - violation(4, nodes[input].start);
                }
                if pool_type == 99 {
                    let pool_definition = graph[pool].initializer;
                    let payload = graph[graph[pool_definition].first_child].first_child;
                    let expected = graph[graph[ty_node].first_child].first_child;
                    if nodes[pool_definition].kind != 66 || nominal_declaration(&source[0..source.len()],
                        &nodes[0..nodes.len()], &graph[0..graph.len()], payload)
                        != nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                            &graph[0..graph.len()], expected) { return 0 - violation(1, nodes[input].start); }
                }
                let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
                    &graph[0..graph.len()], copy(pool), copy(input), true);
                if conflict != 0 { return if conflict > 0 { 0 - violation(5, nodes[input].start) } else { -9 }; }
                values[input] = CheckedValue { ty: copy(pool_type), state: 1, mutable: false, target: pool,
                    loan_parent: 0, origin_call: 0, writable: true };
                reserved[reservations] = copy(input);
                reservations = reservations + 1;
                actual = pool_type;
            }
        }
        if actual == 0 && shared_text_annotation(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(ty_node)) {
            if nodes[input].kind == 9 && source[nodes[input].start] != 34 { return 0 - violation(1, nodes[input].start); }
            let known = scalar_known_type(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &values[0..values.len()], copy(input));
            if known >= 1 && known <= 9 { return 0 - violation(1, nodes[input].start); }
            actual = if text_extension && input==graph[call].first_child { values[input].ty }else{verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &mut values[0..values.len()],
                copy(input), argument_text_type(), 1)};
            if actual < 0 { return actual; }
            if actual != argument_text_type() { return 0 - violation(1, nodes[input].start); }
            if reservations==64{return -9;}reserved[reservations]=copy(input);reservations=reservations+1;
        }
        if actual == 0 {
            let record = record_parameter(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(ty_node), !deferred && nodes[input].kind != 13 && !record_borrow(copy(expected)));
            if record != 0 {
                if reservations == 64 { return -9; }
                let exclusive = borrow_mutable(&source[nodes[ty_node].start..nodes[record].start]);
                actual = check_record_argument(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(input), record, copy(exclusive), copy(deferred));
                if actual < 0 { return actual; }
                index = 0;
                while index < reservations {
                    let previous = reserved[index];
            if graph[previous].access_mode == 1 && graph[input].access_mode == 1
                && reference_preparation(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(input), 0) {
                index += 1;
                continue;
            }
                    if values[previous].target == values[input].target
                        && !disjoint_fields(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(previous), copy(input))
                        && (exclusive || values[previous].writable)
                    && !(graph[previous].access_mode == 1 && graph[input].access_mode == 1) { return -9; }
                    index = index + 1;
                }
                reserved[reservations] = copy(input);
                reservations = reservations + 1;
            }
        }
        if map > 0 {
            if dependent_map(copy(map)) { return -9; }
            if nodes[input].kind != 7 || values[graph[input].binding].ty != map {
                return 0 - violation(1, nodes[input].start);
            }
            let status = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], &mut values[0..values.len()], copy(input), 0, 3);
            if status < 0 { return status; }
            actual = map;
        }
        if array > 0 {
            if nodes[input].kind != 7 { return -9; }
            let from = graph[input].binding;
            if values[from].ty != array || values[from].origin_call != length {
                return 0 - violation(1, nodes[input].start);
            }
            let checked = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(input), 0, 3);
            if checked < 0 { return checked; }
            actual = copy(array);
        }
        if actual == 0 && graph[ty_node].first_child != 0
            && nodes[ty_node].name_end == nodes[ty_node].name_start + 1 && source[nodes[ty_node].name_start] == 65 {
            let vector = vector_scalar_owner(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], graph[ty_node].first_child);
            if vector != 0 {
                let binding = graph[input].binding;
                if nodes[input].kind != 7 || values[binding].ty != vector + 100 { return -9; }
                let checked = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(input), 0, 3);
                if checked < 0 { return checked; }
                actual = vector + 100;
            }
        }
        if actual == 0 {
            let nominal = autonomous_enum(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(ty_node));
            if nominal != 0 {
                actual = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut values[0..values.len()], copy(input), 310, 1);
                if actual < 0 { return actual; }
                let shape = values[input].origin_call;
                let name = if nodes[shape].kind == 4 || nodes[shape].kind == 29 { shape } else { graph[shape].first_child };
                if actual != 310 || nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], name) != nominal { return 0 - violation(1, nodes[input].start); }
                if dependent_handle(&graph[0..graph.len()], &values[0..values.len()], copy(input))
                    || values[input].target != 0 { return -9; }
            }
        }
        if actual == 0 {
            let result = result_annotation(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(ty_node));
            let wrapped = if result == 0 {
                scalar_option_annotation(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], copy(ty_node))
            } else { result };
            if wrapped != 0 {
                if option_borrow(copy(wrapped)) != 0 || option_allocation(copy(wrapped)) != 0 || option_handle(copy(wrapped)) != 0 { return -9; }
                actual = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(input), copy(wrapped), 1);
                if actual >= 0 && actual != wrapped { return 0 - violation(1, nodes[input].start); }
            }
        }
        if actual == 0 && tuple_annotation(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(ty_node)) {
            actual = tuple_value(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                &mut values[0..values.len()], copy(input), copy(ty_node));
        }
        if actual == 0 && graph[ty_node].first_child == 0 {
            let nominal = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(ty_node));
            if value_record(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(nominal), 0, true)
                || borrowed_record_type(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],copy(nominal),0) {
                if nodes[input].kind == 7 && values[graph[input].binding].ty == 734 {
                    return 0 - violation(1, nodes[input].start);
                }
                let status = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], &mut values[0..values.len()], copy(input), 300, 1);
                if status < 0 { return status; }
                let record = nominal_declaration(&source[0..source.len()], &nodes[0..nodes.len()],
                    &graph[0..graph.len()], values[input].origin_call);
                if status != 300 || record != nominal || values[input].target != 0 {
                    return 0 - violation(1, nodes[input].start);
                }
                if reservations==64{return -9;}reserved[reservations]=copy(input);reservations=reservations+1;
                actual = 300;
            }
        }
        if actual == 0 {
            let nested = nested_loan_type(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(ty_node));
            actual = if array_view > 0 {
                if deferred || reservations == 64 { return -9; }
                if nodes[input].kind != 13 { return -9; }
                let place = graph[input].first_child;
