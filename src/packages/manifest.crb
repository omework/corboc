struct Manifest {
    name_start: u64,
    name_end: u64,
    dependencies_start: u64,
    dependencies_end: u64,
    valid: bool,
}

struct Dependency {
    name_start: u64,
    name_end: u64,
    source_start: u64,
    source_end: u64,
    revision_start: u64,
    revision_end: u64,
    valid: bool,
}

fn whitespace(byte: u8) -> bool { byte == 32 || byte == 9 || byte == 13 }

fn horizontal(source: &[u8], start: u64, end: u64) -> u64 {
    let mut at = start;
    while at < end && whitespace(source[at]) { at = at + 1; }
    at
}

fn line_end(source: &[u8], start: u64) -> u64 {
    let mut at = start;
    while at < source.len() as u64 && source[at] != 10 { at = at + 1; }
    at
}

fn identifier(source: &[u8], start: u64, end: u64) -> u64 {
    if start == end || (source[start] >= 48 && source[start] <= 57) { return start; }
    let mut at = start;
    while at < end && name_byte(source[at]) { at = at + 1; }
    at
}

// The bootstrap accepts bare keys and single-line strings in inline tables.
// Span endpoints exclude the quote and preserve byte offsets in the manifest.
fn quoted_end(source: &[u8], start: u64, end: u64) -> u64 {
    if start == end || (source[start] != 34 && source[start] != 39) { return 0; }
    let quote = source[start];
    let mut at = start + 1;
    while at < end && source[at] != quote {
        if source[at] < 32 || (quote == 34 && source[at] == 92) { return 0; }
        at = at + 1;
    }
    if at == end || at == start + 1 { return 0; }
    at
}

fn line_tail(source: &[u8], start: u64, end: u64) -> bool {
    let at = horizontal(&source[0..source.len()], start, copy(end));
    at == end || source[at] == 35
}

fn read_manifest(source: &[u8]) -> Manifest {
    let invalid = Manifest { name_start: 0, name_end: 0, dependencies_start: 0, dependencies_end: 0, valid: false };
    let mut name_start: u64 = 0;
    let mut name_end: u64 = 0;
    let mut dependencies_start: u64 = 0;
    let mut dependencies_end: u64 = 0;
    let mut section: u64 = 0;
    let mut package = false;
    let mut dependencies = false;
    let mut line: u64 = 0;
    let heading: [u8; 9] = [91,112,97,99,107,97,103,101,93]; // [package]
    let table: [u8; 14] = [91,100,101,112,101,110,100,101,110,99,105,101,115,93]; // [dependencies]
    let name: [u8; 4] = [110,97,109,101]; // name
    while line < source.len() as u64 {
        let end = line_end(&source[0..source.len()], copy(line));
        let at = horizontal(&source[0..source.len()], copy(line), copy(end));
        if at < end && source[at] != 35 {
            if source[at] == 91 {
                if section == 2 { dependencies_end = copy(line); }
                if end - at >= 9 && same_text(&source[at..at + 9], &heading[..])
                    && line_tail(&source[0..source.len()], at + 9, copy(end)) {
                    if package { return invalid; }
                    section = 1;
                    package = true;
                } else if end - at >= 14 && same_text(&source[at..at + 14], &table[..])
                    && line_tail(&source[0..source.len()], at + 14, copy(end)) {
                    if dependencies { return invalid; }
                    section = 2;
                    dependencies = true;
                    dependencies_start = end + 1;
                    dependencies_end = source.len() as u64;
                } else { return invalid; }
            } else if section == 1 {
                if name_end != 0 || end - at < 4 || !same_text(&source[at..at + 4], &name[..]) { return invalid; }
                let equal = horizontal(&source[0..source.len()], at + 4, copy(end));
                if equal == end || source[equal] != 61 { return invalid; }
                let quote = horizontal(&source[0..source.len()], equal + 1, copy(end));
                let last = quoted_end(&source[0..source.len()], copy(quote), copy(end));
                if last == 0 || identifier(&source[0..source.len()], quote + 1, copy(last)) != last
                    || !line_tail(&source[0..source.len()], last + 1, copy(end)) { return invalid; }
                name_start = quote + 1;
                name_end = last;
            } else if section != 2 { return invalid; }
        }
        line = end + 1;
    }
    let valid = name_end != 0;
    Manifest { name_start: name_start, name_end: name_end, dependencies_start: dependencies_start,
        dependencies_end: dependencies_end, valid: valid }
}

fn read_dependency(source: &[u8], start: u64, end: u64) -> Dependency {
    let invalid = Dependency { name_start: 0, name_end: 0, source_start: 0, source_end: 0,
        revision_start: 0, revision_end: 0, valid: false };
    let last = identifier(&source[0..source.len()], copy(start), copy(end));
    if last == start { return invalid; }
    let equal = horizontal(&source[0..source.len()], copy(last), copy(end));
    if equal == end || source[equal] != 61 { return invalid; }
    let open = horizontal(&source[0..source.len()], equal + 1, copy(end));
    if open == end || source[open] != 123 { return invalid; }
    let mut at = horizontal(&source[0..source.len()], open + 1, copy(end));
    let mut source_start: u64 = 0;
    let mut source_end: u64 = 0;
    let mut revision_start: u64 = 0;
    let mut revision_end: u64 = 0;
    let mut path = false;
    let mut git = false;
    let mut revision = false;
    let path_key: [u8; 4] = [112,97,116,104];
    let git_key: [u8; 3] = [103,105,116];
    let rev_key: [u8; 3] = [114,101,118];
    loop {
        let key_end = identifier(&source[0..source.len()], copy(at), copy(end));
        if key_end == at { return invalid; }
        let key = &source[at..key_end];
        let equal = horizontal(&source[0..source.len()], key_end, copy(end));
        if equal == end || source[equal] != 61 { return invalid; }
        let quote = horizontal(&source[0..source.len()], equal + 1, copy(end));
        let value_end = quoted_end(&source[0..source.len()], copy(quote), copy(end));
        if value_end == 0 { return invalid; }
        if key.content_eq(&path_key[..]) && !path && !git {
            path = true;
            source_start = quote + 1;
            source_end = copy(value_end);
        } else if key.content_eq(&git_key[..]) && !git && !path {
            git = true;
            source_start = quote + 1;
            source_end = copy(value_end);
        } else if key.content_eq(&rev_key[..]) && !revision {
            revision = true;
            revision_start = quote + 1;
            revision_end = copy(value_end);
        } else { return invalid; }
        let next = horizontal(&source[0..source.len()], value_end + 1, copy(end));
        if next == end { return invalid; }
        if source[next] == 125 {
            let valid = ((path && !revision) || (git && revision))
                && line_tail(&source[0..source.len()], next + 1, end);
            return Dependency { name_start: start, name_end: last, source_start: source_start,
                source_end: source_end, revision_start: revision_start, revision_end: revision_end, valid: valid };
        }
        if source[next] != 44 { return invalid; }
        at = horizontal(&source[0..source.len()], next + 1, copy(end));
    }
    invalid
}
