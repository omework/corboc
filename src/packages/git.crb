fn discard_checkout(directory: &[u8]) {
    let shell: [u8; 8] = [47, 98, 105, 110, 47, 115, 104, 0];
    let flag: [u8; 3] = [45, 99, 0];
    let script: [u8; 25] = [
        101, 120, 101, 99, 32, 47, 98, 105, 110, 47, 114, 109, 32, 45, 114, 102,
        32, 45, 45, 32, 34, 36, 49, 34, 0,
    ];
    let arg0: [u8; 11] = [99, 111, 114, 98, 111, 99, 45, 103, 105, 116, 0];
    let empty: [u8; 1] = [0];
    let status = run_command(&shell[..], &flag[..], &script[..], &arg0[..], directory, &empty[..], &empty[..]);
    drop(status);
}
#(endif)

#(if: target.os == "linux" || target.os == "windows" || target.arch == "x86_64")
fn checkout_path(output: &mut [u8]) usize { drop(output); 0 }
fn git_checkout(directory: &[u8], url: &[u8], rev: &[u8]) bool {
    drop(directory);
    drop(url);
    drop(rev);
    false
}
fn discard_checkout(directory: &[u8]) { drop(directory); }
#(endif)
