#(if: target.os == "macos" && target.arch == "aarch64")
use bootstrap::build_driver::{make_workspace, run_command};

fn checkout_path(output: &mut [u8]) usize {
    let template: [u8; 23] = [
        47, 116, 109, 112, 47, 99, 111, 114, 98, 111, 99, 45, 103, 105, 116, 46,
        88, 88, 88, 88, 88, 88, 0,
    ];
    let end = append(&mut output[0..output.len()], 0, &template[..]);
    if !make_workspace(&mut output[0..end]) { return 0; }
    end - 1
}

