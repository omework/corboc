use bootstrap::package_io::open_file;
// SPDX-License-Identifier: MIT OR Apache-2.0
//! Content snapshots for project watching; watch local dependency inputs without fetching Git checkouts.
use bootstrap::package_io::read_source;
use std::io::{File, FileMode};
use std::crypto::sha256::Sha256;

/// Identifies a content transition independently of directory enumeration order.
pub fn watch_changed(left: &[u8], right: &[u8]) bool {
    !left.content_eq(right)
}

/// Selects compiler input names; generated artifacts and editor temporaries are ignored.
fn watched_file(name: &[u8]) bool {
    let manifest: [u8; 12] = [112,97,99,107,97,103,101,46,116,111,109,108];
    let lock: [u8; 10] = [99,111,114,98,111,46,108,111,99,107];
    let extension: [u8; 4] = [46,99,114,98];
    if name.content_eq(&manifest[..]) || name.content_eq(&lock[..]) { return true; }
    if name.len() <= 4 { return false; }
    let suffix = &name[name.len() - 4..name.len()];
    suffix.content_eq(&extension[..])
}

/// Hashes a path and full contents. Streaming reads keep the working buffer bounded.
fn watched_digest(path: &[u8], digest: &mut [u8]) i32 {
    let mut file = match open_file(&path[0..path.len()], FileMode::read_only()) {
        Ok(file) => { file }, Err(error) => { drop(error); return 11; },
    };
    let mut hash = Sha256::new();
    match hash.update(&path[0..path.len()]) { Ok(()) => {}, Err(error) => { drop(error); return 4; }, };
    let mut bytes: [u8; 4096] = [0; 4096];
    loop {
        let count = match file.read(&mut bytes[..]) {
            Ok(count) => { count }, Err(error) => { drop(error); return 11; },
        };
        if count == 0 { break; }
        match hash.update(&bytes[..count]) { Ok(()) => {}, Err(error) => { drop(error); return 4; }, };
    }
    let result = hash.finish();
    let mut at: usize = 0;
    while at < 32 { digest[at] ^= result[at]; at += 1; }
    0
}

/// Walks real directories only, avoiding symlink cycles and ignored output trees.
fn snapshot_directory(path: &[u8], depth: usize, digest: &mut [u8]) i32 {
    if depth > 64 { return 4; }
    let mut cache: [u32; 150] = [0; 150];
    let directory = open_package_directory(&path[0..path.len()], &mut cache);
    if directory == 0 { return 11; }
    let mut error: i32 = 0;
    let mut entry: [u8; 256] = [0; 256];
    while error == 0 {
        let kind = read_package_directory(copy(directory), &mut cache, &mut entry[..]);
        if kind == 0 { break; }
        if kind < 0 { error = 11; break; }
        let length = entry_length(&entry[..]);
        if length == 0 || entry[0] == 46 { continue; }
        let name = &entry[..length];
        if kind == 4 {
            let build: [u8; 5] = [98,117,105,108,100];
            let target: [u8; 6] = [116,97,114,103,101,116];
            let modules: [u8; 12] = [110,111,100,101,95,109,111,100,117,108,101,115];
            if (depth == 0 && (name.content_eq(&build[..]) || name.content_eq(&target[..])))
                || name.content_eq(&modules[..]) { continue; }
        } else if kind != 8 || !watched_file(&name[0..name.len()]) { continue; }
        let mut next: [u8; 4096] = [0; 4096];
        if path.len() + length >= 4096 { error = 4; break; }
        let end = append(&mut next[..], 0, &path[0..path.len() - 1]);
        next[end] = 47;
        let full = append(&mut next[..], end + 1, &name[0..name.len()]);
        error = if kind == 4 { snapshot_directory(&next[..full + 1], depth + 1, &mut digest[0..digest.len()]) }
            else { watched_digest(&next[..full + 1], &mut digest[0..digest.len()]) };
    }
    close_package_directory(directory);
    error
}

/// Captures project inputs into caller-owned digest storage; returns scan errors explicitly.
pub fn watch_snapshot(root: &[u8], digest: &mut [u8]) i32 {
    if root.len() == 0 || root.len() >= 4096 || digest.len() != 32 { return 4; }
    let mut at: usize = 0;
    while at < 32 { digest[at] = 0; at += 1; }
    let mut path: [u8; 4096] = [0; 4096];
    let end = append(&mut path[..], 0, root);
    snapshot_directory(&path[..end + 1], 0, &mut digest[0..digest.len()])
}

/// Salt each tree aggregate with its root identity so overlapping dependency
/// trees cannot cancel identical file digests in the order-independent reduction.
fn merge_snapshot(identity: &[u8], tree: &[u8], digest: &mut [u8]) i32 {
    let mut hash = Sha256::new();
    match hash.update(identity) {
        Ok(()) => {},
        Err(error) => {
            drop(error);
            return 4;
        },
    };
    match hash.update(tree) {
        Ok(()) => {},
        Err(error) => {
            drop(error);
            return 4;
        },
    };
    let value = hash.finish();
    let mut at: usize = 0;
    while at < 32 {
        digest[at] ^= value[at];
        at += 1;
    }
    0
}

/// Hash local dependency trees once per canonical identity. Pinned Git contents
/// are immutable inputs; their manifest source/revision changes are already hashed.
fn dependency_snapshot(
    root: &[u8],
    visited: &mut [u8],
    digest: &mut [u8]
) i32 {
    let mut slot: usize = 0;
    while slot < 64 {
        let base = slot * 4096;
        let length = entry_length(&visited[base..base + 4096]);
        if length == 0 { break; }
        if root.content_eq(&visited[base..base + length]) {
            return 0;
        }
        slot += 1;
    }
    if slot == 64 {
        return 4;
    }
    let base = slot * 4096;
    let stored = append(&mut visited[base..base + 4096], 0, &root[0..root.len()]);
    if stored == 0 {
        return 4;
    }
    let mut tree: [u8; 32] = [0; 32];
    let result = watch_snapshot(&root[0..root.len()], &mut tree[..]);
    let merged = merge_snapshot(
        &root[0..root.len()],
        &tree[..],
        &mut digest[0..digest.len()]
    );
    if result != 0 {
        return result;
    }
    if merged != 0 {
        return merged;
    }
    let mut path: [u8; 4096] = [0; 4096];
    let manifest_name: [u8; 12] = [112, 97, 99, 107, 97, 103, 101, 46, 116, 111, 109, 108];
    let prefix = append(&mut path[..], 0, &root[0..root.len()]);
    if prefix == 0 || prefix + 13 >= 4096 {
        return 4;
    }
    path[prefix] = 47;
    let end = append(&mut path[..], prefix + 1, &manifest_name[..]);
    let mut bytes: [u8; 65536] = [0; 65536];
    let (status, filled) = read_source(&path[..end + 1], &mut bytes[..]);
    // Missing/malformed manifests are diagnosed by check. Watching their tree
    // remains useful: writing a corrected manifest must trigger recovery.
    if status != 0 {
        return 0;
    }
    let parsed = read_manifest(&bytes[..filled]);
    if !parsed.valid {
        return 0;
    }
    let mut line = parsed.dependencies_start;
    while line < parsed.dependencies_end {
        let last = line_end(&bytes[..filled], line);
        let first = horizontal(&bytes[..filled], line, last);
        if first < last && bytes[first] != 35 {
            let entry = read_dependency(&bytes[..filled], first, last);
            if !entry.valid {
                return 0;
            }
            if entry.revision_start == entry.revision_end {
                let mut child: [u8; 4096] = [0; 4096];
                let length = resolve_path(
                    &root[0..root.len()],
                    &bytes[entry.source_start..entry.source_end],
                    &mut child[..]
                );
                if length == 0 {
                    return 11;
                }
                let nested = dependency_snapshot(
                    &child[..length],
                    &mut visited[0..visited.len()],
                    &mut digest[0..digest.len()]
                );
                if nested != 0 {
                    return nested;
                }
            }
        }
        line = last + 1;
    }
    0
}

/// Snapshot the checked unit, transitive local packages and installed STD.
/// The dependency graph is reread each pass, including after import/manifest edits.
pub fn check_snapshot(root: &[u8], file: &[u8], stdlib: &[u8], digest: &mut [u8]) i32 {
    if digest.len() != 32 {
        return 4;
    }
    let mut at: usize = 0;
    while at < 32 {
        digest[at] = 0;
        at += 1;
    }
    let mut visited: [u8; 262144] = [0; 262144];
    let mut result: i32 = 0;
    if root.len() != 0 {
        result = dependency_snapshot(
            root,
            &mut visited[..],
            &mut digest[0..digest.len()]
        );
    } else {
        let mut path: [u8; 4096] = [0; 4096];
        if file.len() == 0 || file.len() >= 4096 {
            return 4;
        }
        let length = append(&mut path[..], 0, file);
        result = watched_digest(&path[..length + 1], &mut digest[0..digest.len()]);
    }
    if stdlib.len() != 0 {
        let mut standard: [u8; 32] = [0; 32];
        let scanned = watch_snapshot(&stdlib[0..stdlib.len()], &mut standard[..]);
        let merged = merge_snapshot(
            &stdlib[0..stdlib.len()],
            &standard[..],
            &mut digest[0..digest.len()]
        );
        if result == 0 {
            result = scanned;
        }
        if result == 0 {
            result = merged;
        }
    }
    result
}
