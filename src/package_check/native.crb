//! Native executable-location boundary for installed package checking.
#(if: target.os == "macos" )
fn executable_path(output: &mut [u8]) usize {
    let capacity = output.len();
    if capacity < 4096 { return 0; }
    let mut length: usize = 0;
    @unchecked {
        let pointer = addr(&mut output[0]);
        @c(includes={"string.h", "stdlib.h", "mach-o/dyld.h"}) {
            char raw[4096];
            uint32_t size = sizeof raw;
            if (_NSGetExecutablePath(raw, &size) == 0 && realpath(raw, (char *)(uintptr_t)${pointer}) != NULL)
                ${length} = strlen((const char *)(uintptr_t)${pointer});
        }
    }
    length
}
#(endif)

#(if: target.os == "linux" )
fn executable_path(output: &mut [u8]) usize {
    let capacity = output.len();
    if capacity < 4096 { return 0; }
    let mut length: usize = 0;
    @unchecked {
        let pointer = addr(&mut output[0]);
        @c(includes={"string.h", "unistd.h"}) {
            ssize_t size = readlink("/proc/self/exe", (char *)(uintptr_t)${pointer}, ${capacity} - 1);
            if (size > 0) { ((char *)(uintptr_t)${pointer})[size] = 0; ${length} = (size_t)size; }
        }
    }
    length
}
#(endif)

#(if: target.os == "windows" )
fn executable_path(output: &mut [u8]) usize {
    let capacity = output.len();
    if capacity < 4096 { return 0; }
    let mut length: usize = 0;
    @unchecked {
        let pointer = addr(&mut output[0]);
        @c(includes={"string.h", "windows.h"}) {
            wchar_t path[4096];
            DWORD count = GetModuleFileNameW(NULL, path, 4096);
            if (count > 0 && count < 4096) {
                int size = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, path, (int)count,
                    (char *)(uintptr_t)${pointer}, (int)${capacity} - 1, NULL, NULL);
                if (size > 0) { ((char *)(uintptr_t)${pointer})[size] = 0; ${length} = (size_t)size; }
            }
        }
    }
    length
}
#(endif)

/// Clears only an interactive stderr terminal; redirected logs remain append-only.
#(if: target.family == "unix")
pub fn refresh_terminal() {
    @unchecked {
        @c(includes={"stdio.h", "stdlib.h", "string.h", "unistd.h"}) {
            const char *term = getenv("TERM");
            if (isatty(STDERR_FILENO) && term && strcmp(term, "dumb") != 0) {
                fputs("\033[2J\033[H", stderr);
                fflush(stderr);
            }
        }
    }
}
#(endif)

/// Uses console APIs so Windows does not require ANSI processing to be enabled.
#(if: target.os == "windows")
pub fn refresh_terminal() {
    @unchecked {
        @c(includes={"stdio.h", "windows.h"}) {
            HANDLE console = GetStdHandle(STD_ERROR_HANDLE);
            DWORD mode, written;
            CONSOLE_SCREEN_BUFFER_INFO info;
            if (GetConsoleMode(console, &mode) && GetConsoleScreenBufferInfo(console, &info)) {
                COORD origin = {0, info.srWindow.Top};
                DWORD cells = (DWORD)info.dwSize.X * (info.srWindow.Bottom - info.srWindow.Top + 1);
                fflush(stderr);
                FillConsoleOutputCharacterW(console, L' ', cells, origin, &written);
                FillConsoleOutputAttribute(console, info.wAttributes, cells, origin, &written);
                SetConsoleCursorPosition(console, origin);
            }
        }
    }
}
#(endif)
