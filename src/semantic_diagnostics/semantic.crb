//! Diagnostic-only views, operation frames and provenance. Never changes verdicts.
use bootstrap::model::{AstNode,StaticNode,CheckedValue};

/// Native formatting/history boundary. Views are read-only and are retained only
/// while check_tree's wrapper owns their storage; nested frames restore views.
fn control(op:i64,source:&[u8],nodes:&[AstNode],graph:&[StaticNode],values:&[CheckedValue],
    a:u64,b:i64,c:i64,out:&mut [u8],related:&mut [u64])->usize {
    let mut written:usize=0;
    @unchecked { @c(includes={"stdint.h","stdio.h","string.h","stddef.h"}) {
typedef struct {int64_t kind;uint64_t parent,start,end,name_start,name_end;bool public;} SDNode;
typedef struct {uint64_t first_child,next_sibling,scope,scope_parent;bool scope_entry,declaration,mutable;
    uint64_t type_node,initializer;int64_t fact;uint64_t visible,binding,destination,field_name,
    private_start,private_end,private_origin;int64_t access_mode;uint64_t protection;} SDGraph;
typedef struct {int64_t ty,state;bool mutable;uint64_t target,loan_parent,origin_call;bool writable;} SDValue;
_Static_assert(sizeof(SDNode)==sizeof(*(${nodes}).data),"diagnostic AST ABI drift");
_Static_assert(sizeof(SDGraph)==sizeof(*(${graph}).data),"diagnostic graph ABI drift");
_Static_assert(sizeof(SDValue)==sizeof(*(${values}).data),"diagnostic value ABI drift");
_Static_assert(_Alignof(SDNode)==_Alignof(__typeof__(*(${nodes}).data)),"diagnostic AST alignment drift");
_Static_assert(_Alignof(SDGraph)==_Alignof(__typeof__(*(${graph}).data)),"diagnostic graph alignment drift");
_Static_assert(_Alignof(SDValue)==_Alignof(__typeof__(*(${values}).data)),"diagnostic value alignment drift");
#define SD_LIMIT 524289u
#define SD_DEPTH 512u
static struct {
    bool enabled;const uint8_t *source;size_t length,count,vcount;
    const SDNode *nodes;const SDGraph *graph;const SDValue *values;
    struct {uint64_t node;int64_t expected,mode;const SDValue *previous;size_t count;} frames[SD_DEPTH];
    size_t depth,overflow;uint64_t statement,site,override_at,conflict,invalid_root,missing_field;
    int64_t expected,actual;
    struct {uint64_t move,drop,borrow,prior_move;int64_t state;uint64_t target;bool moved,dropped,borrowed,explicit_drop;} history[SD_LIMIT];
} sd;
int op=(int)${op};uint64_t a=${a};int64_t b=${b},c=${c};
uint8_t *output=(${out}).data;size_t capacity=(${out}).len,pos=0;
uint64_t *labels=(${related}).data;size_t label_capacity=(${related}).len,label_count=0;
#define SD_VALID(n) ((uint64_t)(n)<sd.count)
#define SD_VALUE(n) ((uint64_t)(n)<sd.vcount)
#define SD_APPEND(s) do{const char *part=(s);size_t size=strlen(part);if(pos<capacity){size_t room=capacity-pos;if(size>=room)size=room-1;memcpy(output+pos,part,size);pos+=size;output[pos]=0;}}while(0)
#define SD_NUMBER(n) do{char number[32];snprintf(number,sizeof number,"%llu",(unsigned long long)(n));SD_APPEND(number);}while(0)
#define SD_NAME(start,end) do{SD_APPEND("\037");SD_NUMBER(start);SD_APPEND(":");SD_NUMBER(end);SD_APPEND("\037");}while(0)
#define SD_LABEL(point,kind) do{if(label_count+2<=label_capacity){labels[label_count++]=(point);labels[label_count++]=(kind);}}while(0)
#define SD_PRIMITIVE(t) ((t)==1?"i32":(t)==2?"i64":(t)==3?"bool":(t)==4?"u8":(t)==5?"u16":(t)==6?"u32":(t)==7?"u64":(t)==8?"f32":(t)==9?"f64":(t)==10?"()":NULL)
// BEGIN FAILURE SITES
