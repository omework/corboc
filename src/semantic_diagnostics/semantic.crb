fn empty(op:i64,a:u64,b:i64,c:i64)->usize {
    let bytes:[u8;0]=[];let nodes:[AstNode;1]=[AstNode {kind:0,parent:0,start:0,end:0,name_start:0,name_end:0,public:false};1];let graph:[StaticNode;1]=[StaticNode {first_child:0,next_sibling:0,scope:0,scope_parent:0,scope_entry:false,declaration:false,mutable:false,type_node:0,initializer:0,fact:0,visible:0,binding:0,destination:0,field_name:0,private_start:0,private_end:0,private_origin:0,access_mode:0,protection:0};1];
    let values:[CheckedValue;1]=[CheckedValue {ty:0,state:0,mutable:false,target:0,loan_parent:0,origin_call:0,writable:false};1];let mut output:[u8;0]=[];let mut related:[u64;0]=[];
    control(op,&bytes[..],&nodes[0..0],&graph[0..0],&values[0..0],a,b,c,&mut output[..],&mut related[..])
}

/// Register live verifier views; only check_tree's owning wrapper calls this.
pub fn begin(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],values:&[CheckedValue],enabled:bool) {
    let mut output:[u8;0]=[];let mut related:[u64;0]=[];
    drop(control(0,source,nodes,graph,values,0,if enabled {1}else{0},0,&mut output[..],&mut related[..]));
}
/// Invalidate borrowed native views before their owning verifier scope returns.
pub fn end(){drop(empty(1,0,0,0));}
/// Frames isolate nested expression/block checks and alternate worker value views.
pub fn enter(values:&[CheckedValue],node:u64,expected:i64,mode:i64){
    let bytes:[u8;0]=[];let nodes:[AstNode;1]=[AstNode {kind:0,parent:0,start:0,end:0,name_start:0,name_end:0,public:false};1];let graph:[StaticNode;1]=[StaticNode {first_child:0,next_sibling:0,scope:0,scope_parent:0,scope_entry:false,declaration:false,mutable:false,type_node:0,initializer:0,fact:0,visible:0,binding:0,destination:0,field_name:0,private_start:0,private_end:0,private_origin:0,access_mode:0,protection:0};1];
    let mut output:[u8;0]=[];let mut related:[u64;0]=[];
    drop(control(2,&bytes[..],&nodes[0..0],&graph[0..0],values,node,expected,mode,&mut output[..],&mut related[..]));
}
pub fn leave(){drop(empty(3,0,0,0));}
pub fn statement(node:u64){drop(empty(4,node,0,0));}
pub fn site(id:u64){drop(empty(6,id,0,0));}
pub fn mismatch(offset:u64,expected:i64,actual:i64){drop(empty(7,offset,expected,actual));}
pub fn conflict(reference:u64){drop(empty(8,reference,0,0));}
/// Observe transitions after mutation; never writes through registered views.
pub fn transition(values:&[CheckedValue],id:u64,state:i64,target:u64){
    let bytes:[u8;0]=[];let nodes:[AstNode;1]=[AstNode {kind:0,parent:0,start:0,end:0,name_start:0,name_end:0,public:false};1];let graph:[StaticNode;1]=[StaticNode {first_child:0,next_sibling:0,scope:0,scope_parent:0,scope_entry:false,declaration:false,mutable:false,type_node:0,initializer:0,fact:0,visible:0,binding:0,destination:0,field_name:0,private_start:0,private_end:0,private_origin:0,access_mode:0,protection:0};1];
    let mut output:[u8;0]=[];let mut related:[u64;0]=[];
    drop(control(5,&bytes[..],&nodes[0..0],&graph[0..0],values,id,state,if target!=0 {1}else{0},&mut output[..],&mut related[..]));
}
