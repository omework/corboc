    control(9,&bytes[..],&nodes[0..0],&graph[0..0],&values[0..0],offset,rule,0,out,related)
}

/// Retain the leaf of a failed dependency walk for a secondary source label.
pub fn invalid_root(reference:u64){drop(empty(10,reference,0,0));}

/// Retain a missing member before constructor checking discards its declaration.
pub fn missing_field(field:u64){drop(empty(12,field,0,0));}
