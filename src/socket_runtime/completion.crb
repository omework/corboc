{ let bytes:[u8;21]=[61,99,111,114,98,111,95,115,111,99,107,101,116,95,97,116,116,97,99,104,40];byte_text(&bytes[..]); }
        local(graph[socket].binding);
{ let bytes:[u8;3]=[41,59,10];byte_text(&bytes[..]); }
