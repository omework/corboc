/// Binds only the selected platform's four native completion functions.
pub fn emit_completion_runtime(nodes:&[AstNode],graph:&[StaticNode]) {
    let mut create:u64=0;let mut attach:u64=0;let mut submit:u64=0;let mut next:u64=0;
    let mut item=graph[0].first_child;
    while item!=0 {
        if graph[item].fact==47{create=copy(item);}if graph[item].fact==48{attach=copy(item);}
        if graph[item].fact==49{submit=copy(item);}if graph[item].fact==50{next=copy(item);}
        item=graph[item].next_sibling;
    }
    if create==0 || attach==0 || submit==0 || next==0{return;}
