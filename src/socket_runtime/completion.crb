/// Returns attach=1 or asynchronous completion=2 only inside the linker-designated STD functions.
pub fn completion_call(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],node:u64)i64 {
    if nodes[node].kind!=15{return 0;}
    let callee=graph[node].first_child;if nodes[callee].kind!=36{return 0;}
    let mut owner=nodes[node].parent;
    while owner!=0 && nodes[owner].kind!=1 && nodes[owner].kind!=35{owner=nodes[owner].parent;}
    let socket=graph[callee].next_sibling;
    if nodes[socket].kind!=7 || nodes[graph[socket].binding].parent!=owner{return 0;}
    { let name:[u8;22]=[114,117,110,116,105,109,101,58,58,97,116,116,97,99,104,95,115,111,99,107,101,116];
    if graph[owner].fact==45 && nodes[owner].kind==1 && same_bytes(&source[nodes[callee].start..nodes[callee].end],&name[..]) {
        if graph[socket].next_sibling==0{return 1;}
    }}
    { let name:[u8;24]=[114,117,110,116,105,109,101,58,58,99,111,109,112,108,101,116,101,95,115,111,99,107,101,116];
    if graph[owner].fact==46 && nodes[owner].kind==35 && same_bytes(&source[nodes[callee].start..nodes[callee].end],&name[..]) {
        let request=graph[socket].next_sibling;if nodes[request].kind==7 && graph[request].next_sibling==0{return 2;}
    }}
    0
}

