    number(create);
{ let bytes:[u8;1]=[10];byte_text(&bytes[..]); }
{ let bytes:[u8;33]=[35,100,101,102,105,110,101,32,99,111,114,98,111,95,99,111,109,112,108,101,116,105,111,110,95,97,116,116,97,99,104,32,102];byte_text(&bytes[..]); }
    number(attach);
{ let bytes:[u8;1]=[10];byte_text(&bytes[..]); }
{ let bytes:[u8;33]=[35,100,101,102,105,110,101,32,99,111,114,98,111,95,99,111,109,112,108,101,116,105,111,110,95,115,117,98,109,105,116,32,102];byte_text(&bytes[..]); }
    number(submit);
{ let bytes:[u8;1]=[10];byte_text(&bytes[..]); }
{ let bytes:[u8;31]=[35,100,101,102,105,110,101,32,99,111,114,98,111,95,99,111,109,112,108,101,116,105,111,110,95,110,101,120,116,32,102];byte_text(&bytes[..]); }
    number(next);
{ let bytes:[u8;1]=[10];byte_text(&bytes[..]); }
    completion_runtime();
}
