use bootstrap::verify::type_violation;
use bootstrap::checked_state::record as record_checked;
use bootstrap::verify::{violation_site};
use bootstrap::value_dependencies::{scope_contains};
use bootstrap::model::{AstNode, StaticNode, CheckedValue};
use bootstrap::scalar::{folded_integer, verify_primitive};
use bootstrap::loans::{borrow_mutable, loan_conflict};
use bootstrap::nested_loans::{nested_loan, nested_loan_type};
use bootstrap::ownership::check_pool_new;
use bootstrap::loan_contracts::loan_callee;
use bootstrap::verify::{violation, verify_expr};

pub fn dependent_map(ty: i64) bool {
    ty >= 1000 && ty < 1300
}

pub fn dependent_option(ty: i64) bool {
    ty >= 1300 && ty < 1600
}

pub fn entry_reference(ty: i64) bool {
    ty >= 1600 && ty < 1900
}

pub fn map_item_code(ty: i64) i64 {
    return (ty / 100) % 10;
}

pub fn dependent_map_type(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    item: u64, key_type: i64) i64 {
    let inner = graph[item].first_child;
    if inner == 0 || graph[inner].first_child != 0 || graph[inner].next_sibling != 0 { return -9; }
    let element = verify_primitive(&source[0..source.len()], nodes[inner].name_start, nodes[inner].name_end);
    if element < 1 || element > 7 { return -9; }
    let start = nodes[item].start;
    if source[start] == 38 {
        let exclusive = borrow_mutable(&source[start..nodes[inner].start]);
        return (if exclusive { 1100 } else { 1000 }) + key_type * 10 + element;
    }
    if nodes[item].name_end - nodes[item].name_start != 1 || source[nodes[item].name_start] != 65 { return -9; }
    return 1200 + key_type * 10 + element;
}

fn constant_key(nodes: &[AstNode], graph: &[StaticNode], key: u64, inserts: bool) u64 {
    let mut expression = key;
    if !inserts { expression = graph[expression].first_child; }
    if nodes[expression].kind == 7 {
        let binding = graph[expression].binding;
        if graph[binding].mutable { return 0; }
        return graph[binding].initializer;
    }
    return expression;
}

pub fn dependent_map_access(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], call: u64, destination: u64, binding: u64,
    inserts: bool, removes: bool, shared: bool) i64 {
    let receiver = graph[call].first_child;
    let key = graph[receiver].next_sibling;
    let mode = map_item_code(values[binding].ty);
    let element = values[binding].ty % 10;
    let mut payload: u64 = 0;
    let mut root: u64 = 0;
    let key_node = constant_key(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(key), copy(inserts));
    let key_value = folded_integer(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(key_node));
    if !key_value.known { return -9; }
    if inserts {
        payload = graph[key].next_sibling;
        if mode == 2 {
            if nodes[payload].kind == 16 {
                let actual = check_pool_new(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut values[0..values.len()], copy(payload), copy(payload));
                if actual < 0 { return actual; }
                if actual != element + 200 { return 0 - violation_site(1, nodes[payload].start, 189); }
                root = values[payload].target;
            } else if nodes[payload].kind == 7 {
                let binding = graph[payload].binding;
                if values[binding].state != 1 { return 0 - violation_site(6, nodes[payload].start, 190); }
                if values[binding].ty != element + 200 { return 0 - violation_site(1, nodes[payload].start, 191); }
                root = values[binding].target;
                let moved = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
                    &mut values[0..values.len()], copy(payload), 0, 3);
                if moved < 0 { return moved; }
                values[payload] = CheckedValue{ ty: element + 200, state: 1,
                    mutable: false, target: copy(root), loan_parent: 0, origin_call: 0, writable: false, projection: 0, }; record_checked(&values[0..values.len()],payload);
            } else { return -9; }
        } else {
            let place = graph[payload].first_child;
            if nodes[payload].kind != 13 || nodes[place].kind != 7 { return -9; }
            root = graph[place].binding;
            if root == 0 || values[root].state != 1 { return 0 - violation_site(4, nodes[payload].start, 192); }
            let exclusive = borrow_mutable(&source[nodes[payload].start..nodes[place].start]);
            if values[root].ty != element || exclusive != (mode == 1) { return 0 - violation_site(1, nodes[payload].start, 193); }
            if exclusive && !values[root].mutable { return 0 - violation_site(5, nodes[payload].start, 194); }
            let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
                &graph[0..graph.len()], copy(root), copy(payload), copy(exclusive));
            if conflict > 0 { return 0 - violation_site(5, nodes[payload].start, 195); }
            if conflict < 0 { return -9; }
            values[payload] = CheckedValue{ ty: element + (if exclusive { 40 } else { 20 }), state: 1,
                mutable: false, target: copy(root), loan_parent: 0, origin_call: 0, writable: exclusive, projection: 0, }; record_checked(&values[0..values.len()],payload);
        }
        if !scope_contains(&graph[0..graph.len()], graph[root].scope, graph[binding].scope) {
            return 0 - violation_site(4, nodes[payload].start, 196);
        }
    }
    // Only same-scope updates are linear in the current availability
    // analysis. Branch-local entry changes require a merge of entry histories.
    if (inserts || removes) && graph[call].scope != graph[binding].scope { return -9; }
    let previous = values[binding].origin_call;
    let mut entry = copy(previous);
    let mut extracted: u64 = 0;
    while entry != 0 {
        let entry_key = folded_integer(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
            values[entry].loan_parent);
        if values[entry].state == 1 && key_value.negative == entry_key.negative
            && key_value.magnitude == entry_key.magnitude {
            extracted = values[entry].target;
            break;
        }
        entry = values[entry].origin_call;
    }
    if entry != 0 && (inserts || removes) {
        let old_key = values[entry].loan_parent;
        let old_payload = values[entry].target;
        let before = values[entry].origin_call;
        values[entry] = CheckedValue{ ty: 0, state: 2, mutable: false, target: old_payload,
            loan_parent: old_key, origin_call: before, writable: false, projection: 0, }; record_checked(&values[0..values.len()],entry);
    }
    if inserts {
        let ty = values[binding].ty;
        values[receiver] = CheckedValue{ ty: 0, state: 1, mutable: false, target: payload,
            loan_parent: key_node, origin_call: previous, writable: false, projection: 0, }; record_checked(&values[0..values.len()],receiver);
        values[binding] = CheckedValue{ ty: ty, state: 1, mutable: true, target: 0,
            loan_parent: 0, origin_call: receiver, writable: false, projection: 0, }; record_checked(&values[0..values.len()],binding);
    }
    let borrowed = !inserts && !removes;
    let result = 1300 + mode * 100 + element;
    values[destination] = CheckedValue{ ty: copy(result), state: 1, mutable: false,
        target: if borrowed { binding } else { 0 }, loan_parent: if borrowed { entry } else { 0 }, origin_call: extracted,
        writable: borrowed && !shared, projection: 0, }; record_checked(&values[0..values.len()],destination);
    return result;
}

pub fn entry_targets(values: &[CheckedValue], map: u64, target: u64) bool {
    let mut entry = values[map].origin_call;
    while entry != 0 {
        if values[entry].state == 1 {
            let mut payload = values[entry].target;
            while payload != 0 {
                if values[payload].target == target { return true; }
                payload = values[payload].origin_call;
            }
        }
        entry = values[entry].origin_call;
    }
    false
}

pub fn bind_entry_option(values: &mut [CheckedValue], option: u64, binder: u64) {
    let map = values[option].target;
    let ty = values[option].ty;
    let item = values[option].origin_call;
    let exclusive = values[option].writable;
    let storage = values[option].loan_parent;
    let target = values[item].target;
    let inner = values[item].ty;
    if map == 0 {
        let alternate = values[item].origin_call;
        let union = if alternate != 0 { 80 + inner % 20 } else { copy(inner) };
        values[binder] = CheckedValue{ ty: union, state: 1, mutable: false, target: target,
            loan_parent: 0, origin_call: if alternate != 0 { item } else { 0 }, writable: inner >= 40 && inner < 60, projection: 0, }; record_checked(&values[0..values.len()],binder);
    } else {
        values[binder] = CheckedValue{ ty: ty + 300, state: 1, mutable: false, target: target,
            loan_parent: map, origin_call: storage, writable: exclusive, projection: 0, }; record_checked(&values[0..values.len()],binder);
    }
}

// A mutation of the referent preserves the dependency. Replacing the
// descriptor itself needs a path-sensitive update of the map entry.
pub fn check_entry_write(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], statement: u64, place: u64) i64 {
    let operand = graph[place].first_child;
    if nodes[operand].kind != 14 { return 0; }
    let name = graph[operand].first_child;
    let binder = graph[name].binding;
    let reference = values[binder].ty;
    if nodes[name].kind != 7 || !entry_reference(copy(reference)) { return 0; }
    if !values[binder].writable || map_item_code(copy(reference)) == 6 {
        return 0 - violation_site(5, nodes[statement].start, 197);
    }
    if values[binder].state != 1 || values[values[binder].target].state != 1
        || values[values[binder].loan_parent].state != 1 {
        return 0 - violation_site(4, nodes[statement].start, 198);
    }
    let access = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()], &graph[0..graph.len()],
        copy(binder), copy(statement), true);
    if access > 0 { return 0 - violation_site(5, nodes[statement].start, 199); }
    if access < 0 { return -9; }
    let rhs = graph[place].next_sibling;
    let expected = reference % 10;
    let actual = verify_expr(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()],
        &mut values[0..values.len()], rhs, copy(expected), 1);
    if actual < 0 { return actual; }
    if actual != expected { return 0 - type_violation(nodes[statement].start,expected,actual,200); }
    return 1;
}

pub fn reborrow_entry(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], statement: u64, expression: u64, annotation: u64) i64 {
    let outer = graph[expression].first_child;
    let inner = graph[outer].first_child;
    let name = graph[inner].first_child;
    if nodes[outer].kind != 14 || nodes[inner].kind != 14 || nodes[name].kind != 7 { return 0; }
    let binding = graph[name].binding;
    let ty = values[binding].ty;
    if !entry_reference(copy(ty)) { return 0; }
    if annotation != 0 { return -9; }
    if values[binding].state != 1 || values[values[binding].target].state != 1
        || values[values[binding].loan_parent].state != 1 {
        return 0 - violation_site(4, nodes[expression].start, 201);
    }
    let exclusive = borrow_mutable(&source[nodes[expression].start..nodes[outer].start]);
    if exclusive && (!values[binding].writable || map_item_code(copy(ty)) == 6) {
        return 0 - violation_site(5, nodes[expression].start, 202);
    }
    let status = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
        &graph[0..graph.len()], copy(binding), copy(statement), copy(exclusive));
    if status > 0 { return 0 - violation_site(5, nodes[expression].start, 203); }
    if status < 0 { return -9; }
    let storage = values[binding].origin_call;
    if storage != 0 && values[values[storage].target].origin_call != 0 { return -9; }
    let target = values[binding].target;
    values[statement] = CheckedValue{ ty: ty % 10 + (if exclusive { 40 } else { 20 }), state: 1,
        mutable: graph[statement].mutable, target: target, loan_parent: binding, origin_call: 0,
        writable: exclusive, projection: 0, }; record_checked(&values[0..values.len()],statement);
    return 1;
}

// Rebinding a stored descriptor checks the target scope. A direct update
// of a known entry retains the previous root at the control-flow join.
pub fn validate_entry_replacement(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    values: &mut [CheckedValue], place: u64, rhs: u64) i64 {
    let name = graph[place].first_child;
    if nodes[name].kind != 7 { return 0; }
    let binder = graph[name].binding;
    if nested_loan(values[binder].ty) {
        let source_binding = graph[rhs].binding;
        let ty = values[binder].ty;
        if ty < 1930 || nodes[rhs].kind != 7 || nodes[source_binding].kind != 3
            || !values[source_binding].writable || values[source_binding].ty % 20 != ty % 10 {
            return -9;
        }
        if values[binder].state != 1 || values[source_binding].state != 1 {
            return 0 - violation_site(6, nodes[place].start, 204);
        }
        return 1;
    }
    if !entry_reference(values[binder].ty) || map_item_code(values[binder].ty) != 7 { return 0; }
    if !values[binder].writable { return 0 - violation_site(5, nodes[place].start, 205); }
    let target = graph[rhs].first_child;
    if nodes[rhs].kind != 13 || nodes[target].kind != 7 { return -9; }
    let root = graph[target].binding;
    if values[root].state != 1 { return 0 - violation_site(4, nodes[rhs].start, 206); }
    if !borrow_mutable(&source[nodes[rhs].start..nodes[target].start]) || !values[root].mutable {
        return 0 - violation_site(5, nodes[rhs].start, 207);
    }
    if values[root].ty != values[binder].ty % 10 { return 0 - violation_site(1, nodes[rhs].start, 208); }
    apply_entry_update(&nodes[0..nodes.len()], &graph[0..graph.len()], &mut values[0..values.len()],
        binder, root, copy(rhs), nodes[place].parent)
}

fn apply_entry_update(nodes: &[AstNode], graph: &[StaticNode], values: &mut [CheckedValue],
    binder: u64, root: u64, operation: u64, statement: u64) i64 {
    let valid = entry_update_context(&nodes[0..nodes.len()], &graph[0..graph.len()],
        &values[0..values.len()], copy(binder), copy(root), copy(operation), copy(statement));
    if valid < 0 { return valid; }
    if graph[graph[statement].scope].first_child != statement { return -9; }
    let conflict = loan_conflict(&nodes[0..nodes.len()], &values[0..values.len()],
        &graph[0..graph.len()], copy(root), copy(operation), true);
    if conflict > 0 { return 0 - violation_site(5, nodes[operation].start, 209); }
    if conflict < 0 { return -9; }
    update_entry(&mut values[0..values.len()], binder, root, operation);
    return 1;
}

// Effects can be applied only once the selected arm is proven to belong to
// an existing entry of this map. The incoming referent must survive the map.
pub fn entry_update_context(nodes: &[AstNode], graph: &[StaticNode], values: &[CheckedValue],
    binder: u64, root: u64, operation: u64, statement: u64) i64 {
    let map = values[binder].loan_parent;
    if !scope_contains(&graph[0..graph.len()], graph[root].scope, graph[map].scope) {
        return 0 - violation_site(4, nodes[operation].start, 210);
    }
    let storage = values[binder].origin_call;
    if storage == 0 { return -9; }
    let arm = nodes[graph[statement].scope].parent;
    let subject = graph[nodes[arm].parent].first_child;
    if nodes[arm].kind != 40 || nodes[subject].kind != 16 || values[subject].loan_parent != storage
        || graph[nodes[arm].parent].scope != graph[map].scope { return -9; }
    return 1;
}

pub fn entry_payload_has_root(values: &[CheckedValue], binder: u64, root: u64) bool {
    let mut payload = values[values[binder].origin_call].target;
    while payload != 0 {
        if values[payload].target == root { return true; }
        payload = values[payload].origin_call;
    }
    false
}

pub fn update_entry(values: &mut [CheckedValue], binder: u64, root: u64, operation: u64) {
    let map = values[binder].loan_parent;
    let storage = values[binder].origin_call;
    let binder_state = values[binder].state;
    let ty = values[binder].ty;
    let alternate = values[storage].target;
    let mut prior = copy(alternate);
    while prior != 0 {
        if prior == operation { return; }
        prior = values[prior].origin_call;
    }
    let key = values[storage].loan_parent;
    let previous = values[storage].origin_call;
    values[operation] = CheckedValue{ ty: 40 + ty % 10, state: 1, mutable: false, target: copy(root),
        loan_parent: 0, origin_call: alternate, writable: true, projection: 0, }; record_checked(&values[0..values.len()],operation);
    values[storage] = CheckedValue{ ty: 0, state: 1, mutable: false, target: operation,
        loan_parent: key, origin_call: previous, writable: false, projection: 0, }; record_checked(&values[0..values.len()],storage);
    values[binder] = CheckedValue{ ty: ty, state: binder_state, mutable: false, target: root,
        loan_parent: map, origin_call: storage, writable: true, projection: 0, }; record_checked(&values[0..values.len()],binder);
}

// A single descriptor assignment establishes a caller-visible entry effect.
// Its formal roots are substituted when the arguments have been checked.
pub fn direct_entry_effect(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], values: &mut [CheckedValue],
    function: u64, argument: u64) i64 {
    let scalar = entry_effect_scalar(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], copy(function), 64);
    if scalar == 0 { return 0; }
    let binder = graph[argument].binding;
    if nodes[argument].kind != 7 { return 0; }
    let incoming = graph[argument].next_sibling;
    if incoming == 0 || !entry_counter_argument(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], function, graph[incoming].next_sibling) { return -9; }
    if nested_loan(values[binder].ty) {
        let other = copy(incoming);
        if nodes[other].kind != 7 {
            return 0 - violation_site(8, nodes[argument].start, 211);
        }
        let actual = graph[other].binding;
        if nodes[actual].kind == 3 && values[actual].writable && values[actual].ty % 20 == scalar
            && values[binder].ty == 1930 + scalar { return 1; }
        return -9;
    }
    if !entry_reference(values[binder].ty) { return 0; }
    if values[binder].ty % 10 != scalar { return 0 - violation_site(1, nodes[argument].start, 212); }
    let referent = graph[incoming].first_child;
    if nodes[incoming].kind != 13 || nodes[referent].kind != 7 { return -9; }
    let root = graph[referent].binding;
    if !values[binder].writable || !values[root].mutable || map_item_code(values[binder].ty) != 7
        || !borrow_mutable(&source[nodes[incoming].start..nodes[referent].start]) {
        return 0 - violation_site(5, nodes[incoming].start, 213);
    }
    if values[binder].state != 1 || values[root].state != 1 { return 0 - violation_site(4, nodes[incoming].start, 214); }
    if values[root].ty != values[binder].ty % 10 { return 0 - violation_site(1, nodes[incoming].start, 215); }
    let call = nodes[argument].parent;
    let point = nodes[call].parent;
    return apply_entry_update(&nodes[0..nodes.len()], &graph[0..graph.len()],
        &mut values[0..values.len()], binder, root, incoming, point);
}

pub fn entry_effect_scalar(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], function: u64, fuel: u64) i64 {
    if fuel == 0 { return 0; }
    let target_param = graph[function].first_child;
    let source_param = graph[target_param].next_sibling;
    let third = graph[source_param].next_sibling;
    let recursive = nodes[third].kind == 3;
    let body = if recursive { graph[third].next_sibling } else { copy(third) };
    if nodes[target_param].kind != 3 || nodes[source_param].kind != 3 || nodes[body].kind != 2 { return 0; }
    let contract = nested_loan_type(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], graph[target_param].first_child);
    if contract < 1931 || contract > 1937 { return 0; }
    let source_type = graph[source_param].first_child;
    let scalar_type = graph[source_type].first_child;
    if scalar_type == 0 || source[nodes[source_type].start] != 38
        || !borrow_mutable(&source[nodes[source_type].start..nodes[scalar_type].start])
        || verify_primitive(&source[0..source.len()], nodes[scalar_type].name_start, nodes[scalar_type].name_end)
            != contract % 10 { return 0; }
    let mut statement = graph[body].first_child;
    while nodes[statement].kind == 25 && nodes[function].kind == 35 {
        statement = graph[statement].next_sibling;
    }
    if graph[statement].next_sibling != 0 { return 0; }
    if recursive {
        statement = recursive_entry_base(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], copy(function), statement, copy(target_param), copy(source_param), third);
        if statement == 0 { return 0; }
    }
    if nodes[statement].kind == 8 {
        let call = graph[statement].first_child;
        if nodes[call].kind != 15 { return 0; }
        let callee = loan_callee(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(call));
        if callee == 0 || callee == function { return 0; }
        let left = graph[graph[call].first_child].next_sibling;
        let right = graph[left].next_sibling;
        if nodes[left].kind != 7 || nodes[right].kind != 7
            || graph[left].binding != target_param || graph[right].binding != source_param
            || !entry_counter_argument(&source[0..source.len()], &nodes[0..nodes.len()],
                &graph[0..graph.len()], copy(callee), graph[right].next_sibling) { return 0; }
        let forwarded = entry_effect_scalar(&source[0..source.len()], &nodes[0..nodes.len()],
            &graph[0..graph.len()], callee, fuel - 1);
        if forwarded == contract % 10 { return forwarded; }
        return 0;
    }
    if nodes[statement].kind != 21 { return 0; }
    let place = graph[statement].first_child;
    let assigned = graph[place].first_child;
    let source_expression = graph[place].next_sibling;
    if nodes[place].kind != 14 || nodes[assigned].kind != 7 || nodes[source_expression].kind != 7
        || graph[assigned].binding != target_param || graph[source_expression].binding != source_param
        || source[nodes[statement].name_start] != 61 { return 0; }
    return contract % 10;
}

// Resolve the base of a recursive effect only when the recursive path
// forwards the same loans and decreases a positive counter.
fn recursive_entry_base(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    function: u64, statement: u64, target: u64, incoming: u64, count: u64) u64 {
    let annotation = graph[count].first_child;
    if graph[annotation].first_child != 0 || verify_primitive(&source[0..source.len()],
        nodes[annotation].name_start, nodes[annotation].name_end) != 2 { return 0; }
    let choice = graph[statement].first_child;
    let test = graph[choice].first_child;
    let left = graph[test].first_child;
    let zero = graph[left].next_sibling;
    if (nodes[statement].kind != 8 && nodes[statement].kind != 10) || nodes[choice].kind != 26
        || nodes[test].kind != 11 || nodes[test].name_end - nodes[test].name_start != 1
        || source[nodes[test].name_start] != 62 || nodes[left].kind != 7 || graph[left].binding != count
        || nodes[zero].kind != 9 || nodes[zero].end - nodes[zero].start != 1
        || source[nodes[zero].start] != 48 { return 0; }
    let yes = graph[test].next_sibling;
    let no = graph[yes].next_sibling;
    if nodes[yes].kind != 2 || nodes[no].kind != 2 { return 0; }
    let body = graph[yes].first_child;
    let operation = graph[body].first_child;
    let asynchronous = nodes[function].kind == 35;
    if nodes[body].kind != 8 || graph[body].next_sibling != 0 || (asynchronous && nodes[operation].kind != 38) { return 0; }
    let call = if asynchronous { graph[operation].first_child } else { operation };
    let name = graph[call].first_child;
    let spelling = &source[nodes[name].name_start..nodes[name].name_end];
    let declared = &source[nodes[function].name_start..nodes[function].name_end];
    if nodes[call].kind != 15 || nodes[name].kind != 7 || graph[name].binding != 0
        || !spelling.content_eq(&declared[0..declared.len()]) { return 0; }
    let first = graph[name].next_sibling;
    let second = graph[first].next_sibling;
    let third = graph[second].next_sibling;
    let counter = graph[third].first_child;
    let one = graph[counter].next_sibling;
    if nodes[first].kind != 7 || graph[first].binding != target || nodes[second].kind != 7
        || graph[second].binding != incoming || graph[third].next_sibling != 0 { return 0; }
    let clamped = nodes[third].kind == 9 && nodes[third].end - nodes[third].start == 1
        && source[nodes[third].start] == 48;
    let decreases = nodes[third].kind == 11 && nodes[third].name_end - nodes[third].name_start == 1
        && source[nodes[third].name_start] == 45 && nodes[counter].kind == 7 && graph[counter].binding == count
        && nodes[one].kind == 9 && nodes[one].end - nodes[one].start == 1
        && source[nodes[one].start] == 49;
    if !clamped && !decreases { return 0; }
    let mut base = graph[no].first_child;
    while asynchronous && nodes[base].kind == 25 { base = graph[base].next_sibling; }
    if nodes[base].kind != 21 || graph[base].next_sibling != 0 { return 0; }
    base
}

pub fn entry_counter_argument(source: &[u8], nodes: &[AstNode], graph: &[StaticNode],
    function: u64, argument: u64) bool {
    let first = graph[function].first_child;
    let second = graph[first].next_sibling;
    let third = graph[second].next_sibling;
    if nodes[third].kind != 3 { return argument == 0; }
    if nodes[argument].kind != 9 || graph[argument].next_sibling != 0 { return false; }
    let value = folded_integer(&source[0..source.len()], &nodes[0..nodes.len()],
        &graph[0..graph.len()], argument);
    value.known && !value.negative && value.magnitude <= 9223372036854775807
}
