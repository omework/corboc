}
fn alias_borrow(out: &mut [u8], cursor: u64, mutable: bool, reference: bool) -> u64 {
    let a: [u8; 10] = [32,61,32,38,40,42,115,101,108,102];
    let b: [u8; 14] = [32,61,32,38,109,117,116,32,40,42,115,101,108,102];
    let c: [u8; 11] = [32,61,32,38,42,40,42,115,101,108,102];
    let d: [u8; 15] = [32,61,32,38,109,117,116,32,42,40,42,115,101,108,102];
    let end: [u8; 2] = [41,46];
    let cursor = if reference {
        if mutable { put(&mut out[0..out.len()], cursor, &d[..]) } else { put(&mut out[0..out.len()], cursor, &c[..]) }
    } else { if mutable { put(&mut out[0..out.len()], cursor, &b[..]) } else { put(&mut out[0..out.len()], cursor, &a[..]) } };
    put(&mut out[0..out.len()], cursor, &end[..])
}

// A stable concrete identity is independent of the changing AST node indices.
fn next_identity(source: &[u8], nodes: &[AstNode]) -> u64 {
    let mut identity: u64 = 1;
    let mut node: u64 = 1;
    while node < nodes.len() as u64 {
        if nodes[node].kind == 28 && is_generated(&source[0..source.len()], &nodes[0..nodes.len()], copy(node)) {
            let mut byte = nodes[node].name_start + 17;
            let mut number: u64 = 0;
            while byte < nodes[node].name_end && source[byte] >= 48 && source[byte] <= 57 {
                number = number * 10 + (source[byte] - 48) as u64;
                byte = byte + 1;
            }
            if number >= identity { identity = number + 1; }
        }
        node = node + 1;
    }
    identity
}

// Keep generated declarations inside the defining file's visibility span.
fn reverse(out: &mut [u8], start: u64, end: u64) {
    let mut left = copy(start); let mut right = copy(end);
    while left < right {
        right = right - 1;
        let byte = out[left]; out[left] = out[right]; out[right] = copy(byte);
        left = left + 1;
    }
}
fn insert_helpers(nodes: &[AstNode], out: &mut [u8], offsets: &mut [u64],
    source_length: u64, length: u64, origin: u64) {
    let mut item = copy(origin);
    while nodes[item].parent != 0 { item = nodes[item].parent; }
    let insertion = nodes[item].end;
    let start = offsets[insertion]; let end = offsets[source_length];
    if start == end { return; }
    reverse(&mut out[0..out.len()], copy(start), copy(end));
    reverse(&mut out[0..out.len()], copy(end), copy(length));
    reverse(&mut out[0..out.len()], copy(start), copy(length));
    let mut byte = copy(insertion);
    while byte <= source_length { offsets[byte] = offsets[byte] + (length - end); byte = byte + 1; }
}

// Constructor and invocation thunks are ordinary functions. There is no erased
// capture pointer: the verifier sees the concrete fields and all their roots.
fn constructor(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    captured: &[u64], closure: u64, identity: u64, out: &mut [u8], cursor: u64) -> u64 {
    let mut pos = call_text_2(&mut out[0..out.len()],copy(cursor));
    let mut point = closure + 1;
    while point < nodes.len() as u64 && nodes[point].start < nodes[closure].end {
        let binding = graph[point].binding;
        if binding != 0 && captured[binding] == point {
            pos = field_name(&mut out[0..out.len()],copy(pos), copy(binding));
            pos = call_text_3(&mut out[0..out.len()],copy(pos));
            pos = infer(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()], copy(point), 0, &mut out[0..out.len()],copy(pos), 0);
            pos = call_text_4(&mut out[0..out.len()],copy(pos));
        }
        point = point + 1;
    }
    pos = call_text_5(&mut out[0..out.len()],copy(pos));
    pos = generated(&mut out[0..out.len()],copy(pos), copy(identity));
    pos = call_text_6(&mut out[0..out.len()],copy(pos));
    pos = generated(&mut out[0..out.len()],copy(pos),copy(identity));
    pos = call_text_6(&mut out[0..out.len()],copy(pos));
    point = closure + 1;
    while point < nodes.len() as u64 && nodes[point].start < nodes[closure].end {
        let binding = graph[point].binding;
        if binding != 0 && captured[binding] == point {
            pos = field_name(&mut out[0..out.len()],copy(pos), copy(binding));
            pos = call_text_3(&mut out[0..out.len()],copy(pos));
            pos = field_name(&mut out[0..out.len()],copy(pos), binding);
            pos = call_text_4(&mut out[0..out.len()],copy(pos));
        }
        point = point + 1;
    }
    call_text_7(&mut out[0..out.len()],copy(pos))
}

fn runner(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    closure: u64, identity: u64, mode: i64, out: &mut [u8], cursor: u64) -> u64 {
    let mut pos = if mode == 0 { call_text_8(&mut out[0..out.len()],copy(cursor)) }
        else if mode == 1 { call_text_9(&mut out[0..out.len()],copy(cursor)) }
        else { call_text_10(&mut out[0..out.len()],copy(cursor)) };
    pos = generated(&mut out[0..out.len()],copy(pos),copy(identity));
    let mut parameter = graph[closure].first_child;
    while nodes[parameter].kind == 3 {
        pos = call_text_4(&mut out[0..out.len()],copy(pos));
        pos = put(&mut out[0..out.len()],copy(pos), &source[nodes[parameter].start..nodes[parameter].end]);
        parameter = graph[parameter].next_sibling;
    }
    let body = closure_body(&nodes[0..nodes.len()], &graph[0..graph.len()], copy(closure));
    let output = if nodes[parameter].kind == 4 { copy(parameter) } else { body };
    pos = call_text_5(&mut out[0..out.len()],copy(pos));
    pos = infer(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], &tokens[0..tokens.len()],copy(output), 0, &mut out[0..out.len()],copy(pos), 0);
    pos = call_text_11(&mut out[0..out.len()],copy(pos));
    parameter = graph[closure].first_child;
    while nodes[parameter].kind == 3 {
        pos = put(&mut out[0..out.len()],copy(pos), &source[nodes[parameter].name_start..nodes[parameter].name_end]);
        parameter = graph[parameter].next_sibling;
        if nodes[parameter].kind == 3 { pos = call_text_4(&mut out[0..out.len()],copy(pos)); }
    }
    call_text_12(&mut out[0..out.len()],copy(pos))
}

fn invoke(source: &[u8], nodes: &[AstNode], graph: &[StaticNode], tokens: &[Token],
    call: u64, layout: u64, out: &mut [u8], offsets: &mut [u64]) -> u64 {
    let callee = graph[call].first_child;
    let mut base = copy(callee);
    while nodes[base].kind == 19 { base = graph[base].first_child; }
    let mut cursor = put(&mut out[0..out.len()], 0, &source[0..nodes[callee].start]);
    let mut replaced = nodes[callee].end;
    if nodes[base].kind == 7 {
        cursor = put(&mut out[0..out.len()],copy(cursor), &source[nodes[base].start..nodes[base].end]);
        cursor = call_text_13(&mut out[0..out.len()],copy(cursor));
    } else {
        let method_name: [u8; 14] = [95,95,99,111,114,98,111,95,105,110,118,111,107,101];
        let target = method(&source[0..source.len()], &nodes[0..nodes.len()], &graph[0..graph.len()], copy(layout), &method_name[..]);
        let mutable = graph[graph[target].first_child].mutable;
        let mode: i64 = if nodes[base].kind == 13 { if graph[base].mutable { 2 } else { 1 } }
            else if nodes[base].kind == 14 || nodes[base].kind == 17 { if mutable { 2 } else { 1 } }
            else { 0 };
        if mode == 1 && mutable { let error = report_violation(5, nodes[callee].start); drop(error); return 0; }
        cursor = put(&mut out[0..out.len()],copy(cursor), &source[nodes[layout].name_start..nodes[layout].name_end]);
        cursor = if mode == 0 { call_text_14(&mut out[0..out.len()],copy(cursor)) }
            else if mode == 1 { call_text_15(&mut out[0..out.len()],copy(cursor)) }
            else { call_text_16(&mut out[0..out.len()],copy(cursor)) };
        if nodes[base].kind == 14 || nodes[base].kind == 17 {
            cursor = if mode == 1 { call_text_17(&mut out[0..out.len()],copy(cursor)) } else { call_text_18(&mut out[0..out.len()],copy(cursor)) };
        }
        cursor = put(&mut out[0..out.len()],copy(cursor), &source[nodes[base].start..nodes[base].end]);
        let argument = graph[callee].next_sibling;
        if argument != 0 {
            cursor = call_text_4(&mut out[0..out.len()],copy(cursor));
            let open = token_at(&tokens[0..tokens.len()], nodes[callee].end);
            cursor = put(&mut out[0..out.len()],copy(cursor), &source[tokens[open].end..nodes[call].end]);
        } else { cursor = call_text_1(&mut out[0..out.len()],copy(cursor)); }
        replaced = nodes[call].end;
    }
    let replacement_end = copy(cursor);
    cursor = put(&mut out[0..out.len()],copy(cursor), &source[replaced..source.len()]);
    let mut byte: u64 = 0;
    while byte <= source.len() as u64 {
        offsets[byte] = if byte <= nodes[callee].start { copy(byte) }
            else if byte >= replaced { replacement_end + (byte - replaced) } else { nodes[callee].start };
        byte = byte + 1;
    }
    cursor
}

