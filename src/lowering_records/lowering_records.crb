pub fn array_definition(source:&[u8],nodes: &[AstNode], graph: &[StaticNode], types: &[i64], seen: &mut [bool], ty: i64) {
    let mut index: u64 = 1;
    while index < nodes.len() as u64 && types[index] != ty { index = index + 1; }
    if index == nodes.len() as u64 || seen[index] { return; }
    seen[index] = true;
    let item = array_item(copy(ty));
    if is_tuple(copy(item)){tuple_definition(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&types[0..types.len()],&mut seen[0..seen.len()],copy(item));}
    else if item >= 3000000 && item < 4000000 {
        record_definition(&source[0..source.len()],&nodes[0..nodes.len()], &graph[0..graph.len()], &types[0..types.len()],
            &mut seen[0..seen.len()], nominal_type(copy(item)));
    }
    { let code: [u8;15] = [116,121,112,101,100,101,102,32,115,116,114,117,99,116,123]; byte_text(&code[..]); } c_type(item); { let code: [u8;7] = [32,105,116,101,109,115,91]; byte_text(&code[..]); }
    let count = array_length(copy(ty));
    number(if count == 0 { 1 } else { count });
    { let code: [u8;4] = [93,59,125,32]; byte_text(&code[..]); } array_name(ty); { let code: [u8;2] = [59,10]; byte_text(&code[..]); }
}

/// Emit a structural tuple only after every owned field layout is available.
pub fn tuple_definition(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],types:&[i64],seen:&mut [bool],ty:i64){
    if !is_tuple(copy(ty)) || tuple_emitted(copy(ty)){return;}
    let count=tuple_count(copy(ty));let mut i:u64=0;
    while i<count{let field=tuple_part(copy(ty),copy(i),copy(count));
        if field>=3000000 && field<4000000{record_definition(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&types[0..types.len()],&mut seen[0..seen.len()],nominal_type(field));}
        i+=1;
    }
    let begin="typedef struct{";let bytes=begin.as_bytes();byte_text(bytes);
    i=0;while i<count{c_type(tuple_part(copy(ty),copy(i),copy(count)));character(32);character(109);number(copy(i));character(59);i+=1;}
    character(125);character(32);c_type(ty);character(59);character(10);
}
