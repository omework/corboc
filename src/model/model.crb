pub struct Token {
    nominal: bool,
    annotation: i64,
    kind: i64,
    start: u64,
    end: u64,
}


pub struct AstNode {
    kind: i64,
    parent: u64,
    start: u64,
    end: u64,
    name_start: u64,
    name_end: u64,
    public: bool,
}


pub struct StaticNode {
    first_child: u64,
    next_sibling: u64,
    scope: u64,
    scope_parent: u64,
    scope_entry: bool,
    declaration: bool,
    mutable: bool,
    type_node: u64,
    initializer: u64,
    fact: i64,
    visible: u64,
    binding: u64,
    destination: u64,
    field_name: u64,
    private_start: u64,
    private_end: u64,
}

// Linked metadata for private layouts and trusted standard-library runtime hooks.
pub struct LayoutVisibility {
    kind: i64,
    name: u64,
    start: u64,
    end: u64,
}


pub fn hex_digit(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return (byte - 48) as u32; }
    if byte >= 65 && byte <= 70 { return (byte - 55) as u32; }
    if byte >= 97 && byte <= 102 { return (byte - 87) as u32; }
    16
}


pub fn token_at(tokens: &[Token], start: u64) -> u64 {
    let mut low: u64 = 0;
    let mut high = tokens.len() as u64 - 3;
    while low < high {
        let middle = low + (high - low) / 2;
        if tokens[middle].start < start { low = middle + 1; } else { high = middle; }
    }
    low
}



pub struct CheckedValue {
    ty: i64,
    state: i64,
    mutable: bool,
    target: u64,
    loan_parent: u64,
    origin_call: u64,
    exclusive: bool,
}

// A constructor call links its field template to its own argument range.
pub fn constructor_arguments(ty: i64) -> bool { ty == 5011 || ty == 5012 }

pub fn constructor_field_value(graph: &[StaticNode], values: &[CheckedValue],
    first: u64, field: u64) -> u64 {
    if !constructor_arguments(values[first].ty) { return field; }
    if values[first].ty==5012 {
        let mut entry=values[first].origin_call;
        while entry!=0 {
            if values[entry].origin_call==field || (graph[field].field_name!=0 && graph[values[entry].origin_call].field_name==graph[field].field_name){return values[entry].target;}
            entry=values[entry].loan_parent;
        }
        return 0;
    }

    let binding = graph[graph[field].first_child].binding;
    let mut parameter = values[first].target;
    let mut argument = values[first].origin_call;
    while argument != 0 {
        if parameter == binding { return argument; }
        parameter = graph[parameter].next_sibling;
        argument = graph[argument].next_sibling;
    }
    field
}

// Result descriptors keep the two payload identities separate.
pub fn result_code(ok: i64, err: i64) -> i64 {
    if ok <= 0 || err <= 0 || ok >= 8000000 || err >= 8000000 { return -1; }
    9000000000000000000 + ok * 8000000 + err
}

pub fn result_type(ty: i64) -> bool {
    ty > 9000000000000000000 && ty < 9000064000000000000
}

pub fn result_payload(ty: i64, ok: bool) -> i64 {
    let pair = ty - 9000000000000000000;
    if ok { return pair / 8000000; }
    pair % 8000000
}

pub fn result_has_nominal_payload(ty: i64) -> bool {
    result_type(copy(ty)) && (result_payload(copy(ty), true) >= 3000000 || result_payload(ty, false) >= 3000000)
}

// The argument list contains evaluation inputs; only fields stored in the result retain their loans.
pub fn constructor_argument_retained(graph:&[StaticNode],values:&[CheckedValue],marker:u64,argument:u64)->bool {
    if values[marker].ty==5012{return true;}
    let shape=values[marker].loan_parent;if shape==0{return true;}
    let mut formal=values[marker].target;let mut actual=values[marker].origin_call;
    while actual!=0 && actual!=argument{actual=graph[actual].next_sibling;formal=graph[formal].next_sibling;}
    if actual==0{return false;}
    let mut field=graph[shape].first_child;
    while field!=0 {if graph[graph[field].first_child].binding==formal{return true;}field=graph[field].next_sibling;}
    false
}
