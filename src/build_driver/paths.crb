#(if: target.os == "macos" && target.arch == "aarch64")
use bootstrap::packages::append;

pub fn stdlib_path(output: &mut [u8]) -> usize {
    if !executable_path(&mut output[0..output.len()]) { return 0; }
    let mut last: usize = 0;
    let mut index: usize = 0;
    while index < output.len() && output[index] != 0 {
        if output[index] == 47 { last = index + 1; }
        index = index + 1;
    }
    let suffix_bytes: [u8; 25] = [46, 46, 47, 115, 104, 97, 114, 101, 47, 99, 111, 114, 98, 111, 47, 115, 116, 100, 108, 105, 98, 47, 115, 114, 99]; // ../share/corbo/stdlib/src
    let suffix = &suffix_bytes[..];
    if last == 0 || last + suffix.len() >= output.len() { return 0; }
    let end = append(&mut output[0..output.len()], last, &suffix[0..suffix.len()]);
    output[end] = 0;
    if !accessible(&output[0..end + 1]) { return 0; }
    end
}

pub fn workspace_path(output_file: &[u8], path: &mut [u8]) -> usize {
    let mut parent_end: usize = 0;
    let mut index: usize = 0;
    while index < output_file.len() {
        if output_file[index] == 47 { parent_end = index + 1; }
        index = index + 1;
    }
    if parent_end == output_file.len() { return 0; }
    let prefix: [u8; 2] = [46, 47]; // ./
    let suffix_bytes: [u8; 14] = [46, 99, 111, 114, 98, 111, 99, 46, 88, 88, 88, 88, 88, 88]; // .corboc.XXXXXX
    let suffix = &suffix_bytes[..];
    let mut start: usize = 0;
    if output_file[0] != 47 { start = append(&mut path[0..path.len()], 0, &prefix[..]); }
    if start + parent_end + suffix.len() + 12 >= path.len() { return 0; }
    let parent = append(&mut path[0..path.len()], start, &output_file[0..parent_end]);
    let end = append(&mut path[0..path.len()], parent, &suffix[0..suffix.len()]);
    path[end] = 0;
    if !make_workspace(&mut path[0..end + 1]) { return 0; }
    end
}

pub fn toolchain(input: &[u8], output: &[u8]) -> i32 {
    let command: [u8; 3] = [99, 99, 0]; // cc
    let standard: [u8; 9] = [45, 115, 116, 100, 61, 99, 49, 49, 0]; // -std=c11
    let threads: [u8; 9] = [45, 112, 116, 104, 114, 101, 97, 100, 0]; // -pthread
    let math: [u8; 4] = [45, 108, 109, 0]; // -lm
    let flag: [u8; 3] = [45, 111, 0]; // -o
    run_command(&command[..], &standard[..], &threads[..], input, &math[..], &flag[..], output)
}
#(endif)
