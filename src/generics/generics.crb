/// Classify a for source using ordinary expression inference. Reference mode
/// remains separate from the indexed layout; unknown sources use next().
pub fn iteration_mode(source:&[u8],nodes:&[AstNode],graph:&[StaticNode],tokens:&[Token],expression:u64)->i64 {
    let ty=decoded(type_code(&source[0..source.len()],&nodes[0..nodes.len()],&graph[0..graph.len()],&tokens[0..tokens.len()],expression,0));
    let node=ty.node;
    let mut indexed=ty.slice;
    if node!=0 {
        indexed=indexed || source[nodes[node].start]==91;
        let name=&source[nodes[node].name_start..nodes[node].name_end];
        let vector="Vector";
        let vector_bytes=vector.as_bytes();
        if name.content_eq(vector_bytes) {indexed=true;}
    }
    // Array literals do not need a declared type to identify their shape.
    let mut root=expression;
    while nodes[root].kind==13 || nodes[root].kind==19 {root=graph[root].first_child;}
    indexed=indexed || nodes[root].kind==44 || nodes[root].kind==45;
    if !indexed {return 0;}
    let inner=graph[node].first_child;
    let slice=ty.slice || (node!=0 && nodes[node].kind==4 && source[nodes[node].start]==91 && graph[inner].next_sibling==0);
    if ty.reference==2 {return if slice {5}else{3};}
    if ty.reference==1 {return if slice {4}else{2};}
    // Borrowed unannotated array literals are still explicit references.
    if nodes[expression].kind==13 {return if graph[expression].mutable {3}else{2};}
    1
}
