fn conversion_c_type(out: &mut [u8], start: usize, ty: i64) -> usize {
    let mut at = start;
    if ty == 1 { at = numeric_text_0(&mut out[0..out.len()], at);
 }
    else if ty == 2 { at = numeric_text_1(&mut out[0..out.len()], at);
 }
    else if ty == 4 { at = numeric_text_2(&mut out[0..out.len()], at);
 }
    else if ty == 5 { at = numeric_text_3(&mut out[0..out.len()], at);
 }
    else if ty == 6 { at = numeric_text_4(&mut out[0..out.len()], at);
 }
    else if ty == 7 { at = numeric_text_5(&mut out[0..out.len()], at);
 }
    else if ty == 8 { at = numeric_text_6(&mut out[0..out.len()], at);
 }
    else if ty == 9 { at = numeric_text_7(&mut out[0..out.len()], at);
 }
    at
}
fn conversion_bits(ty: i64) -> u64 {
    if ty == 1 { 31 } else if ty == 2 { 63 } else if ty == 4 { 8 }
    else if ty == 5 { 16 } else if ty == 6 { 32 } else { 64 }
}
fn conversion_code(out: &mut [u8], start: usize, from: i64, into: i64) -> usize {
    let mut at = start;
    if from < 8 && into < 8 {
        at = numeric_text_8(&mut out[0..out.len()], at);
        if into == 1 || into == 2 {
            at = numeric_text_9(&mut out[0..out.len()], at);
            at = number(&mut out[0..out.len()], at, conversion_bits(copy(into)));
            at = numeric_text_10(&mut out[0..out.len()], at);
        } else {
            at = numeric_text_11(&mut out[0..out.len()], at);
        }
        at = numeric_text_12(&mut out[0..out.len()], at);
        at = number(&mut out[0..out.len()], at, conversion_bits(copy(into)));
        at = numeric_text_13(&mut out[0..out.len()], at);
        at = conversion_c_type(&mut out[0..out.len()], at, into);
        at = numeric_text_14(&mut out[0..out.len()], at);
    } else if into < 8 {
        at = numeric_text_15(&mut out[0..out.len()], at);
        if into == 1 || into == 2 {
            at = numeric_text_16(&mut out[0..out.len()], at);
            at = number(&mut out[0..out.len()], at, conversion_bits(copy(into)));
            at = numeric_text_17(&mut out[0..out.len()], at);
        } else {
            at = numeric_text_18(&mut out[0..out.len()], at);
        }
        at = numeric_text_19(&mut out[0..out.len()], at);
        at = number(&mut out[0..out.len()], at, conversion_bits(copy(into)));
        at = numeric_text_20(&mut out[0..out.len()], at);
        at = conversion_c_type(&mut out[0..out.len()], at, into);
        at = numeric_text_21(&mut out[0..out.len()], at);
    } else {
        let bounded = from == 9 && into == 8;
        if bounded { at = conversion_float_bound(&mut out[0..out.len()], at); }
        at = conversion_c_type(&mut out[0..out.len()], at, copy(into));
        at = numeric_text_22(&mut out[0..out.len()], at);
        at = conversion_c_type(&mut out[0..out.len()], at, into);
        at = numeric_text_23(&mut out[0..out.len()], at);
        if from < 8 {
            at = numeric_text_24(&mut out[0..out.len()], at);
            if from == 1 || from == 2 {
                at = numeric_text_25(&mut out[0..out.len()], at);
                at = number(&mut out[0..out.len()], at, conversion_bits(copy(from)));
                at = numeric_text_26(&mut out[0..out.len()], at);
            } else {
                at = numeric_text_27(&mut out[0..out.len()], at);
            }
            at = numeric_text_28(&mut out[0..out.len()], at);
            at = number(&mut out[0..out.len()], at, conversion_bits(copy(from)));
            at = numeric_text_29(&mut out[0..out.len()], at);
            at = conversion_c_type(&mut out[0..out.len()], at, from);
            at = numeric_text_30(&mut out[0..out.len()], at);
        } else {
            at = numeric_text_31(&mut out[0..out.len()], at);
            at = conversion_c_type(&mut out[0..out.len()], at, from);
            at = numeric_text_32(&mut out[0..out.len()], at);
        }
        at = numeric_text_33(&mut out[0..out.len()], at);
        if bounded {
            let close: [u8; 1] = [125];
            at = put(&mut out[0..out.len()], at, &close[..]);
        }
    }
    at
}
