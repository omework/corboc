use std::text::Utf8Error;
use std::io::{File, FileError, FileMode, FilePerm};

/// Borrows compiler-internal path bytes as text, excluding an optional NUL.
pub fn path_text(path: &[u8]) -> Result<&str, Utf8Error> {
    let length = path.len();
    let mut end: usize = length;
    if length != 0 && path[length - 1] == 0 { end = length - 1; }
    let bytes = &path[0..end];
    str::from_utf8(bytes)
}

/// Opens an internal byte path through the public UTF-8 File boundary.
pub fn open_file(path: &[u8], mode: i64) -> Result<File, FileError> {
    let text = match path_text(&path[0..path.len()]) {
        Ok(text) => { text },
        Err(_error) => { return Err(FileError.InvalidPath); },
    };
    File::open(text, mode)
}

/// Creates a file from an internal path without exposing a byte-path STD API.
pub fn create_file(path: &[u8], mode: i64, perm: FilePerm) -> Result<File, FileError> {
    let text = match path_text(&path[0..path.len()]) {
        Ok(text) => { text },
        Err(_error) => { return Err(FileError.InvalidPath); },
    };
    File::create(text, mode, perm)
}

// Compiler-internal paths may still include their terminating zero.
pub fn read_source(path: &[u8], buffer: &mut [u8]) -> (i32, usize) {
    match open_file(&path[0..path.len()], FileMode::read_only()) {
        Err(error) => { drop(error); return (1, 0); },
        Ok(opened) => {
            let mut file = opened;
            let mut filled: usize = 0;
            let mut chunk: [u8; 1024] = [0; 1024];
            loop {
                match file.read(&mut chunk[..]) {
                    Err(error) => { drop(error); return (2, 0); },
                    Ok(count) => {
                        if count == 0 { return (0, filled); }
                        if count > buffer.len() - filled { return (4, 0); }
                        let mut offset: usize = 0;
                        while offset < count {
                            buffer[filled + offset] = chunk[offset];
                            offset = offset + 1;
                        }
                        filled = filled + count;
                    },
                };
            }
        },
    };
}
