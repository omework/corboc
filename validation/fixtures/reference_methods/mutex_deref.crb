use std::sync::Mutex;
use std::sync::asyn::Mutex as AsyncMutex;
struct Point { x: i64 }
async fn work() -> i64 {
    let mutex = AsyncMutex::new(Point { x: 1 });
    {
        let mut guard = mutex.lock().await;
        (*guard).x = 42;
        yield;
        print((*guard).x);
    }
    let guard = mutex.lock().await;
    (*guard).x
}
fn main() {
    let mutex = Mutex::new(Point { x: 1 });
    {
        let mut guard = mutex.lock();
        (*guard).x = 42;
        print((*guard).x);
    }
    let task = runtime::spawn(work());
    match task.join() { Ok(value) => { print(value); }, Err(_) => { print(-1); } }
}
