struct Point { x: i64 }
impl Point {
    fn increment(&mut self) { (*self).x += 1; }
}
struct Wrapper { value: Point }
impl Wrapper {
    fn ref(&self) -> &Point { &(*self).value }
    fn mut_ref(&mut self) -> &mut Point { &mut (*self).value }
}
fn escape() -> &Point { let wrapper = Wrapper { value: Point { x: 1 } }; &*wrapper }
fn main() { let view = escape(); print((*view).x); }
