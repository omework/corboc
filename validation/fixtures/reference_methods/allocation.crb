struct Point { x: i64 }
fn read(value: &Point) -> i64 { (*value).x }
fn change(value: &mut Point) { (*value).x = 42; }
fn scalar_read(value: &i64) -> i64 { *value }
fn scalar_write(value: &mut i64) { *value = 7; }
fn main() {
    let mut points = Pool<Point>::new(2);
    let mut point = points.new(Point { x: 1 });
    change(point.mut_ref());
    print(read(point.ref()));
    let mut numbers = Pool<i64>::new(2);
    let mut number = numbers.new(1);
    scalar_write(number.mut_ref());
    let mut view = number.mut_ref();
    *view = 7;
    let shared = number.ref();
    print(*shared);
}
