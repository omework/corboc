struct Source{left:i64,right:i64}
struct View{value:&mut i64}
impl Source{fn split(&mut self)->(View,View){let a=&mut (*self).left;let b=&mut (*self).right;(View{value:a},View{value:b})}}
impl View{fn get(&self)->i64{*(*self).value}fn set(&mut self,value:i64){let target=&mut *(*self).value;*target=value;}}
fn main(){let mut source=Source{left:1,right:2};let (mut left,mut right)=source.split();left.set(10);right.set(20);print(left.get());print(right.get());drop(left);drop(right);print(source.left);print(source.right);}
