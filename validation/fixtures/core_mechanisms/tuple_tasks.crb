struct View{value:&mut i64}
fn pair(left:&mut i64,right:&mut i64)->(View,View){(View{value:left},View{value:right})}
async fn read(view:View)->Result<i64,bool>{yield;Ok(*view.value)}
fn main(){
 let mut a:i64=7;let mut b:i64=8;
 let (x,y)=pair(&mut a,&mut b);
 let first=runtime::spawn(read(x));let second=runtime::spawn(read(y));
 match first.join(){Ok(result)=>{match result{Ok(value)=>{print(value);},Err(error)=>{drop(error);}}},Err(error)=>{drop(error);}}
 a=9;
 match second.join(){Ok(result)=>{match result{Ok(value)=>{print(value);},Err(error)=>{drop(error);}}},Err(error)=>{drop(error);}}
 b=10;print(a);print(b);
}
