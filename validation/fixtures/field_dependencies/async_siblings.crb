use std::sync::asyn::Mutex;
struct Tracker { cursor: i64 }
struct FileLike { value: i64 }
impl FileLike {
    fn read(&self) -> i64 { (*self).value }
    fn increment(&mut self) { (*self).value += 1; }
}
struct Holder { tracker: Mutex<Tracker>, file: FileLike }
impl Holder {
    async fn work(&mut self) -> i64 {
        let mut guard = self.tracker.lock().await;
        self.file.increment();
        print(self.file.read());
        yield;
        (*guard).cursor += 1;
        (*guard).cursor
    }
}
fn main() {
    let mut holder = Holder { tracker: Mutex::new(Tracker { cursor: 41 }), file: FileLike { value: 41 } };
    let task = runtime::spawn(holder.work());
    match task.join() { Ok(value) => { print(value); }, Err(_) => { print(-1); } }
}
