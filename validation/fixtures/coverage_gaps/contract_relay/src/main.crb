#(type: T with { fn number(&self) -> i64; })
fn inner(source: &T) -> i64 { source.number() }
#(type: T with { fn number(&self) -> i64; })
fn read(source: &T) -> i64 { inner(&*source) }
struct Answer { value: i64 }
impl Answer { fn number(&self) -> i64 { (*self).value } }
fn main() { let answer = Answer { value: 42 }; print(read(&answer)); }
