struct Cell { value: i64 }
struct View { value: &mut i64 }
impl Cell {
    #(lock: on=self, through_result=true)
    fn reserve(&mut self) -> View { View { value: &mut (*self).value } }
}
fn main() { let mut cell = Cell { value: 1 }; let mut first = cell.reserve(); let mut second = cell.reserve(); print(*first.value); print(*second.value); }
