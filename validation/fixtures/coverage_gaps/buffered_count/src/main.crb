use std::io::sync::buffered::BufWriter;
struct Sink { count: usize }
impl Sink {
    fn write(&mut self, bytes: &[u8]) -> Result<usize, bool> {
        let count = &mut (*self).count;
        *count += bytes.len();
        Ok(bytes.len())
    }
}
fn main() {
    let mut sink = Sink { count: 0 };
    let mut scratch: [u8; 4] = [0; 4];
    {
        let mut writer = BufWriter::new(&mut sink, &mut scratch[..]);
        let bytes: [u8; 2] = [1, 2];
        drop(writer.write(&bytes[..]));
        drop(writer.flush());
    }
    print(sink.count);
}
