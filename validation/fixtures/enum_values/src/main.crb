enum Event {
    Idle,
    Count(i64),
    Pair(i32, bool),
    Location { x: i32, y: i32 },
}

struct Wrapper { event: Event }

fn relay(event: Event) -> Event { event }

fn make(counter: &mut i64) -> Option<i64> {
    *counter += 1;
    Some(*counter)
}

fn main() {
    let first = Event.Count(12);
    let second: Event = first;
    print(first == second);
    print(first != second);
    if let Event.Count(value) = first {
        print(value);
    } else {
        print(0);
    }
    let idle = Event.Idle;
    if let Event.Count(value) = idle {
        print(value);
    } else if let Event.Idle = idle {
        print(7);
    }
    let selected = if let Event.Count(value) = first { value } else { 0 };
    print(selected);
    let location = Event.Location { x: 3, y: 4 };
    if let Event.Location { x: x, y: y } = location { print(x + y); }
    let returned = relay(first);
    print(first == returned);
    let wrapper = Wrapper { event: first };
    let field = wrapper.event;
    print(field == first);
    print(first == returned);
    let (tupled, number) = (first, 2);
    print(first == tupled);
    print(number);
    let captured = Event.Count(6);
    let closure = || -> Event { captured };
    let received = closure();
    print(captured == received);
    let mut count: i64 = 0;
    if let Some(value) = make(&mut count) { print(value); }
    print(count);
    let mixed = if true { 1 } else if let Event.Count(value) = first { value } else { 0 };
    print(mixed);
    let mut pair = Event.Pair(5, true);
    let saved = pair;
    pair = Event.Pair(6, true);
    print(saved != pair);
    let option: Option<i64> = Some(9);
    let copied = option;
    print(option == copied);
    if let Some(value) = option { print(value); }
    let none: Option<i64> = None;
    if let Some(value) = none { print(value); } else { print(8); }
    let result: Result<i64, i32> = Ok(42);
    let saved_result = result;
    print(result == saved_result);
    if let Ok(value) = result { print(value); }
}
