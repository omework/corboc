//! Sequential writes through aliased mutable arguments are valid content operations.
/// Distinct inline storage places for argument reservation.
struct Buffers {
    left: [u8; 4],
    right: [u8; 4]
}
/// Writes both supplied mutable places.
fn fill(left: &mut [u8], right: &mut [u8]) {
    left[0] = 1;
    right[0] = 2;
}
/// Exercises this fixture and reports its expected observations.
fn main() {
    let mut buffers = Buffers {
        left: [0; 4],
        right: [0; 4]
    };
    fill(&mut buffers.left[..], &mut buffers.left[..]);
    let actual: u8 = buffers.left[0];
    print(actual == 2);
}
