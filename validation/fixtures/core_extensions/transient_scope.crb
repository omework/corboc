struct Config{level:u32}
struct Buffers{a:&mut [u8],b:&mut [u8],c:&mut [u64],level:u32}
impl Buffers{fn new(config:&Config,a:&mut [u8],b:&mut [u8],c:&mut [u64])->Buffers{Buffers{a:a,b:b,c:c,level:(*config).level}}}
fn main(){let mut a:[u8;2]=[0;2];let mut b:[u8;3]=[0;3];let mut c:[u64;4]=[0;4];let buffers={let config=Config{level:3};Buffers::new(&config,&mut a[..],&mut b[..],&mut c[..])};print(buffers.level);drop(buffers);a[0]=7;print(a[0]);}
