struct Guard{id:i64}
impl Guard{fn drop(&mut self){print((*self).id);}}
fn fail()->Result<i64,bool>{Err(true)}
fn consume(first:Guard,second:Guard,value:i64)->Result<i64,bool>{drop(second);drop(first);Ok(value)}
fn outer()->Result<i64,bool>{let first=Guard{id:1};let second=Guard{id:2};consume(first,second,fail()?)}
fn main(){match outer(){Ok(value)=>{drop(value);},Err(error)=>{print(error);}}}
